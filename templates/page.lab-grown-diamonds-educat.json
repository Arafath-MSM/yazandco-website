      "name": "Image with Text CTA",
      "settings": {
        "subheading": "",
        "heading": "What Are Lab-Grown Diamonds?",
        "heading_size": "h1",
        "text": "<p>Lab-grown diamonds are genuine diamonds created in a laboratory using advanced processes that replicate the natural conditions under which diamonds form deep within the Earth.</p><p>Unlike diamond simulants, lab-grown diamonds are not alternatives or imitations. They have the same crystal structure, hardness and brilliance as natural diamonds.</p><p>The difference lies only in their origin.</p>",
        "color_scheme": "",
        "full_width": true,
        "button_label_1": "",
        "button_link_1": "#",
        "button_style_1": "secondary",
        "button_label_2": "",
        "button_link_2": "#",
        "button_style_2": "primary",
        "image": "shopify://shop_images/F84E72BF-3A76-49DD-B7CF-48780E7B0E7E.jpg",
        "image_ratio": "landscape",
        "layout_desktop": "image-left",
        "layout_mobile": "image-first",
        "margin_top": "no-indent",
        "margin_bottom": "no-indent"
