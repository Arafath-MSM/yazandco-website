    "faq_landing_gNCrBq": {
      "type": "faq-landing",
      "blocks": {
        "faq_TPMYfK": {
          "type": "faq",
          "settings": {
            "question": "How do I find my correct ring size?",
            "answer": "<p>You can find your ring size by measuring the internal diameter of a ring that already fits comfortably or by measuring the circumference of your finger in millimetres. For the most accurate fit, measure your finger at the end of the day when your hands are at a normal temperature.</p>"
          }
        },
        "faq_RQDCyU": {
          "type": "faq",
          "settings": {
            "question": "What should I do if I am between two ring sizes?",
            "answer": "<p>If your measurement falls between two sizes, we recommend choosing the larger size for a more comfortable fit.</p>"
          }
        },
        "faq_VBKbdP": {
          "type": "faq",
          "settings": {
            "question": "Which hand should I measure my ring size on?",
            "answer": "<p>Always measure the finger on which you intend to wear the ring, as finger sizes can vary between your left and right hand.</p>"
          }
        },
        "faq_UbX7ap": {
          "type": "faq",
          "settings": {
            "question": "Does my ring size change over time?",
            "answer": "<p>Yes. Factors such as temperature, weight changes, and natural changes in your fingers can affect your ring size. We recommend checking your size before ordering if you have not worn rings recently.</p>"
          }
        },
        "faq_A84bQ4": {
          "type": "faq",
          "settings": {
            "question": "Can I resize my YAZ & Co ring?",
            "answer": "<p>Some rings may be resized depending on the design, materials, and gemstone setting. Please contact our team before ordering or after purchase for guidance.</p>"
          }
        },
        "faq_4Trw9k": {
          "type": "faq",
          "settings": {
            "question": "Do all ring designs fit the same?",
            "answer": "<p>Some wider bands, statement rings, or designs with unique settings may feel different compared to slimmer rings. Our team can assist you in selecting the most suitable size for your chosen design.</p>"
          }
        }
      },
