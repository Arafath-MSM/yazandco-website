          "settings": {
            "category_key": "shipping",
            "question": "How long does it take for my refund to be issued?",
            "answer": "<p>Approved refunds are processed through<br/>the original payment method within approximately 15–20 business days after the<br/>returned item has been received and inspected.</p><p>Processing timelines may vary<br/>depending on the payment provider or banking institution.</p>"
          }
        },
