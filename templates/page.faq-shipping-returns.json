          "type": "faq",
          "settings": {
            "category_key": "shipping",
            "question": "Can I return a personalised or custom-made item?",
            "answer": "<p>Custom-made, personalised, engraved,<br/>or made-to-order items are non-refundable, non-exchangeable, and<br/>non-cancellable once the final design and specifications have been approved by<br/>the customer.</p><p>For further assistance, please contact<br/>the YAZ & Co team.</p>"
          }
        },
        "faq_XEEHQU": {
          "type": "faq",
          "settings": {
            "category_key": "shipping",
            "question": "Can I ship my order outside of the UAE?",
            "answer": "<p>Yes. YAZ & Co offers international<br/>shipping to selected countries in accordance with applicable regulations.</p><p>Please note that customs duties,<br/>taxes, clearance fees, and import requirements are the responsibility of the<br/>customer. YAZ & Co is not responsible for customs delays or shipment<br/>restrictions imposed by foreign authorities.</p>"
          }
        },
