          "settings": {
            "category_key": "shipping",
            "question": "What are the delivery times and shipping rates?",
            "answer": "<p><strong>Within the UAE</strong></p><ul><li>Estimated delivery: 3–5 business days<br/>     after dispatch </li><li>Shipping fee: AED 30 </li></ul><p><strong>International<br/>Shipping</strong></p><ul><li>Estimated delivery: 7–10 business days<br/>     after dispatch </li><li>Shipping fee: AED 150 </li></ul><p>Orders are prepared within 25–30<br/>business days from payment confirmation. Delivery timelines are estimates and<br/>may vary depending on courier operations, customs procedures, or circumstances<br/>beyond the Company’s control.</p>"
          }
        },
