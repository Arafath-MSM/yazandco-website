          "type": "faq",
          "settings": {
            "category_key": "shipping",
            "question": "How can I make returns or exchanges without a receipt?",
            "answer": "<p>YAZ & Co does not accept returns<br/>or exchanges without valid proof of purchase, including the original invoice or<br/>receipt.</p><p>All approved returns must be<br/>accompanied by the original packaging, certificates, and documentation where<br/>applicable.</p>"
          }
        },
        "faq_tzqVDC": {
          "type": "faq",
          "settings": {
            "category_key": "shipping",
            "question": "How can I return or exchange merchandise purchased online?",
            "answer": "<p>Returns may only be accepted in cases<br/>of proven manufacturing defects or if the delivered item does not match the<br/>agreed specifications.</p><p>Any issue must be reported within 48<br/>hours of receiving the order. Items must remain unused, unworn, and in original<br/>condition with all accompanying documentation.</p><p>Once the request is reviewed and<br/>approved, our team will provide further return instructions. Refunds, where<br/>applicable, are issued through the original payment method within the<br/>applicable processing period.</p><p>Please note that shipping fees are<br/>non-refundable.</p>"
          }
        },
        "faq_ktTggT": {
          "type": "faq",
          "settings": {
            "category_key": "shipping",
            "question": "How do I know if my return has been received?",
            "answer": "<p>Once the returned item has been<br/>received and inspected by the YAZ & Co team, a confirmation update will be<br/>provided to the customer regarding approval status and refund eligibility, if<br/>applicable.</p>"
          }
        },
        "faq_8EGBDz": {
          "type": "faq",
          "settings": {
            "category_key": "shipping",
            "question": "How do I track my online order?",
            "answer": "<p>Once your order has been dispatched,<br/>tracking details will be shared through the contact information provided during<br/>purchase.</p><p>Customers may also contact YAZ &<br/>Co for shipment updates and delivery assistance.</p>"
          }
        },
