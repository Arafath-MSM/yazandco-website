        },
        "faq_item_pcTeDq": {
          "type": "faq_item",
          "settings": {
            "question": "Is the packaging of my YAZ & Co online purchase discreet?",
            "answer": "<p>Orders are securely packed for safe delivery. Outer packaging may vary depending on courier and shipping requirements.</p>"
