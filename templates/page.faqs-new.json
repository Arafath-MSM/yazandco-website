        },
        "faq_item_VRPfEL": {
          "type": "faq_item",
          "settings": {
            "question": "Are YAZ & Co products insured when shipped?",
            "answer": "<p>YAZ & Co remains responsible for orders until the package is confirmed as delivered to the customer. If an issue occurs during shipment, our team may coordinate with the courier provider to review the case. Once delivery has been confirmed by the courier, responsibility transfers to the customer in accordance with our Terms & Conditions.</p><p>For assistance, please contact the YAZ & Co team through our official communication channels.</p>"
          }
        },
        "faq_item_BaJMyM": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return a personalised or custom-made item?",
            "answer": "<p>Custom-made, personalised, engraved, or made-to-order items are non-refundable, non-exchangeable, and non-cancellable once the final design and specifications have been approved by the customer.</p><p>For further assistance, please contact the YAZ & Co team.</p>"
          }
        },
        "faq_item_fMrgng": {
          "type": "faq_item",
          "settings": {
            "question": "Can I ship my order outside of the UAE?",
            "answer": "<p>Yes. YAZ & Co offers international shipping to selected countries in accordance with applicable regulations.</p><p>Please note that customs duties, taxes, clearance fees, and import requirements are the responsibility of the customer. YAZ & Co is not responsible for customs delays or shipment restrictions imposed by foreign authorities.</p>"
          }
        },
        "faq_item_DFWEcX": {
          "type": "faq_item",
          "settings": {
            "question": "How can I make returns or exchanges without a receipt?",
            "answer": "<p>YAZ & Co does not accept returns or exchanges without valid proof of purchase, including the original invoice or receipt.</p><p>All approved returns must be accompanied by the original packaging, certificates, and documentation where applicable.</p>"
          }
        },
        "faq_item_WcJmYU": {
          "type": "faq_item",
          "settings": {
            "question": "How can I return or exchange merchandise purchased online?",
            "answer": "<p>Returns may only be accepted in cases of proven manufacturing defects or if the delivered item does not match the agreed specifications.</p><p>Any issue must be reported within 48 hours of receiving the order. Items must remain unused, unworn, and in original condition with all accompanying documentation.</p><p>Once the request is reviewed and approved, our team will provide further return instructions. Refunds, where applicable, are issued through the original payment method within the applicable processing period.</p><p>Please note that shipping fees are non-refundable.</p>"
          }
        },
        "faq_item_cJXnCY": {
          "type": "faq_item",
          "settings": {
            "question": "How do I know if my return has been received?",
            "answer": "<p>Once the returned item has been received and inspected by the YAZ & Co team, a confirmation update will be provided to the customer regarding approval status and refund eligibility, if applicable.</p>"
          }
        },
        "faq_item_UpQrYc": {
          "type": "faq_item",
          "settings": {
            "question": "How do I track my online order?",
            "answer": "<p>Once your order has been dispatched, tracking details will be shared through the contact information provided during purchase.</p><p>Customers may also contact YAZ & Co for shipment updates and delivery assistance.</p>"
          }
        },
        "faq_item_dTN3eF": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take for my refund to be issued?",
            "answer": "<p>Approved refunds are processed through the original payment method within approximately 15–20 business days after the returned item has been received and inspected.</p><p>Processing timelines may vary depending on the payment provider or banking institution.</p>"
          }
        },
        "faq_item_CnLkaB": {
          "type": "faq_item",
          "settings": {
            "question": "What are the delivery times and shipping rates?",
            "answer": "<p><strong>Within the UAE</strong></p><ul><li>Estimated delivery: 3–5 business days after dispatch</li><li>Shipping fee: <strong> AED 30</strong></li></ul><p><strong>International Shipping</strong></p><ul><li>Estimated delivery: 7–10 business days after dispatch</li><li>Shipping fee: <strong>AED 200</strong></li></ul><p>Orders are prepared within 15–20 business days from payment confirmation. Delivery timelines are estimates and may vary depending on courier operations, customs procedures, or circumstances beyond the Company’s control.</p>"
          }
        },
        "faq_item_tpMDtp": {
          "type": "faq_item",
          "settings": {
            "question": "How can I return or exchange an online exclusive item?",
            "answer": "<p>Online purchases follow the same YAZ & Co return policy and are subject to approval based on the conditions outlined in our Terms & Conditions.</p><p>Returns may only be considered for:</p><ul><li>Proven manufacturing defects</li><li>Incorrect items delivered</li><li>Items not matching agreed specifications</li></ul><p>Products must be returned unused, in original condition, and accompanied by the original invoice, packaging, and certificates where applicable.</p><p>Custom-made, engraved, or personalized items are not eligible for return or exchange.</p>"
          }
        },
        "faq_item_DXajri": {
          "type": "faq_item",
          "settings": {
            "question": "How do I request a tax refund as a tourist?",
            "answer": "<p>Tax refund eligibility is subject to UAE regulations and approved tax refund procedures. Customers may contact the relevant authorized tax refund provider for further guidance and requirements.</p>"
          }
        },
