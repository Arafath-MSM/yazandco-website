        "faq_item_APiqPM": {
          "type": "faq_item",
          "settings": {
            "question": "Does YAZ & Co offer complimentary jewellery cleaning?",
            "answer": "<p>&nbsp;Yes. YAZ & Co offers complimentary professional cleaning and inspection for YAZ & Co jewellery. Additional repairs, polishing or restorative work may incur a charge depending on the service required.</p>"
          }
        },
        "faq_item_47ETMA": {
          "type": "faq_item",
          "settings": {
            "question": "Does YAZ & Co offer complimentary ring resizing?",
            "answer": "<p>Yes. YAZ & Co offers complimentary resizing for eligible rings, subject to the design, setting and resizing requirements. Certain designs, including eternity styles or significant size adjustments, may not be eligible. Additional resizing services may incur a charge.</p>"
          }
        },
        "faq_item_WB69PQ": {
          "type": "faq_item",
          "settings": {
            "question": "What warranty does YAZ & Co offer?",
            "answer": "<p>YAZ & Co offers a 5-year warranty covering eligible manufacturing defects. The warranty does not cover normal wear and tear, accidental damage, loss or damage resulting from improper care or unauthorised repairs or alterations.</p>"
          }
        },
        "faq_item_agVC9M": {
          "type": "faq_item",
          "settings": {
            "question": "Will I receive an igi certificate with my diamond?",
            "answer": "<p>Yes. YAZ & Co diamonds above 1 carat are IGI certified and include their corresponding certification. Every YAZ & Co piece also carries its own serial number.</p>"
          }
        },
        "faq_item_QHjDcr": {
          "type": "faq_item",
          "settings": {
            "question": "What jewellery care services does YAZ & Co offer?",
            "answer": "<p>YAZ & Co offers professional jewellery cleaning, inspection, polishing, repair and resizing services. Complimentary cleaning and inspection are available for YAZ & Co jewellery, while additional services may be subject to assessment and applicable charges.</p>"
          }
        },
        "faq_item_9f9tpy": {
          "type": "faq_item",
          "settings": {
            "question": "Who is responsible for my order during shipping?",
            "answer": "<p>YAZ & Co remains responsible for your order until delivery is confirmed by the courier. Once delivery has been confirmed, responsibility transfers to the customer in accordance with our Terms & Conditions.</p>"
          }
        }
      },
