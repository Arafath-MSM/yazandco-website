        "guide_step_TH8Cjw": {
          "type": "guide_step",
          "settings": {
            "anchor_id": "clarity",
            "nav_label": "Diamond Colour",
            "desktop_pos": "left",
            "mobile_swap": "image_first",
            "col_width": 50,
            "gap_d": 50,
            "gap_m": 20,
            "pad_top": 10,
            "pad_bottom": 10,
            "image": "shopify://shop_images/ChatGPT_Image_Aug_19_2026_08_00_54_PM.png",
            "img_radius": 0,
            "img_border_w": 0,
            "img_border_color": "#eeeeee",
            "text_align_d": "flex-start",
