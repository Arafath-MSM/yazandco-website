        "guide_step_rFeQ8k": {
          "type": "guide_step",
          "settings": {
            "anchor_id": "clarity",
            "nav_label": "Diamond Clarity",
            "desktop_pos": "right",
            "mobile_swap": "image_first",
            "col_width": 50,
