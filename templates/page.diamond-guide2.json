            "image": "shopify://shop_images/ChatGPT_Image_Sep_21_2026_05_17_13_PM.png",
            "img_radius": 0,
            "img_border_w": 0,
            "img_border_color": "#eeeeee",
            "text_align_d": "flex-start",
