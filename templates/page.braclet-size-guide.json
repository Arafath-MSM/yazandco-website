    "faq_landing_gNCrBq": {
      "type": "faq-landing",
      "blocks": {
        "faq_TPMYfK": {
          "type": "faq",
          "settings": {
            "question": "How do I find my correct bracelet size?",
            "answer": "<p>Measure your wrist at the point where you would normally wear your bracelet. Once you have your wrist measurement, add approximately 1–2 cm depending on your preferred fit. </p>"
          }
        },
        "faq_RQDCyU": {
          "type": "faq",
          "settings": {
            "question": "Should my bracelet fit tightly or loosely?",
            "answer": "<p>For a closer, more fitted look, add around 1 cm to your wrist measurement. For a more relaxed and comfortable fit, add around 2 cm. </p>"
          }
        },
        "faq_VBKbdP": {
          "type": "faq",
          "settings": {
            "question": "What bracelet size should I choose?",
            "answer": "<p>YAZ & Co offers bracelet sizes based on wrist measurements. Our general sizing guide includes:</p><ul><li>S/M: Up to 18.5 cm (7.2\")<br/></li><li>M/L: Up to 21.5 cm (8.4\") </li></ul>"
          }
        },
        "faq_UbX7ap": {
          "type": "faq",
          "settings": {
            "question": "How do I measure my wrist correctly?",
            "answer": "<p>Wrap a measuring tape or a strip of paper around your wrist where the bracelet will sit. Make sure it is comfortable and not too tight, then measure the length in centimetres.</p>"
          }
        },
        "faq_A84bQ4": {
          "type": "faq",
          "settings": {
            "question": "Does bracelet style affect the fit?",
            "answer": "<p>Yes. The final fit can vary depending on the bracelet design, width, setting, and construction. Wider or structured bracelets may feel different compared to delicate chain styles. </p>"
          }
        },
        "faq_4Trw9k": {
          "type": "faq",
          "settings": {
            "question": "What if my wrist measurement is between two sizes?",
            "answer": "<p>If you are between sizes, we recommend choosing the larger size for a more comfortable fit and ease of movement.</p>"
          }
        }
      },
