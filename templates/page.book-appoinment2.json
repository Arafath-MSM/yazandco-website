    "faq_landing_gNCrBq": {
      "type": "faq-landing",
      "blocks": {
        "faq_TPMYfK": {
          "type": "faq",
          "settings": {
            "question": "How should I care for my YAZ & Co jewellery?",
            "answer": "<p>Keep your jewellery away from perfumes, cosmetics, lotions, harsh chemicals, and prolonged contact with water. Remove your jewellery before swimming, showering, sleeping, or exercising. Gently clean each piece with a soft, clean cloth and store it separately in a soft pouch or jewellery box.</p>"
          }
        },
        "faq_RQDCyU": {
          "type": "faq",
          "settings": {
            "question": "Does YAZ & Co jewellery come with a warranty?",
            "answer": "<p>Yes. YAZ & Co jewellery is covered against verified manufacturing defects in materials and workmanship for the applicable warranty period stated at the time of purchase. All warranty claims are subject to inspection and approval by YAZ & Co.</p>"
          }
        },
        "faq_VBKbdP": {
          "type": "faq",
          "settings": {
            "question": "What is not covered under the warranty?",
            "answer": "<p>The warranty does not cover normal wear and tear, scratches, accidental damage, improper handling, loss or theft, exposure to water or chemicals, or damage caused by not following our Jewellery Care recommendations. Jewellery repaired, resized, altered, or modified by an unauthorised third party may also not be covered.</p>"
          }
        },
        "faq_UbX7ap": {
          "type": "faq",
          "settings": {
            "question": "How do I make a warranty claim?",
            "answer": "<p>Please contact YAZ & Co with your order details or proof of purchase, clear photographs of the jewellery, and a brief description of the issue. Our team will assess your request and advise you on the next steps.</p>"
          }
        },
        "faq_A84bQ4": {
          "type": "faq",
          "settings": {
            "question": "Do you offer custom-made jewellery?",
            "answer": "<p>Yes. YAZ & Co offers selected custom-made and made-to-order jewellery services. The design and specifications will be reviewed with you and must be approved before production proceeds.</p>"
          }
        },
        "faq_4Trw9k": {
          "type": "faq",
          "settings": {
            "question": "Can I cancel or return a custom-made piece?",
            "answer": "<p>Custom-made and made-to-order pieces are non-refundable, non-exchangeable, and non-cancellable once the final design and specifications have been approved, subject to any rights you may have under applicable consumer law.</p>"
          }
        },
        "faq_nBnDDp": {
          "type": "faq",
          "settings": {
            "question": "When is payment required for custom jewellery?",
            "answer": "<p>Full payment must be received and confirmed before the completed custom or made-to-order item is released or shipped.</p>"
          }
        },
        "faq_CJV7j8": {
          "type": "faq",
          "settings": {
            "question": "Can I change an approved custom design?",
            "answer": "<p>Once the final design and specifications have been approved, they are considered confirmed. If you request changes afterwards, please contact YAZ & Co as soon as possible. Changes may not be possible once production has begun and may result in additional costs or production time.</p>"
          }
        }
      },
