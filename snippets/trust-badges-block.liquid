{%- if block.settings.show_block -%}
  {%- liquid
    assign badges = ''
    for i in (1..6)
      assign icon_key = 'icon_' | append: i
      assign label_key = 'label_' | append: i
      assign image_key = 'image_' | append: i
      assign label_val = block.settings[label_key]
      if label_val != blank
        assign badges = badges | append: i | append: ','
      endif
    endfor
    assign badge_indexes = badges | split: ','
    assign visible_count = badge_indexes.size
  -%}

  {%- if visible_count > 0 -%}
    <style>
      .tbb-{{ block.id }} {
        margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
        padding: {{ block.settings.pad_v }}px 0;
        border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
        border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
        font-family: inherit;
      }
      {% if block.settings.border_width == 0 %}
      .tbb-{{ block.id }} {
        border-top: 0;
        border-bottom: 0;
      }
      {% endif %}
      .tbb-{{ block.id }} .tbb__row {
        display: grid;
        grid-template-columns: repeat({{ visible_count }}, 1fr);
        align-items: center;
        gap: 0;
      }
      .tbb-{{ block.id }} .tbb__item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: {{ block.settings.icon_gap }}px;
        padding: {{ block.settings.item_pad_v }}px {{ block.settings.item_pad_h }}px;
      }
      /* Vertical divider between items (not on first) */
      .tbb-{{ block.id }} .tbb__item + .tbb__item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        height: {{ block.settings.divider_height }}%;
        width: {{ block.settings.divider_width }}px;
        background: {{ block.settings.divider_color }};
      }
      .tbb-{{ block.id }} .tbb__icon {
        width: {{ block.settings.icon_size }}px;
        height: {{ block.settings.icon_size }}px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: {{ block.settings.icon_color }};
      }
      .tbb-{{ block.id }} .tbb__icon img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        display: block;
        object-fit: contain;
      }
      .tbb-{{ block.id }} .tbb__icon svg {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: currentColor;
        stroke-width: {{ block.settings.icon_stroke }};
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .tbb-{{ block.id }} .tbb__label {
        font-size: {{ block.settings.label_size }}px;
        font-weight: {{ block.settings.label_weight }};
        color: {{ block.settings.label_color }};
        line-height: 1.3;
        margin: 0;
        letter-spacing: {{ block.settings.label_tracking }}em;
      }
      @media (max-width: 749px) {
        .tbb-{{ block.id }} {
          margin: {{ block.settings.margin_top_mobile }}px 0 {{ block.settings.margin_bottom_mobile }}px;
          padding: {{ block.settings.pad_v_mobile }}px 0;
        }
        .tbb-{{ block.id }} .tbb__item {
          padding: {{ block.settings.item_pad_v_mobile }}px {{ block.settings.item_pad_h_mobile }}px;
          gap: {{ block.settings.icon_gap_mobile }}px;
        }
        .tbb-{{ block.id }} .tbb__icon {
          width: {{ block.settings.icon_size_mobile }}px;
          height: {{ block.settings.icon_size_mobile }}px;
        }
        .tbb-{{ block.id }} .tbb__label {
          font-size: {{ block.settings.label_size_mobile }}px;
        }
      }
    </style>

    <div class="tbb-{{ block.id }}" {{ block.shopify_attributes }}>
      <div class="tbb__row">
        {%- for idx in badge_indexes -%}
          {%- assign i = idx | strip -%}
          {%- if i != blank -%}
            {%- assign icon_key = 'icon_' | append: i -%}
            {%- assign label_key = 'label_' | append: i -%}
            {%- assign image_key = 'image_' | append: i -%}
            {%- assign icon_val = block.settings[icon_key] -%}
            {%- assign label_val = block.settings[label_key] -%}
            {%- assign image_val = block.settings[image_key] -%}

            <div class="tbb__item">
              <span class="tbb__icon" aria-hidden="true">
                {%- if image_val != blank -%}
                  {{- '<!-- Custom uploaded icon -->' -}}
                  <img
                    src="{{ image_val | image_url: width: 200 }}"
                    srcset="{{ image_val | image_url: width: 100 }} 100w, {{ image_val | image_url: width: 200 }} 200w, {{ image_val | image_url: width: 300 }} 300w"
                    sizes="{{ block.settings.icon_size }}px"
                    alt="{{ label_val | escape }}"
                    loading="lazy"
                    width="{{ image_val.width }}"
                    height="{{ image_val.height }}"
                  >
                {%- else -%}
                  {{- '<!-- Built-in SVG preset -->' -}}
                  {%- case icon_val -%}
                    {%- when 'warranty' -%}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="6"/><path d="M9 14l-2 6 5-3 5 3-2-6"/><text x="12" y="11" text-anchor="middle" font-size="4" stroke="none" fill="currentColor" font-weight="700">1Y</text></svg>
                    {%- when 'shipping' -%}
                      <svg viewBox="0 0 24 24"><rect x="1" y="6" width="14" height="11"/><polyline points="15 9 19 9 22 13 22 17 15 17"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
                    {%- when 'return' -%}
                      <svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><polyline points="3 7 12 11 21 7"/><line x1="12" y1="11" x2="12" y2="21"/></svg>
                    {%- when 'secure' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/><polyline points="9 12 11 14 15 10"/></svg>
                    {%- when 'support' -%}
                      <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    {%- when 'gift' -%}
                      <svg viewBox="0 0 24 24"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96c1.4 9.3-3.4 11.04-8.2 17.04"/><path d="M2 22c1.36-3.36 4.7-7.18 8-9"/></svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'check' -%}
                      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- when 'card' -%}
                      <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                    {%- when 'lock' -%}
                      <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </span>
              {%- if label_val != blank -%}
                <p class="tbb__label">{{ label_val }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
