<script>
  document.addEventListener("DOMContentLoaded", function () {
    var sectionId = {{ section.id | json }};
    // This snippet can render twice (desktop + mobile gallery wrappers), producing
    // duplicate ids. Pair each instance up positionally instead of using
    // getElementById, which would only ever resolve the first (desktop) copy.
    var bars = document.querySelectorAll('[id="StickyATC-' + sectionId + '"]');
    var targetBtns = document.querySelectorAll('[id="AddToCartButton-' + sectionId + '"]');
    var stickyBtns = document.querySelectorAll('[id="StickyATCButton-' + sectionId + '"]');
    var mainPriceWraps = document.querySelectorAll('[id="price-' + sectionId + '"]');
    var stickyPriceWraps = document.querySelectorAll('[id="StickyATCPrice-' + sectionId + '"]');

    var footerEl = document.querySelector("footer");
    var footerVisible = false;

    var footerObserver = null;
    if (footerEl) {
      footerObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          footerVisible = entry.isIntersecting;
        });
        updateAllVisibility();
      }, { threshold: 0 });
      footerObserver.observe(footerEl);
    }

    var buttonPassedByIndex = [];

    function updateAllVisibility() {
      bars.forEach(function (bar, index) {
        bar.classList.toggle("is-visible", !!buttonPassedByIndex[index] && !footerVisible);
      });
    }

    bars.forEach(function (bar, index) {
      var targetBtn = targetBtns[index];
      var stickyBtn = stickyBtns[index];
      var mainPriceWrap = mainPriceWraps[index];
      var stickyPriceWrap = stickyPriceWraps[index];

      if (!targetBtn) return;

      var btnObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          buttonPassedByIndex[index] = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          updateAllVisibility();
        });
      }, { threshold: 0 });
      btnObserver.observe(targetBtn);

      if (stickyBtn) {
        stickyBtn.addEventListener("click", function () {
          targetBtn.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      }

      if (mainPriceWrap && stickyPriceWrap) {
        var syncPrice = function () {
          stickyPriceWrap.innerHTML = mainPriceWrap.innerHTML;
        };
        syncPrice();
        var priceObserver = new MutationObserver(syncPrice);
        priceObserver.observe(mainPriceWrap, { childList: true, subtree: true, characterData: true });
      }
    });
  });
</script>

<product-modal id="ProductModal-{{ section.id }}" class="product-media-modal">
  <div
    class="product-media-modal__dialog container"
    role="dialog"
    aria-label="{{ 'products.modal.label' | t }}"
    aria-modal="true"
    tabindex="-1"
  >
    <div class="product__media-sublist-outer product__media-sublist__sidebar-nav media_size-{{ section.settings.image_ratio }} no-js-hidden">
      <div class="product__media-sublist {% if product.media.size < 2 %}product__media-sublist--height{% endif %} js-media-sublist swiper">
        <div class="swiper-wrapper">
          {%- if product.selected_or_first_available_variant.featured_media != null -%}
            {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
            <div
              class="product__media-subitem product__media-subitem__sidebar-sublist-item {% if section.settings.image_fit == 'contain' %} product__media-item--contain{% endif %}"
              data-media-sub-id="{{ section.id }}-{{ featured_media.id }}"
            >
              {%- liquid
                assign aspect_ratio_img = 100 | divided_by: featured_media.preview_image.aspect_ratio | round: 2
                assign width_ratio = 1
                if aspect_ratio_img < 132
                  assign width_ratio = 132.0 | divided_by: aspect_ratio_img | round: 2
                endif
                assign width_ratio_mobile = 1
                if aspect_ratio_img < 155
                  assign width_ratio_mobile = 155.0 | divided_by: aspect_ratio_img | round: 2
                endif
              -%}
              {% capture sizes %}
								(min-width: 1100px) calc(200px * {{ width_ratio }}),
								calc(((100vw - 6rem) / 4) * {{ width_ratio_mobile }})
							{% endcapture %}
              <a href="#{{ section.id }}-{{ media.id }}" aria-label="Product media">
                <div class="product__media">
                  {{
                    featured_media.preview_image
                    | image_url: width: featured_media.preview_image.width
                    | image_tag:
                      loading: 'lazy',
                      widths: '150, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900, 2000, 2200, 2400, 2600, 2800, 3000, 3200 ',
                      sizes: sizes
                  }}
                </div>
              </a>
            </div>
          {%- endif -%}

          {%- for media in product.media -%}
            {% if show_only_variant_media %}
              {% break %}
            {% endif %}

            {% if section.settings.variant_media_display == 'hide_unselected_variant_media'
              and variant_images contains media.src
            %}
              {% continue %}
            {% endif %}
            {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
              <div
                class="product__media-subitem product__media-subitem__sidebar-sublist-item {% if variant_images contains media.src %} product__media-item--variant{% endif %} {% if section.settings.image_fit == 'contain' %} product__media-item--contain{% endif %}"
                data-media-sub-id="{{ section.id }}-{{ media.id }}"
              >
                {%- liquid
                  assign aspect_ratio_img = 100 | divided_by: media.preview_image.aspect_ratio | round: 2
                  assign width_ratio = 1
                  if aspect_ratio_img < 132
                    assign width_ratio = 132.0 | divided_by: aspect_ratio_img | round: 2
                  endif
                  assign width_ratio_mobile = 1
                  if aspect_ratio_img < 155
                    assign width_ratio_mobile = 155.0 | divided_by: aspect_ratio_img | round: 2
                  endif
                -%}
                {% capture sizes %}
									(min-width: 1100px) calc(200px * {{ width_ratio }}),
									calc(((100vw - 6rem) / 4) * {{ width_ratio_mobile }})
								{% endcapture %}
                <a href="#{{ section.id }}-{{ media.id }}" aria-label="Product media">
                  <div class="product__media">
                    {{
                      media.preview_image
                      | image_url: width: media.preview_image.width
