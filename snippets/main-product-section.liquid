                                  {{ option.name }}: <span>{{- option.selected_value -}}</span>
                                </div>
                                <ul class="product-form__controls-group">
                                  {% render 'product-variant-options', product: product, option: option, dta-model: popup, block: block, option_name_first: option_name_first, option_name: option_name, notify_me: notify_me, variant_scope: variant_scope, force_dropdown: true %}
                                </ul>
