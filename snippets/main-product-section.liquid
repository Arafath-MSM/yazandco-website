  </style>

<script>
(function () {

  const sectionId = {{ section.id | json }};
  const blockId = {{ block.id | json }};

  {% comment %}
    The product section is rendered twice (a desktop and a mobile copy), so this
    script is emitted twice with the same ids and its document-level listeners
    would be registered twice. Register them once.
  {% endcomment %}
  window.__engravingBlocksBound = window.__engravingBlocksBound || {};
  if (window.__engravingBlocksBound[blockId]) return;
  window.__engravingBlocksBound[blockId] = true;

  function getBlock() {
    return document.querySelector(
      '.engraving-block--' + CSS.escape(blockId)
    );
  }

  function getInput() {
    const block = getBlock();
    if (!block) return null;

    return block.querySelector(
      '[data-engraving-input]'
    );
  }

  {% comment %}
    Resolve the product form belonging to the SAME copy of the section as the
    input the shopper actually typed into. Looking it up with getElementById
    always returned the first (desktop) copy, so on mobile the engraving text was
    written to a hidden form and never reached the cart.
  {% endcomment %}
  function getProductForm(input) {
    if (input) {
      const scope =
        input.closest('.main-product-mobile-section-wrapper') ||
        input.closest('.main-product-desktop-section-wrapper') ||
        input.closest('[id^="MainProduct-"]');

      if (scope) {
        const scoped =
          scope.querySelector('#product-form-' + CSS.escape(sectionId)) ||
          scope.querySelector('form[action*="/cart/add"]');
        if (scoped) return scoped;
      }
    }

    return document.getElementById(
      'product-form-' + sectionId
    );
  }

  function getPropertyField(input) {
    const form = getProductForm(input);

    if (!form) {
      return null;
    }

    let field = form.querySelector(
      '[name="properties[Engraving]"]'
    );

    if (!field) {
      field = document.createElement('input');
      field.type = 'hidden';
      field.name = 'properties[Engraving]';
      form.appendChild(field);
    }

    return field;
  }

  function syncEngraving(inputEl) {
    const input = inputEl || getInput();
    if (!input) return '';

    const value = input.value.trim();

    // Keep every rendered copy of the form in step, so it does not matter which
    // one the shopper ends up submitting.
    const forms = document.querySelectorAll(
      '#product-form-' + CSS.escape(sectionId)
    );

    if (forms.length) {
      forms.forEach(function (form) {
        let field = form.querySelector('[name="properties[Engraving]"]');
        if (!field) {
          field = document.createElement('input');
          field.type = 'hidden';
          field.name = 'properties[Engraving]';
          form.appendChild(field);
        }
        field.value = value;
      });
    } else {
      const property = getPropertyField(input);
      if (!property) return '';
      property.value = value;
    }

    return value;
  }


  /* LIVE INPUT */
  document.addEventListener(
    'input',
    function(event) {

      const input = event.target.closest(
        '[data-engraving-input]'
      );

      if (!input) return;

      const block = input.closest(
        '.engraving-block'
      );

      if (!block) return;

      const counter = block.querySelector(
        '[data-engraving-count]'
      );

      if (counter) {
        counter.textContent = input.value.length;
      }

      const success = block.querySelector(
        '[data-engraving-success]'
      );

      if (success) {
        success.hidden = true;
      }

      syncEngraving(input);
    },
    true
  );


  /* ENGRAVING SUBMIT BUTTON */
  document.addEventListener(
    'click',
    function(event) {

      const button = event.target.closest(
        '[data-engraving-save]'
      );

      if (!button) return;

      event.preventDefault();

      const block0 = button.closest('.engraving-block');
      const value = syncEngraving(
        block0 ? block0.querySelector('[data-engraving-input]') : null
      );

      const block = button.closest(
        '.engraving-block'
      );

      const success = block
        ? block.querySelector(
            '[data-engraving-success]'
          )
        : null;

      if (success) {
        success.textContent = value
          ? 'Engraving saved'
          : 'Engraving removed';

        success.hidden = false;
      }

      console.log(
        'Engraving:',
        value
      );
    },
    true
  );


  /* ENTER KEY */
  document.addEventListener(
    'keydown',
    function(event) {

      const input = event.target.closest(
        '[data-engraving-input]'
      );

      if (!input) return;

      if (event.key !== 'Enter') return;

      event.preventDefault();

      syncEngraving(input);

      const block = input.closest(
        '.engraving-block'
      );

      const success = block
        ? block.querySelector(
            '[data-engraving-success]'
          )
        : null;

      if (success) {
        success.textContent =
          input.value.trim()
            ? 'Engraving saved'
            : 'Engraving removed';

        success.hidden = false;
      }
    },
    true
  );


  /*
   * ADD TO CART CLICK:
   * ONLY sync value.
   *
   * IMPORTANT:
   * No preventDefault()
   * No stopPropagation()
   * No fetch()
   *
   * Theme ka original product-form
   * cart drawer handle karega.
   */
  document.addEventListener(
    'click',
    function(event) {

      const addButton = event.target.closest(
        '#product-form-' +
        CSS.escape(sectionId) +
        ' button[name="add"]'
      );

      if (!addButton) return;

      // Read the engraving from the copy of the section this button belongs to.
      const scope =
        addButton.closest('.main-product-mobile-section-wrapper') ||
        addButton.closest('.main-product-desktop-section-wrapper') ||
        addButton.closest('[id^="MainProduct-"]');

      syncEngraving(
        scope ? scope.querySelector('[data-engraving-input]') : null
      );
    },
    true
  );


  /* INITIAL */
  syncEngraving();

})();
</script>

            {%- when 'variant_picker' -%}
                <div class="product-parameters {% if block.settings.picker_type == 'button' %}product-parameters-radius{% endif %}">
                  {% unless product.has_only_default_variant %}
                    {% if block.settings.picker_type == 'button' %}
                      <variant-radios
                        id="variant-radios-{{ section.id }}{{ variant_scope }}"
                        class="no-js-hidden variant-radios"
                        data-section="{{ section.id }}"
                        data-url="{{ product.url }}"
                        {{ block.shopify_attributes }}
                        data-variant-media-display="{{ section.settings.variant_media_display }}"
                      >
                        {%- for option in product.options_with_values -%}
                          {% liquid
                            assign color_swatch = false
                            assign option_name_first = ''
                            assign color_trigger = settings.trigger_swatch | append: '<br />' | append: settings.trigger_swatch_other | strip | newline_to_br | split: '<br />'
                            assign name_option = option.name | handle | strip
                            assign option_name = option.name | escape | downcase | strip
                            assign size_text = 'general.size' | t | downcase | strip
                            assign color_text = 'general.color' | t | downcase | strip
                            assign option_name_low = option.name | downcase | strip

                            for item in color_trigger
                              assign item_temp = item | handle | strip
                              if name_option == item_temp
                                assign color_swatch = true
                                assign option_name_first = item_temp
                              endif
                            endfor
                          %}

                          {% if option_name == size_text %}
                            <fieldset
                              class="product-form__controls product-form__controls--dropdown"
                              id="SingleOptionSelector-{{ forloop.index0 }}{{ variant_scope }}"
                            >
                              <div class="select dropdown-select">
