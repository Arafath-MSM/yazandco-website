                <script>
                  if (!window.__reviewsAccordionNavBound) {
                    window.__reviewsAccordionNavBound = true;
                    document.addEventListener('click', function (event) {
                      var btn = event.target.closest('[data-reviews-prev], [data-reviews-next]');
                      if (!btn) return;
                      var blockId = btn.getAttribute('data-reviews-prev') || btn.getAttribute('data-reviews-next');
                      var track = document.getElementById('ReviewsTrack-' + blockId);
                      if (!track) return;
                      var card = track.querySelector('.reviews-accordion__card');
                      var amount = card ? card.getBoundingClientRect().width + 16 : track.clientWidth;
                      track.scrollBy({
                        left: btn.hasAttribute('data-reviews-prev') ? -amount : amount,
                        behavior: 'smooth'
                      });
                    });
                  }
