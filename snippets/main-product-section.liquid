                                      {%- comment -%}
                                        page.content only returns the page's plain
                                        body field. A page built with a JSON
                                        template (sections) has that field empty -
                                        its real content lives in the template's
                                        sections instead. The data-page-url below
                                        lets JS fetch the page's actual rendered
                                        output and swap it in, so this works for
                                        both kinds of page. The inline
                                        page.content output is just the instant,
                                        no-JS-delay fallback for plain pages.
                                      {%- endcomment -%}
                                      <div
                                        class="size_guide_content"
                                        data-page-content
                                        data-page-url="{{ block.settings.page.url }}"
                                      >
                                        {{ block.settings.page.content }}
                                      </div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              </modal-dialog>
                            {% endif %}
                          </fieldset>
