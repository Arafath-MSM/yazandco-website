<div class="product {% if product.media.size > 0 %}row{% else %}product--no-media{% endif %}">
  <div
    class="
      {% if gallery_type == 'static_multicolumns_aside' or gallery_type == 'thumbs_aside' or gallery_type == 'thumbs_aside_horizontal' or gallery_type == 'mobile_sliding_bar' %} container {% endif %} product__outer product__outer--{% if gallery_type == 'static_multicolumns_aside' %}static-multicolumns-aside{% elsif gallery_type == 'thumbs_aside' or gallery_type == 'thumbs_aside_horizontal' or gallery_type == 'mobile_sliding_bar' or gallery_type == 'full_horizontal_slider' %}thumbs-aside{% elsif gallery_type == 'static_column_aside' %}static-column-aside{% elsif gallery_type == 'two_column_aside' %}two-column-aside{% endif %}
      {% if section.settings.desktop_alignment == 'right' %}product__outer--desktop-order{% endif %}
      {% if section.settings.mobile_alignment == 'after' %}product__outer--mobile-order{% endif %}
      {% if gallery_type == 'thumbs_aside_horizontal' or gallery_type == 'mobile_sliding_bar' %} thumbs_aside_horizontal {% endif %}
    "
  >
    <div class="product__main">
      {% liquid
        if section.settings.variant_media_display == 'hide_unselected_variant_media'
          assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
        endif

        assign show_only_variant_media = false
        if section.settings.variant_media_display == 'show_only_variant_media' and product.selected_or_first_available_variant.featured_media != null
          assign show_only_variant_media = true
        endif
      %}
      {% if product.media.size > 0 %}
        <div class="product__media-wrapper" data-section="product-media-{{ section.id }}">
          <div class="product__media-list-wrapper">
            <div
              class="product__media-list media_size-{{ section.settings.image_ratio }} {% if gallery_type != 'static_multicolumns_aside' and gallery_type != 'static_column_aside' and gallery_type != 'two_column_aside' %}js-media-list swiper {% endif %} {% if gallery_type == 'static_multicolumns_aside' and product.media.size == 1 %} product__media-list--full{% endif %} {% if section.settings.enable_full_screen %} product__media-list--full_screen {% endif %}no-js-hidden"
              data-direction="{{ section.settings.slider_direction }}"
              data-gallery-type="{{ gallery_type }}"
              {% if gallery_type == 'thumbs_aside_horizontal'
                or gallery_type == 'mobile_sliding_bar'
                or gallery_type == 'full_horizontal_slider'
              %}
                data-direction_desc="horizontal"
              {% else %}
                data-direction_desc="vertical"
              {% endif %}
              data-slider-type="main-product"
            >
              {% if gallery_type != 'static_multicolumns_aside'
                and gallery_type != 'static_column_aside'
                and gallery_type != 'two_column_aside'
              %}
                <div class="swiper-wrapper">
              {% endif %}
              {%- liquid
                assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
                assign media_count = product.media.size
              -%}

              {%- if product.selected_or_first_available_variant.featured_media != null -%}
                {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
                <div
                  class="product__media-item swiper-slide {% if section.settings.image_fit == 'contain' %}product__media-item--contain{% endif %}"
                  data-media-id="{{ section.id }}-{{ featured_media.id }}"
                >
                  {% render 'product-thumbnail',
                    product_card_product: product,
                    media: featured_media,
                    position: 'featured',
                    modal_id: section.id,
                    lazy_load: false,
                    class: 'img-responsive',
                    gallery_type: gallery_type
                  %}
                  {% if gallery_type == 'two_column_aside' %}
                    <div id="image_number" class="image_number secondary_text">
                      <span class="first_number"></span>
                      <span>
                        {% if product.media.size > 10 %}
                          {{ product.media.size }}
                        {% else %}
                          0{{ product.media.size }}
                        {%- endif -%}
                      </span>
                    </div>
                  {% endif %}
                </div>
              {%- endif -%}

              {%- for media in product.media -%}
                {% if show_only_variant_media %}
                  {% break %}
                {% endif %}

                {% if section.settings.variant_media_display == 'hide_unselected_variant_media'
                  and variant_images contains media.src
                %}
                  {% continue %}
                {% endif %}
                {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                  <div
                    class="product__media-item swiper-slide{% if media.media_type != 'image' %} product__media-item--full{% endif %} {% if variant_images contains media.src %} product__media-item--variant{% endif %} {% if section.settings.image_fit == 'contain' %} product__media-item--contain{% endif %}"
                    data-media-id="{{ section.id }}-{{ media.id }}"
                  >
                    {% render 'product-thumbnail',
                      media: media,
                      position: forloop.index,
                      modal_id: section.id,
                      lazy_load: false,
                      class: 'img-responsive',
                      gallery_type: gallery_type
                    %}
                    {% if gallery_type == 'two_column_aside' and forloop.index == 1 %}
                      <div id="image_number" class="image_number secondary_text">
                        <span class="first_number"></span>
                        <span>
                          {% if product.media.size > 10 %}
                            {{ product.media.size }}
                          {% else %}
                            0{{ product.media.size }}
                          {%- endif -%}
                        </span>
                      </div>
                    {% endif %}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
              {% if gallery_type != 'static_multicolumns_aside'
                and gallery_type != 'static_column_aside'
                and gallery_type != 'two_column_aside'
              %}
                </div>
              {% endif %}

              {% if gallery_type != 'static_multicolumns_aside'
                and gallery_type != 'static_column_aside'
                and gallery_type != 'two_column_aside'
              %}
                {% if product.media.size > 1 %}
                  <div class="container product__pagination-wrapper {% if gallery_type == 'mobile_sliding_bar' or gallery_type == 'full_horizontal_slider'%}product__pagination-mobile_sliding_bar-wrapper{% endif %} {% if gallery_type == 'full_horizontal_slider'%}product__pagination-desktop_sliding_bar-wrapper{% endif %}">
                    <div class="product__pagination swiper-pagination"></div>
                  </div>

                  <div class="product__slider-nav container no-js-hidden">
                    <div class="swiper-button-prev focus-inset">
                      {% render 'icon-caret-left' %}
                    </div>
                    <div class="swiper-button-next focus-inset">
                      {% render 'icon-caret-right' %}
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            </div>

            {% if gallery_type == 'thumbs_aside'
              or gallery_type == 'thumbs_aside_horizontal'
              or gallery_type == 'mobile_sliding_bar'
            %}
              <div class="product__media-sublist-outer media_size-{{ section.settings.image_ratio }} no-js-hidden {% if gallery_type == 'mobile_sliding_bar' %} product__media-sublist-outer__mobile_sliding_bar {% endif %}">
                <div
                  class="product__media-sublist {% if product.media.size < 2 %}product__media-sublist--height{% endif %} js-media-sublist swiper"
                  {% if gallery_type == 'thumbs_aside_horizontal' or gallery_type == 'mobile_sliding_bar' %}
                    data-direction="horizontal"
                  {% else %}
                    data-direction="vertical"
                  {% endif %}
                  data-slider-type="sub-product"
                >
                  <div class="swiper-wrapper">
                    {%- if product.selected_or_first_available_variant.featured_media != null -%}
                      {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
                      <div
                        class="product__media-subitem swiper-slide {% if section.settings.image_fit == 'contain' %} product__media-item--contain{% endif %}"
                        data-media-sub-id="{{ section.id }}-{{ featured_media.id }}"
                      >
                        {%- liquid
                          assign aspect_ratio_img = 100 | divided_by: featured_media.preview_image.aspect_ratio | round: 2
                          assign width_ratio = 1
                          if aspect_ratio_img < 132
                            assign width_ratio = 132.0 | divided_by: aspect_ratio_img | round: 2
                          endif
                          assign width_ratio_mobile = 1
                          if aspect_ratio_img < 155
                            assign width_ratio_mobile = 155.0 | divided_by: aspect_ratio_img | round: 2
                          endif
                        -%}
                        {% capture sizes %}
													(min-width: 1100px) calc(200px * {{ width_ratio }}),
													calc(((100vw - 6rem) / 4) * {{ width_ratio_mobile }})
												{% endcapture %}

                        <div class="product__media">
                          {{
                            featured_media.preview_image
                            | image_url: width: featured_media.preview_image.width
                            | image_tag:
                              loading: 'lazy',
                              widths: '150, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900, 2000, 2200, 2400, 2600, 2800, 3000, 3200 ',
                              sizes: sizes
                          }}
                        </div>
                      </div>
                    {%- endif -%}

                    {%- for media in product.media -%}
                      {% if show_only_variant_media %}
                        {% break %}
                      {% endif %}

                      {% if section.settings.variant_media_display == 'hide_unselected_variant_media'
                        and variant_images contains media.src
                      %}
                        {% continue %}
                      {% endif %}
                      {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                        <div
                          class="product__media-subitem swiper-slide {% if variant_images contains media.src %} product__media-item--variant{% endif %} {% if section.settings.image_fit == 'contain' %} product__media-item--contain{% endif %}"
                          data-media-sub-id="{{ section.id }}-{{ media.id }}"
                        >
                          {%- liquid
                            assign aspect_ratio_img = 100 | divided_by: media.preview_image.aspect_ratio | round: 2
                            assign width_ratio = 1
                            if aspect_ratio_img < 132
                              assign width_ratio = 132.0 | divided_by: aspect_ratio_img | round: 2
                            endif
                            assign width_ratio_mobile = 1
                            if aspect_ratio_img < 155
                              assign width_ratio_mobile = 155.0 | divided_by: aspect_ratio_img | round: 2
                            endif
                          -%}
                          {% capture sizes %}
														(min-width: 1100px) calc(200px * {{ width_ratio }}),
														calc(((100vw - 6rem) / 4) * {{ width_ratio_mobile }})
													{% endcapture %}

                          <div class="product__media">
                            {{
                              media.preview_image
                              | image_url: width: media.preview_image.width
                              | image_tag:
                                loading: 'lazy',
                                height: '187',
                                widths: '150, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900, 2000, 2200, 2400, 2600, 2800, 3000, 3200 ',
                                sizes: sizes
                            }}
                          </div>
                        </div>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {% endif %}

            <div class="product__media-grid-noscript js-hidden">
              <div class="product__media-list">
                {%- if product.selected_or_first_available_variant.featured_media != null -%}
                  {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
                  <div
                    class="product__media-item {% if section.settings.image_fit == 'contain' %}product__media-item--contain{% endif %}"
                    data-media-id="{{ section.id }}-{{ featured_media.id }}"
                  >
                    {% render 'product-thumbnail',
                      product_card_product: product,
                      media: featured_media,
                      position: 'featured',
                      modal_id: section.id,
                      lazy_load: false,
                      gallery_type: gallery_type
                    %}
                  </div>
                {%- endif -%}

                {%- for media in product.media -%}
                  {% if show_only_variant_media %}
                    {% break %}
                  {% endif %}

                  {% if section.settings.variant_media_display == 'hide_unselected_variant_media'
                    and variant_images contains media.src
                  %}
                    {% continue %}
                  {% endif %}
                  {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                    <div
                      class="product__media-item {% if media.media_type != 'image' %} product__media-item--full{% endif %} {% if variant_images contains media.src %} product__media-item--variant{% endif %} {% if section.settings.image_fit == 'contain' %} product__media-item--contain{% endif %}"
                      data-media-id="{{ section.id }}-{{ media.id }}"
                    >
                      {% render 'product-thumbnail',
                        media: media,
                        position: forloop.index,
                        modal_id: section.id,
                        lazy_load: false,
                        gallery_type: gallery_type
                      %}
                    </div>
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {% else %}
        <div class="product__media-wrapper" data-section="product-media-{{ section.id }}">
          <div class="product__media-list-wrapper">
            <div class="product__media-list {% if gallery_type == 'static_multicolumns_aside' %} product__media-list--full{% endif %}">
              <div class="product__media-item">
                <div class="product__media media">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    <div id="ProductInfo-{{ section.id }}" data-section="{{ section.id }}" class="product__info-container">
      <div class="product__info-main {% if gallery_type == 'full_horizontal_slider' %}product__info-main__full--container{% endif %}">
        <div class="product__info-main_content">
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- comment -%} Find the review app block (e.g. Judge.me) so it can be rendered beside the title instead of at its original block position. {%- endcomment -%}
          {%- liquid
            assign review_widget_block = nil
            for review_scan_block in section.blocks
              if review_scan_block.type contains 'judge-me' or review_scan_block.type contains 'reviews' or review_scan_block.type contains 'trustyy-reviews'
                assign review_widget_block = review_scan_block
              endif
            endfor
          -%}
          {%- capture review_widget_html -%}
            {%- if review_widget_block -%}
              {% render review_widget_block %}
            {%- endif -%}
          {%- endcapture -%}

          {%- comment -%} Book a Consultation + Send a Hint render together as one row, anchored at whichever block appears first. {%- endcomment -%}
          {%- assign secondary_actions_rendered = false -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="product__text subtitle" {{ block.shopify_attributes }}>
                  {% if block.settings.text != blank %}
                    {% if product.vendor == block.settings.text and settings.enable_vendor_link %}
                      {{ block.settings.text | link_to_vendor: class: 'focus-inset' }}
                    {% else %}
                      {{ block.settings.text }}
                    {% endif %}
                  {% endif %}
                </div>

              {%- when 'tags' -%}
                {%- if product.tags != blank -%}
                  <div class="product__tags">
                    {% for tag in product.tags %}
                      <a href="/collections/all/{{ tag | handleize }}" class="product__tags_tag link-hover-line">
                        <span>{{ tag }}</span>
                      </a>
                    {% endfor %}
                  </div>
                {%- endif -%}

              {%- when 'title' -%}
                <div
                  class="
                    product__title__wrapper product-title-review-row
                    {%- if product.available == false %} price--sold-out {% endif -%}
                    {%- if product.compare_at_price > product.price %} price--on-sale {% endif -%}
                    {%- if block.settings.reviews_inline_desktop %} product-title-review-row--inline-desktop{% endif -%}
                    {%- if block.settings.reviews_above_mobile %} product-title-review-row--reviews-first-mobile{% endif -%}
                  "
                  data-block-id="{{ block.id }}"
                  style="
                    --title-review-justify: {{ block.settings.desktop_title_review_align }};
                    --title-review-gap: {{ block.settings.title_review_gap }}px;
                    --title-review-gap-mobile: {{ block.settings.title_review_gap_mobile }}px;
                    --title-review-star-size: {{ block.settings.review_star_size }}px;
                    --title-review-star-size-mobile: {{ block.settings.review_star_size_mobile }}px;
                    --title-review-star-color: {{ block.settings.review_star_color }};
                    --title-review-text-color: {{ block.settings.review_text_color }};
                    --title-mobile-align: {{ block.settings.mobile_align }};
                    --title-font-size-desktop: {{ block.settings.title_font_size_desktop }}px;
                    --title-font-size-mobile: {{ block.settings.title_font_size_mobile }}px;
                    --title-font-weight: {{ block.settings.title_font_weight }};
                    {%- if block.settings.title_color != blank %}--title-color: {{ block.settings.title_color }};{% endif %}
                    --title-margin-top: {{ block.settings.title_margin_top }}px;
                    --title-margin-bottom: {{ block.settings.title_margin_bottom }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  <h1 class="product__title {{ block.settings.heading_size }}">
                    {{ product.title | escape }}
                  </h1>
                  {%- if review_widget_html != blank -%}
                    <div class="product-title-review-row__reviews">
                      {{ review_widget_html }}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'custom_badges' -%}
                {% if product.metafields.custom.badges != blank %}
                  <div class="product__custom-badges">
                    {% if product.metafields.custom.badges.list? %}
                      {% for badge in product.metafields.custom.badges.value %}
                        <div class="product__badge">
                          <span
                            class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}"
                            aria-hidden="true"
                          >
                            {{ badge }}
                          </span>
                        </div>
                      {% endfor %}
                    {% else %}
                      <div class="product__badge">
                        <span
                          class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}"
                          aria-hidden="true"
                        >
                          {{ product.metafields.custom.badges }}
                        </span>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

              {%- when 'price' -%}
                <div class="no-js-hidden price-wrapper" id="price-{{ section.id }}" {{ block.shopify_attributes }}>
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    show_promotion: true,
                    price_class: 'price--product'
                  -%}
                  {%- if settings.badge_sale_show -%}
                    <div class="product__badge">
                      {%- if product.selected_or_first_available_variant.compare_at_price
                          > product.selected_or_first_available_variant.price
                        and product.selected_or_first_available_variant.available
                        and settings.badge_sale_show
                      -%}
                        <span class="badge badge--sale color-{{ settings.badge_sale_color_scheme }}" aria-hidden="true">
                          {% if settings.badge_sale_type == 'sale' %}
                            {{- 'products.product.on_sale' | t -}}
                          {% else %}
                            <span>
                              -
                              {{-
                                product.compare_at_price
                                | minus: product.price
                                | times: 100
                                | divided_by: product.compare_at_price
                              -}}
                              %
                            </span>
                          {% endif %}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax caption rte">
                      {%- if cart.taxes_included -%}
                        {{ 'products.product.include_taxes' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
                <div class="installment-wrapper" {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>

              {%- when 'description' -%}
                <div
                  class="product__description secondary_text {% if block.settings.description == blank and product.description != blank %} rte {% endif %} {% if settings.rte_type == 'custom' %}rte-container{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.description != blank %}
                    {{- block.settings.description | escape -}}
                  {% else %}
                    {{- product.description -}}
                  {% endif %}
                </div>

              {%- when 'sku' -%}
                <div class="product__sku">
                  <p class="secondary_text">
                    {{ block.settings.description }}
                  </p>
                  <p
                    class="product-sku secondary_text no-js-hidden {% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                    id="Sku-{{ section.id }}"
                    role="status"
                    {{ block.shopify_attributes }}
                  >
                    <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                    {{ block.settings.heading }} &nbsp;
                    {{- product.selected_or_first_available_variant.sku -}}
                  </p>
                </div>

              {%- when 'inventory' -%}
                <div id="Inventory-{{ section.id }}" class="product__inventory" {{ block.shopify_attributes }}>
                  <span class="product__inventory-inner secondary_text product__inventory-inner--{% if product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity < 10 %}error{% elsif product.selected_or_first_available_variant.inventory_quantity == 0 %}empty{% endif %}">
                    {% if product.selected_or_first_available_variant.inventory_quantity >= 10 %}
                      {{
                        'products.product.quantity.in_stock'
                        | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                      }}
                    {% elsif product.selected_or_first_available_variant.inventory_quantity > 0
                      and product.selected_or_first_available_variant.inventory_quantity < 10
                    %}
                      {{
                        'products.product.quantity.in_stock'
                        | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                      }}
                    {% elsif product.selected_or_first_available_variant.inventory_quantity == 0 %}
                      {{ 'products.product.quantity.out_of_stock' | t }}
                    {% endif %}
                  </span>
                </div>


                {%- when 'short_description' -%}

<div
class="short-description-{{ block.id }}"
{{ block.shopify_attributes }}
>

{% assign desc = block.settings.description | strip_html %}
{% assign words = desc | split: ' ' %}
{% assign limit = block.settings.word_limit %}


<div class="short-text">

{{ words | slice: 0, limit | join: ' ' }}

{% if words.size > limit %}
<span>...</span>

<modal-opener class="no-js-hidden" data-modal="#ShortDescPopup-{{ block.id }}">
<button type="button" class="read-more" aria-haspopup="dialog">
{{ block.settings.read_more_text }}
</button>
</modal-opener>

{% endif %}

</div>


</div>

{% if words.size > limit %}

<modal-dialog
id="ShortDescPopup-{{ block.id }}"
class="main-product-popup product-popup-modal"
>
<div
role="dialog"
aria-label="{{ block.settings.read_more_text | escape }}"
aria-modal="true"
class="product-popup-modal__content"
tabindex="-1"
>
<div class="product-popup-modal__top">
<h3 class="product-popup-modal__title">
{{ product.title }}
</h3>
<button
id="ModalClose-ShortDescPopup-{{ block.id }}"
type="button"
class="product-popup-modal__close modal-close-button focus-inset"
aria-label="{{ 'accessibility.close' | t }}"
>
{% render 'icon-close' %}
</button>
</div>
<div class="product-popup-modal__content-info">
<div class="product-popup-modal__text">
{{ block.settings.description }}
</div>
</div>
</div>
</modal-dialog>

{% endif %}


<style>

.short-description-{{ block.id }}{

font-size:{{ block.settings.font_size }}px;
color:{{ block.settings.font_color }};

}


.short-description-{{ block.id }} .read-more{

color:{{ block.settings.read_more_color }};
text-decoration:{{ block.settings.text_decoration }};
cursor:pointer;
background:none;
border:none;
padding:0;
font:inherit;

}

</style>

{%- when 'accordion' -%}

<details 
class="product-accordion-{{ block.id }}"
{{ block.shopify_attributes }}
>

<summary>

<span class="accordion-heading">
{{ block.settings.heading }}
</span>


<span class="accordion-icon">
+
</span>

</summary>


<div class="accordion-content">

{{ block.settings.content }}

</div>


</details>



<style>

.product-accordion-{{ block.id }} {

border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};

}



