                  <div class="share-buttons" aria-label="list">
                    <div class="share-buttons__label">
                      <span class="share-buttons__label-name subtitle">{{ 'general.share.share' | t }}</span>
                    </div>

                    <ul class="share-buttons__list list-unstyled">
                      {%- if block.settings.show_share_facebook -%}
                        <li class="share-buttons__item button">
                          <a
                            href="https://www.facebook.com/sharer.php?u={{ shop.url | append: product.url }}"
                            class="share-buttons__button facebook-btn focus-inset"
                            target="_blank"
                          >
                            {% if show_social_icons %}
                              {% render 'icon-facebook' %}
                            {% endif %}
                            <span class="share-button__name link-hover-line">
                              {{- 'general.share.links.facebook' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if block.settings.show_share_twitter -%}
                        <li class="share-buttons__item button">
                          <a
                            href="https://twitter.com/share?url={{ shop.url | append: product.url }}&text={{ product.title | escape }}"
                            class="share-buttons__button twitter-btn focus-inset"
                            target="_blank"
                          >
                            {% if show_social_icons %}
                              {% render 'icon-twitter' %}
                            {% endif %}
                            <span class="share-button__name link-hover-line">
                              {{- 'general.share.links.twitter' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if block.settings.show_share_pinterest -%}
                        <li class="share-buttons__item button">
                          <a
                            href="https://pinterest.com/pin/create/bookmarklet/?media={{ product.featured_media | image_url: width: 1100, height: 1100 }}&url={{ shop.url | append: product.url }}&description={{ product.title | escape }}"
                            class="share-buttons__button pinterest-btn"
                            target="_blank"
                          >
                            {% if show_social_icons %}
                              {% render 'icon-pinterest' %}
                            {% endif %}
                            <span class="share-button__name link-hover-line">
                              {{- 'general.share.links.pinterest' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if block.settings.show_share_copy -%}
                        <li class="share-buttons__item  copy-wrapper">
                          <a
                            href="{{ shop.url | append: product.url }}"
                            class="share-buttons__button copy-btn focus-inset"
                          >
                            {% if show_social_icons %}
                              {% render 'icon-share' %}
                            {% endif %}
                            <span class="share-button__name link-hover-line">{{ 'general.share.links.copy' | t }}</span>
                          </a>
                          <div id="tooltip" class="tooltip secondary_text">
                            {{ 'general.share.success_message' | t }}
                          </div>
                        </li>
                      {%- endif -%}
                    </ul>
                  </div>
                {%- endif -%}

              {% comment %} {%- when 'popup' -%}
                <div class="product-popup">
                  <modal-opener
                    class="no-js-hidden"
                    data-modal="#PopupModal-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <button
                      id="ProductPopup-{{ block.id }}"
                      class="button button--simple focus-inset"
                      type="button"
                      aria-haspopup="dialog"
                    >
                      <span>{{ block.settings.label }}</span>
                    </button>
                  </modal-opener>
                  <div class="product-popup-modal__content-info no-js">
                    <div class="product-popup-modal__text">
                      {{ block.settings.text }}
                    </div>
                    <h3 class="product-popup-modal__title">
                      {{ block.settings.heading }}
                    </h3>
                  </div>
                  <modal-dialog
                    id="PopupModal-{{ block.id }}"
                    class="main-product-popup product-popup-modal"
                    {{ block.shopify_attributes }}
                  >
                    <div
                      role="dialog"
                      aria-label="{{ block.settings.label }}"
                      aria-modal="true"
                      class="product-popup-modal__content"
                      tabindex="-1"
                    >
                      <div class="product-popup-modal__top">
                        <h3 class="product-popup-modal__title">
                          {{ block.settings.label }}
                        </h3>
                        <button
                          id="ModalClose-{{ block.id }}"
                          type="button"
                          class="product-popup-modal__close modal-close-button focus-inset"
