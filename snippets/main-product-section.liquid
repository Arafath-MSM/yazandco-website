  {%- when 'shipping_delivery' -%}

  {%- liquid
    assign customer_country = localization.country.iso_code
    assign is_uae = false

    if customer_country == 'AE'
      assign is_uae = true
    endif
  -%}

  <div
    class="pd-blk shipping-delivery shipping-delivery--{{ block.id }}"
    data-shipping-delivery="{{ block.id }}"
    data-country="{{ customer_country }}"
    data-uae-min="{{ block.settings.uae_min_days }}"
    data-uae-max="{{ block.settings.uae_max_days }}"
    data-int-min="{{ block.settings.international_min_days }}"
    data-int-max="{{ block.settings.international_max_days }}"
    data-skip-saturday="{{ block.settings.skip_saturday }}"
    data-skip-sunday="{{ block.settings.skip_sunday }}"
    data-date-format="{{ block.settings.date_format }}"
    style="
      margin-top: {{ block.settings.space_above }}px;
      margin-bottom: {{ block.settings.space_below }}px;
    "
    {{ block.shopify_attributes }}
  >

    {% if is_uae %}

      {% if block.settings.uae_heading != blank %}
        <div class="shipping-delivery__heading">
          {{ block.settings.uae_heading }}
        </div>
      {% endif %}

      <div class="shipping-delivery__text">

        {% if block.settings.uae_label != blank %}
          <span class="shipping-delivery__label">
            {{ block.settings.uae_label }}
          </span>
        {% endif %}

        <strong
          class="shipping-delivery__date"
          data-delivery-date
        >
          Calculating...
        </strong>

      </div>

    {% else %}

      {% if block.settings.international_heading != blank %}
        <div class="shipping-delivery__heading">
          {{ block.settings.international_heading }}
        </div>
      {% endif %}

      <div class="shipping-delivery__text">

        {% if block.settings.international_label != blank %}
          <span class="shipping-delivery__label">
            {{ block.settings.international_label }}
          </span>
        {% endif %}

        <strong
          class="shipping-delivery__date"
          data-delivery-date
        >
          Calculating...
        </strong>

      </div>

    {% endif %}

  </div>


  <style>

    .shipping-delivery--{{ block.id }} {
      width: 100%;

      padding:
        {{ block.settings.padding_vertical }}px
        {{ block.settings.padding_horizontal }}px;

      background:
        {{ block.settings.background_color }};

      border:
        {{ block.settings.border_width }}px
        solid
        {{ block.settings.border_color }};

      border-radius:
        {{ block.settings.border_radius }}px;

      box-sizing: border-box;
    }


    .shipping-delivery--{{ block.id }} * {
      box-sizing: border-box;
    }


    .shipping-delivery--{{ block.id }}
    .shipping-delivery__heading {

      margin:
        0 0
        {{ block.settings.heading_bottom_space }}px;

      color:
        {{ block.settings.heading_color }};

      font-size:
        {{ block.settings.heading_size }}px;

      font-weight:
        {{ block.settings.heading_weight }};

      line-height: 1.3;
    }


    .shipping-delivery--{{ block.id }}
    .shipping-delivery__text {

      display: flex;
      align-items: baseline;
      flex-wrap: wrap;

      gap:
        {{ block.settings.text_gap }}px;

      margin: 0;

      color:
        {{ block.settings.text_color }};

      font-size:
        {{ block.settings.text_size }}px;

      font-weight:
        {{ block.settings.text_weight }};

      line-height:
        {{ block.settings.line_height | divided_by: 10.0 }};
    }


    .shipping-delivery--{{ block.id }}
    .shipping-delivery__label {
      color:
        {{ block.settings.text_color }};
    }


    .shipping-delivery--{{ block.id }}
    .shipping-delivery__date {

      color:
        {{ block.settings.date_color }};

      font-size:
        {{ block.settings.date_size }}px;

      font-weight:
        {{ block.settings.date_weight }};
    }


    @media screen and (max-width: 749px) {

      .shipping-delivery--{{ block.id }} {

        padding:
          {{ block.settings.padding_vertical_mobile }}px
          {{ block.settings.padding_horizontal_mobile }}px;

      }


      .shipping-delivery--{{ block.id }}
      .shipping-delivery__heading {

        font-size:
          {{ block.settings.heading_size_mobile }}px;

      }


      .shipping-delivery--{{ block.id }}
      .shipping-delivery__text {

        font-size:
          {{ block.settings.text_size_mobile }}px;

      }


      .shipping-delivery--{{ block.id }}
      .shipping-delivery__date {

        font-size:
          {{ block.settings.date_size_mobile }}px;

      }

    }

  </style>


  <script>
    (function () {

      const block = document.querySelector(
        '[data-shipping-delivery="{{ block.id }}"]'
      );

      if (!block) return;


      /*
      =========================================
      SETTINGS
      =========================================
      */

      const country =
        block.dataset.country || '';


      const isUAE =
        country.toUpperCase() === 'AE';


      const uaeMin =
        parseInt(block.dataset.uaeMin, 10) || 3;

      const uaeMax =
        parseInt(block.dataset.uaeMax, 10) || 5;


      const internationalMin =
        parseInt(block.dataset.intMin, 10) || 7;

      const internationalMax =
        parseInt(block.dataset.intMax, 10) || 10;


      const skipSaturday =
        block.dataset.skipSaturday === 'true';

      const skipSunday =
        block.dataset.skipSunday === 'true';


      const dateFormat =
        block.dataset.dateFormat || 'short';


      /*
      =========================================
      GET TODAY
      =========================================

      Browser ki current date automatically
      use hogi.

      Isliye har din dates khud change hongi.
      =========================================
      */

      function getToday() {

        const now = new Date();

        return new Date(
          now.getFullYear(),
          now.getMonth(),
          now.getDate()
        );

      }


      /*
      =========================================
      CHECK BUSINESS DAY
      =========================================
      */

      function isBusinessDay(date) {

        const day =
          date.getDay();


        /*
        JavaScript:
        Sunday   = 0
        Saturday = 6
        */


        if (
          skipSaturday &&
          day === 6
        ) {
          return false;
        }


        if (
          skipSunday &&
          day === 0
        ) {
          return false;
        }


        return true;

      }


      /*
      =========================================
      ADD BUSINESS DAYS
      =========================================
      */

      function addBusinessDays(
        startDate,
        numberOfDays
      ) {

        const result =
          new Date(startDate);


        let addedDays = 0;


        while (
          addedDays < numberOfDays
        ) {

          result.setDate(
            result.getDate() + 1
          );


          if (
            isBusinessDay(result)
          ) {

            addedDays++;

          }

        }


        return result;

      }


      /*
      =========================================
      MONTH NAMES
      =========================================

      JS automatically correct month
      calculate karega.
      =========================================
      */

      function getMonthName(date) {

        if (
          dateFormat === 'long'
        ) {

          return date.toLocaleDateString(
            'en-US',
            {
              month: 'long'
            }
          );

        }


        if (
          dateFormat === 'short_month'
        ) {

          return date.toLocaleDateString(
            'en-US',
            {
              month: 'short'
            }
          );

        }


        return date.toLocaleDateString(
          'en-US',
          {
            month: 'long'
          }
        );

      }


      /*
      =========================================
      FORMAT RANGE
      =========================================

      Same month:
      19–21 August

      Different months:
      29 August – 2 September

      Different years:
      30 December 2026 – 5 January 2027
      =========================================
      */

      function formatDateRange(
        startDate,
        endDate
      ) {

        const startDay =
          startDate.getDate();

        const endDay =
          endDate.getDate();


        const startMonth =
          getMonthName(startDate);

        const endMonth =
          getMonthName(endDate);


        const startYear =
          startDate.getFullYear();

        const endYear =
          endDate.getFullYear();


        /*
        -----------------------------
        DIFFERENT YEARS
        -----------------------------
        */

        if (
          startYear !== endYear
        ) {

          return (
            startDay +
            ' ' +
            startMonth +
            ' ' +
            startYear +
            ' – ' +
            endDay +
            ' ' +
            endMonth +
            ' ' +
            endYear
          );

        }


        /*
        -----------------------------
        SAME YEAR + DIFFERENT MONTH
        -----------------------------
        */

        if (
          startDate.getMonth() !==
          endDate.getMonth()
        ) {

          return (
            startDay +
            ' ' +
            startMonth +
            ' – ' +
            endDay +
            ' ' +
            endMonth
          );

        }


        /*
        -----------------------------
        SAME MONTH
        -----------------------------
        */

        return (
          startDay +
          '–' +
          endDay +
          ' ' +
          endMonth
        );

      }


      /*
      =========================================
      CALCULATE DELIVERY
      =========================================
      */

      function updateDeliveryDate() {

        const today =
          getToday();


        let minDays;
        let maxDays;


        if (isUAE) {

          minDays =
            uaeMin;

          maxDays =
            uaeMax;

        }

        else {

          minDays =
            internationalMin;

          maxDays =
            internationalMax;

        }


        const startDate =
          addBusinessDays(
            today,
            minDays
          );


        const endDate =
          addBusinessDays(
            today,
            maxDays
          );


        const range =
          formatDateRange(
            startDate,
            endDate
          );


        const output =
          block.querySelector(
            '[data-delivery-date]'
          );


        if (output) {

          output.textContent =
            range;

        }

      }


      /*
      =========================================
      RUN
      =========================================
      */

      updateDeliveryDate();

    })();
  </script>


