      }


      .conditional-icon-text--{{ block.id }}
      .conditional-icon-text__text p {

        margin: 0;

      }


      /* MOBILE */

      @media screen and (max-width: 749px) {

        .conditional-icon-text--{{ block.id }} {

          padding:
            {{ block.settings.padding_vertical_mobile }}px
            {{ block.settings.padding_horizontal_mobile }}px;

        }


        .conditional-icon-text--{{ block.id }}
        .conditional-icon-text__icon {

          width:
            {{ block.settings.icon_size_mobile }}px;

          min-width:
            {{ block.settings.icon_size_mobile }}px;

          height:
            {{ block.settings.icon_size_mobile }}px;

        }


        .conditional-icon-text--{{ block.id }}
        .conditional-icon-text__text {

          font-size:
