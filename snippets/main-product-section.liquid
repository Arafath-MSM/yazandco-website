                        {% endif %}
                        {% if block.settings.text_2 != blank %}
                          <div class="product-popup-modal__text product-popup-modal__text_2">
                            {{ block.settings.text_2 }}
                          </div>
                        {% endif %}
                        {% if block.settings.heading != blank %}
                          <h3 class="product-popup-modal__title">
                            {{ block.settings.heading }}
                          </h3>
                        {% endif %}
                        {% if block.settings.img_text != blank %}
                          <div class="product-popup-modal__text_3">
                            {{ block.settings.img_text }}
                          </div>
                        {% endif %}
                        <div>
                          {%- if block.settings.pupup_img != blank -%}
                            {{
                              block.settings.pupup_img
                              | image_url: width: 1200
                              | image_tag: loading: 'lazy', class: 'header__heading-logo', widths: '553, 895, 1200'
                            }}
                          {%- endif -%}
                          {%- if block.settings.pupup_img_2 != blank -%}
                            {{
                              block.settings.pupup_img_2
                              | image_url: width: 1200
                              | image_tag:
                                loading: 'lazy',
                                class: 'header__heading-logo header__heading-logo--overlay',
                                widths: '553, 895, 1200'
                            }}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </modal-dialog>
                </div> {% endcomment %}


                {%- when 'product_promise' -%}
  <div
    class="product-promise product-promise--{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h2 class="product-promise__heading">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="product-promise__items">
      {% for i in (1..4) %}
        {% liquid
          assign show_key = 'show_item_' | append: i
          assign icon_key = 'icon_' | append: i
          assign custom_icon_key = 'custom_icon_' | append: i
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign link_label_key = 'link_label_' | append: i
          assign link_key = 'link_' | append: i

          assign show_item = block.settings[show_key]
          assign icon_type = block.settings[icon_key]
          assign custom_icon = block.settings[custom_icon_key]
          assign item_title = block.settings[title_key]
          assign item_text = block.settings[text_key]
          assign link_label = block.settings[link_label_key]
          assign item_link = block.settings[link_key]
        %}

        {% if show_item %}
          <div class="product-promise__item">
            <div class="product-promise__icon" aria-hidden="true">
              {% if custom_icon != blank %}
                {{
                  custom_icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    widths: '40, 60, 80, 120',
                    class: 'product-promise__custom-icon'
                }}
              {% else %}
                {% case icon_type %}
                  {% when 'shield' %}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 3L26 7V14C26 21 21.8 26.5 16 29C10.2 26.5 6 21 6 14V7L16 3Z" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M12 15.5L15 18.5L20.5 12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  {% when 'star' %}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 3.5L19.5 11.2L28 12.2L21.7 18L23.4 26.5L16 22.2L8.6 26.5L10.3 18L4 12.2L12.5 11.2L16 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                    </svg>

                  {% when 'truck' %}
                    <svg viewBox="0 0 36 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 7H21V23H3V7Z" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M21 13H28L33 18V23H21V13Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      <circle cx="9" cy="24" r="3" stroke="currentColor" stroke-width="1.7"/>
                      <circle cx="27" cy="24" r="3" stroke="currentColor" stroke-width="1.7"/>
                    </svg>

                  {% when 'store' %}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 28V12L16 4L27 12V28" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M11 28V20H21V28" stroke="currentColor" stroke-width="1.7"/>
                    </svg>

                  {% when 'heart' %}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 27S5 20.5 5 11.5C5 7.5 8 5 11.2 5C13.5 5 15.1 6.3 16 7.8C16.9 6.3 18.5 5 20.8 5C24 5 27 7.5 27 11.5C27 20.5 16 27 16 27Z" stroke="currentColor" stroke-width="1.7"/>
                    </svg>

                  {% when 'check' %}
                    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M10.5 16L14 19.5L21.5 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            <div class="product-promise__content">
              {% if item_title != blank %}
                <h3 class="product-promise__title">
                  {{ item_title }}
                </h3>
              {% endif %}

              {% if item_text != blank %}
                <div class="product-promise__text rte">
                  {{ item_text }}
                </div>
              {% endif %}

              {% if link_label != blank and item_link != blank %}
                <a
                  href="{{ item_link }}"
                  class="product-promise__link"
                >
                  {{ link_label }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    .product-promise--{{ block.id }} {
      --promise-heading-color: {{ block.settings.heading_color }};
      --promise-title-color: {{ block.settings.title_color }};
      --promise-text-color: {{ block.settings.text_color }};
      --promise-icon-color: {{ block.settings.icon_color }};
      --promise-link-color: {{ block.settings.link_color }};
      --promise-heading-size: {{ block.settings.heading_size }}px;
      --promise-title-size: {{ block.settings.title_size }}px;
      --promise-text-size: {{ block.settings.text_size }}px;
      --promise-icon-size: {{ block.settings.icon_size }}px;
      --promise-gap: {{ block.settings.item_gap }}px;
      --promise-icon-gap: {{ block.settings.icon_gap }}px;

      width: 100%;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }

    .product-promise--{{ block.id }} .product-promise__heading {
      margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
      color: var(--promise-heading-color);
      font-size: var(--promise-heading-size);
      font-weight: {{ block.settings.heading_weight }};
      line-height: {{ block.settings.heading_line_height }};
      letter-spacing: {{ block.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    }

    .product-promise--{{ block.id }} .product-promise__items {
      display: flex;
      flex-direction: column;
      gap: var(--promise-gap);
    }
h2.product-promise__heading {
    font-family: 'Red Rose' !IMPORTANT;
}
    .product-promise--{{ block.id }} .product-promise__item {
      display: grid;
      grid-template-columns: var(--promise-icon-size) minmax(0, 1fr);
      column-gap: var(--promise-icon-gap);
      align-items: start;
    }

    .product-promise--{{ block.id }} .product-promise__icon {
      width: var(--promise-icon-size);
      height: var(--promise-icon-size);
      color: var(--promise-icon-color);
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }

    .product-promise--{{ block.id }} .product-promise__icon svg,
    .product-promise--{{ block.id }} .product-promise__custom-icon {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
    }

    .product-promise--{{ block.id }} .product-promise__content {
      min-width: 0;
    }

    .product-promise--{{ block.id }} .product-promise__title {
      margin: 0 0 {{ block.settings.title_bottom_spacing }}px;
      padding: 0;
      color: var(--promise-title-color);
      font-size: var(--promise-title-size);
      font-weight: {{ block.settings.title_weight }};
      line-height: {{ block.settings.title_line_height }};
      letter-spacing: {{ block.settings.title_letter_spacing | divided_by: 100.0 }}em;
    }

    .product-promise--{{ block.id }} .product-promise__text {
      margin: 0;
      color: var(--promise-text-color);
      font-size: var(--promise-text-size);
      line-height: {{ block.settings.text_line_height }};
    }

    .product-promise--{{ block.id }} .product-promise__text p {
      margin: 0;
    }

    .product-promise--{{ block.id }} .product-promise__link {
      display: inline-block;
      margin-top: {{ block.settings.link_top_spacing }}px;
      color: var(--promise-link-color);
      font-size: var(--promise-text-size);
      line-height: 1.4;
      text-decoration: none;
      border-bottom:
        {{ block.settings.link_border_width }}px
        {{ block.settings.link_border_style }}
        currentColor;
    }

    @media screen and (max-width: 749px) {
      .product-promise--{{ block.id }} {
        --promise-heading-size: {{ block.settings.heading_size_mobile }}px;
        --promise-title-size: {{ block.settings.title_size_mobile }}px;
        --promise-text-size: {{ block.settings.text_size_mobile }}px;
        --promise-icon-size: {{ block.settings.icon_size_mobile }}px;
        --promise-gap: {{ block.settings.item_gap_mobile }}px;
        --promise-icon-gap: {{ block.settings.icon_gap_mobile }}px;
      }
    }
  </style>


  {%- when 'conditional_icon_text' -%}

  {%- assign lab_grown = product.metafields.custom.lab_grown.value -%}

  {% if lab_grown == true %}

