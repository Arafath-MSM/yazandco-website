{%- endstyle -%}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

<div class="fct color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding{% unless section.settings.show_arrows_desktop %} fct--hide-arrows-desktop{% endunless %}{% unless section.settings.show_arrows_mobile %} fct--hide-arrows-mobile{% endunless %}">
  <div class="fct__container page-width">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper title--section-mt-none">
        <h2 class="title title--primary fct__heading fct__heading--{{ section.settings.heading_alignment }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="fct__tabs fct__tabs--{{ section.settings.tabs_alignment }}"
        role="tablist"
        aria-label="{{ section.settings.heading | default: 'Featured Collection Tabs' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- assign block_collection = block.settings.collection -%}
          <button
            type="button"
            id="fct-tab-{{ section.id }}-{{ forloop.index0 }}"
            class="fct__tab{% if forloop.first %} fct__tab--active{% endif %}"
            role="tab"
            aria-selected="{{ forloop.first }}"
            aria-controls="fct-panel-{{ section.id }}-{{ forloop.index0 }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-fct-tab
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_label | default: block_collection.title | default: 'Collection' | escape }}
          </button>
        {%- endfor -%}
      </div>

      <div class="fct__panels">
        {%- for block in section.blocks -%}
          {%- assign block_collection = block.settings.collection -%}
          <div
            id="fct-panel-{{ section.id }}-{{ forloop.index0 }}"
            class="fct__panel{% if forloop.first %} fct__panel--active{% endif %}"
            role="tabpanel"
            aria-labelledby="fct-tab-{{ section.id }}-{{ forloop.index0 }}"
            data-fct-panel
            data-index="{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if block_collection != blank and block_collection.products.size > 0 -%}
              <div class="fct__slider-wrapper">
                <div class="fct__slider swiper" data-fct-swiper>
                  <div class="fct__slider-track swiper-wrapper">
                    {%- for product in block_collection.products limit: section.settings.products_to_show -%}
                      <div class="fct__slide swiper-slide">
                        {%- render 'product-card',
                          product_card_product: product,
                          media_size: section.settings.image_ratio,
                          media_fit: section.settings.image_fit,
                          show_vendor: section.settings.show_vendor,
                          section_id: section.id,
                          add_id: forloop.index
                        -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>

                {%- if section.settings.show_arrows_desktop or section.settings.show_arrows_mobile -%}
                  <button
                    type="button"
                    class="fct__nav fct__nav--prev"
                    aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous slide' }}"
                    data-fct-prev
                  >
                    {%- render 'icon-caret-left' -%}
                  </button>
                  <button
                    type="button"
                    class="fct__nav fct__nav--next"
                    aria-label="{{ 'general.slider.next_slide' | t | default: 'Next slide' }}"
                    data-fct-next
                  >
                    {%- render 'icon-caret-right' -%}
                  </button>
                {%- endif -%}
              </div>
            {%- else -%}
              <p class="fct__empty">{{ 'sections.collection_template.empty' | t | default: 'No products found in this collection.' }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="fct__empty">{{ 'sections.featured_collection.no_collections' | t | default: 'Add a collection block to get started.' }}</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    'use strict';

    function initFeaturedCollectionTabs(root) {
      if (root.dataset.fctInitialized) return;
      root.dataset.fctInitialized = 'true';

      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-fct-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-fct-panel]'));
      var sliders = {};

      function initSlider(panel) {
        var index = panel.dataset.index;
        if (sliders[index] || typeof Swiper === 'undefined') return;

        var sliderEl = panel.querySelector('[data-fct-swiper]');
        if (!sliderEl) return;

        var prevEl = panel.querySelector('[data-fct-prev]');
        var nextEl = panel.querySelector('[data-fct-next]');

        sliders[index] = new Swiper(sliderEl, {
          slidesPerView: 'auto',
          spaceBetween: 0,
          watchOverflow: true,
          grabCursor: true,
          a11y: {
            enabled: true
          },
          keyboard: {
            enabled: true,
            onlyInViewport: true
          },
          navigation: prevEl && nextEl ? {
            prevEl: prevEl,
            nextEl: nextEl,
            disabledClass: 'swiper-button-disabled',
            lockClass: 'swiper-button-lock'
          } : false
        });
      }

      function activateTab(index) {
        tabs.forEach(function (tab) {
          var isActive = tab.dataset.index === index;
          tab.classList.toggle('fct__tab--active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        panels.forEach(function (panel) {
          var isActive = panel.dataset.index === index;
          panel.classList.toggle('fct__panel--active', isActive);
          if (isActive) {
            panel.removeAttribute('hidden');
            initSlider(panel);
            if (sliders[index]) sliders[index].update();
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          activateTab(tab.dataset.index);
        });

        tab.addEventListener('keydown', function (event) {
          var targetIndex = null;
          if (event.key === 'ArrowRight') {
            targetIndex = (i + 1) % tabs.length;
          } else if (event.key === 'ArrowLeft') {
            targetIndex = (i - 1 + tabs.length) % tabs.length;
          } else if (event.key === 'Home') {
            targetIndex = 0;
          } else if (event.key === 'End') {
            targetIndex = tabs.length - 1;
          }

          if (targetIndex !== null) {
            event.preventDefault();
            var targetTab = tabs[targetIndex];
            targetTab.focus();
            activateTab(targetTab.dataset.index);
          }
        });
      });

      var activePanel = root.querySelector('.fct__panel--active');
      if (activePanel) initSlider(activePanel);

      if (Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', function (event) {
          if (event.target.contains(root)) {
            root.dataset.fctInitialized = '';
            sliders = {};
            initFeaturedCollectionTabs(root);
          }
        });
      }
    }

    function initAll() {
      document.querySelectorAll('.fct').forEach(initFeaturedCollectionTabs);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
</script>

