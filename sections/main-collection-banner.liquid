{% comment %} {% comment %} {% comment %} {{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}  

<div class="collection-hero">
  <div class="collection-hero__wrapper ">
    <div class="collection-hero__inner">
      {%- liquid
        assign collection_image = collection.image

        if collection_image == blank and collection.id == blank
          assign collection_image = section.settings.image_products
        endif
      -%}
      {%- if section.settings.show_collection_image and collection_image -%}
        {% capture sizes %}
          (min-width: 1100px) calc(100vw + 200px), 
          calc(100vw + 60px)
        {% endcapture %}
        <div class="collection-hero__image-wrapper">
          <div class="collection-hero__image-container media">
            {{
              collection_image
              | image_url: width: collection_image.width
              | image_tag:
                loading: 'lazy',
                widths: '360, 535, 720, 940, 1100, 1200, 1440, 1600, 1800, 2000, 2100, 2200, 2880, 3200, 3600, 4000, 4200, 4400',
                sizes: sizes
            }}
          </div>
        </div>
      {%- endif -%}
      <div class="container">
        <div class="collection-hero__text-wrapper">
          <h1 class="collection-hero__title title--page h2">
            <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
            {{- collection.title | escape -}}
          </h1>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "collection-banner-section spaced-section--full-width section-template--overlay",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "image_picker",
      "id": "image_products",
      "label": "t:sections.main-collection-banner.settings.image_products.label",
      "info": "t:sections.main-collection-banner.settings.image_products.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ]
}
{% endschema %} {% endcomment %}



{% comment %}
  AJAX Collection Hero
  - Title + description layout
  - Collection tabs via blocks
  - AJAX collection switching
  - Mobile horizontal scroll
  - Fully customizable through schema
{% endcomment %}

{%- liquid
  assign description_text = collection.description

  if section.settings.description_source == 'custom'
    assign description_text = section.settings.custom_description
  endif
-%}

<section
  id="AjaxCollectionHero-{{ section.id }}"
  class="ajax-collection-hero{% if section.settings.background_image != blank %} has-background-image{% endif %}"
  data-section-id="{{ section.id }}"
  data-update-url="{{ section.settings.update_url }}"
  style="
    --hero-bg: {{ section.settings.background_color }};
    {%- if section.settings.background_image != blank -%}
      --hero-bg-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
    {%- endif -%}
    --hero-bg-position: {{ section.settings.background_image_position }};
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-text: {{ section.settings.text_color }};
    --hero-border: {{ section.settings.divider_color }};
    --tab-text: {{ section.settings.tab_text_color }};
    --tab-border: {{ section.settings.tab_border_color }};
    --tab-bg: {{ section.settings.tab_background_color }};
    --tab-active-text: {{ section.settings.tab_active_text_color }};
    --tab-active-bg: {{ section.settings.tab_active_background_color }};
    --tab-active-border: {{ section.settings.tab_active_border_color }};

    --hero-max-width: {{ section.settings.max_width }}px;
    --hero-desktop-gap: {{ section.settings.desktop_column_gap }}px;

    --hero-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --hero-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --hero-padding-x-desktop: {{ section.settings.padding_horizontal_desktop }}px;

    --hero-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hero-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --hero-padding-x-mobile: {{ section.settings.padding_horizontal_mobile }}px;

    --title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --title-line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};

    --desc-size-desktop: {{ section.settings.description_size_desktop }}px;
    --desc-size-mobile: {{ section.settings.description_size_mobile }}px;
    --desc-line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};

    --tabs-margin-top-desktop: {{ section.settings.tabs_margin_top_desktop }}px;
    --tabs-margin-top-mobile: {{ section.settings.tabs_margin_top_mobile }}px;
    --tabs-gap: {{ section.settings.tabs_gap }}px;

    --tab-padding-y: {{ section.settings.tab_padding_vertical }}px;
    --tab-padding-x: {{ section.settings.tab_padding_horizontal }}px;
    --tab-font-size: {{ section.settings.tab_font_size }}px;
    --tab-border-width: {{ section.settings.tab_border_width }}px;
    --tab-radius: {{ section.settings.tab_border_radius }}px;
  "
>
  <div class="ajax-collection-hero__container">

    <div class="ajax-collection-hero__top">
      <div class="ajax-collection-hero__heading">
        <h1 class="ajax-collection-hero__title">
          {{ collection.title | escape }}
        </h1>
      </div>

      {%- if section.settings.show_description and description_text != blank -%}
        <div class="ajax-collection-hero__description">
          <div
            class="ajax-collection-hero__description-content rte{% if section.settings.enable_read_more %} is-collapsed{% endif %}"
            data-description
          >
            {{ description_text }}
          </div>

          {%- if section.settings.enable_read_more -%}
            <button
              type="button"
              class="ajax-collection-hero__read-more"
              data-read-more
              aria-expanded="false"
            >
              <span data-read-more-text>
                {{ section.settings.read_more_label | escape }}
              </span>

              <span
                data-read-less-text
                hidden
              >
                {{ section.settings.read_less_label | escape }}
              </span>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ajax-collection-hero__tabs-wrap">
        <div
          class="ajax-collection-hero__tabs"
          role="navigation"
          aria-label="{{ section.settings.tabs_aria_label | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign tab_collection = block.settings.collection
              assign tab_label = block.settings.custom_label

              if tab_label == blank and tab_collection != blank
                assign tab_label = tab_collection.title
              endif

              assign tab_url = block.settings.custom_url

              if tab_url == blank and tab_collection != blank
                assign tab_url = tab_collection.url
              endif

              assign is_active = false

              if tab_collection != blank and tab_collection.handle == collection.handle
                assign is_active = true
              endif
            -%}

            {%- if tab_url != blank and tab_label != blank -%}
              <a
                href="{{ tab_url }}"
                class="ajax-collection-hero__tab{% if is_active %} is-active{% endif %}"
                data-collection-tab
                {% if tab_collection != blank %}
                  data-collection-handle="{{ tab_collection.handle }}"
                {% endif %}
                {% if is_active %}
                  aria-current="page"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {{ tab_label | escape }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>

  {%- if section.settings.show_loading_overlay -%}
    <div
      class="ajax-collection-hero__loader"
      data-collection-loader
      aria-hidden="true"
    >
      <span class="ajax-collection-hero__spinner"></span>
    </div>
  {%- endif -%}
</section>


<style>
  #AjaxCollectionHero-{{ section.id }} {
    position: relative;
    width: 100%;
    background: var(--hero-bg);
    background-image: var(--hero-bg-image, none);
    background-size: cover;
    background-position: var(--hero-bg-position);
    background-repeat: no-repeat;
    color: var(--hero-text);
    border-bottom: 1px solid var(--hero-border);
  }

  #AjaxCollectionHero-{{ section.id }}.has-background-image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--hero-overlay-color);
    opacity: var(--hero-overlay-opacity);
    pointer-events: none;
  }

  #AjaxCollectionHero-{{ section.id }}.has-background-image .ajax-collection-hero__container {
    position: relative;
    z-index: 1;
  }

  #AjaxCollectionHero-{{ section.id }} *,
  #AjaxCollectionHero-{{ section.id }} *::before,
  #AjaxCollectionHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__container {
    width: 100%;
    max-width: var(--hero-max-width);
    margin: 0 auto;
    padding:
      var(--hero-padding-top-desktop)
      var(--hero-padding-x-desktop)
      var(--hero-padding-bottom-desktop);
  }

  /* =========================
     TOP DESKTOP LAYOUT
  ========================== */

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__top {
    display: grid;
    grid-template-columns:
      minmax(240px, {{ section.settings.title_column_width }}%)
      minmax(0, 1fr);
    column-gap: var(--hero-desktop-gap);
    align-items: start;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__heading,
  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description {
    min-width: 0;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__title {
    margin: 0;
    padding: 0;
    color: var(--hero-text);
    font-size: var(--title-size-desktop);
    line-height: var(--title-line-height);
    font-weight: {{ section.settings.title_font_weight }};
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}px;
    text-transform: {{ section.settings.title_transform }};
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description {
    color: var(--hero-text);
    font-size: var(--desc-size-desktop);
    line-height: var(--desc-line-height);
    font-weight: {{ section.settings.description_font_weight }};
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content {
    position: relative;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content > *:first-child {
    margin-top: 0;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content > *:last-child {
    margin-bottom: 0;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content p {
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content.is-collapsed {
    max-height: {{ section.settings.description_collapsed_height_desktop }}px;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content.is-expanded {
    max-height: 2000px;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__read-more {
    appearance: none;
    -webkit-appearance: none;
    display: inline-block;
    margin: {{ section.settings.read_more_margin_top }}px 0 0;
    padding: 0;
    border: 0;
    border-bottom: {{ section.settings.read_more_underline_width }}px solid currentColor;
    border-radius: 0;
    background: transparent;
    color: var(--hero-text);
    font: inherit;
    font-size: {{ section.settings.read_more_font_size }}px;
    line-height: 1.3;
    cursor: pointer;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__read-more:hover {
    opacity: 0.65;
  }

  /* =========================
     TABS
  ========================== */

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tabs-wrap {
    margin-top: var(--tabs-margin-top-desktop);
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tabs-gap);
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: {{ section.settings.tab_min_height }}px;
    padding: var(--tab-padding-y) var(--tab-padding-x);

    border:
      var(--tab-border-width)
      solid
      var(--tab-border);

    border-radius: var(--tab-radius);

    background: var(--tab-bg);
    color: var(--tab-text);

    font-size: var(--tab-font-size);
    line-height: 1.2;
    font-weight: {{ section.settings.tab_font_weight }};
    letter-spacing: {{ section.settings.tab_letter_spacing | divided_by: 100.0 }}px;
    text-transform: {{ section.settings.tab_text_transform }};
    text-decoration: none;
    white-space: nowrap;

    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tab:hover {
    opacity: 0.72;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tab.is-active {
    background: var(--tab-active-bg);
    color: var(--tab-active-text);
    border-color: var(--tab-active-border);
  }

  /* =========================
     AJAX LOADER
  ========================== */

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    background: rgba(255,255,255,0.25);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  #AjaxCollectionHero-{{ section.id }}.is-loading .ajax-collection-hero__loader {
    opacity: 1;
    visibility: visible;
  }

  #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__spinner {
    width: 36px;
    height: 36px;
    border: 2px solid rgba(0,0,0,0.15);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: ajaxCollectionSpinner 0.7s linear infinite;
  }

  @keyframes ajaxCollectionSpinner {
    to {
      transform: rotate(360deg);
    }
  }

  /* =========================
     MOBILE
  ========================== */

  @media screen and (max-width: 749px) {
    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__container {
      padding:
        var(--hero-padding-top-mobile)
        var(--hero-padding-x-mobile)
        var(--hero-padding-bottom-mobile);
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__top {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.mobile_content_gap }}px;
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__title {
      font-size: var(--title-size-mobile);
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description {
      width: 100%;
      font-size: var(--desc-size-mobile);
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__description-content.is-collapsed {
      max-height: {{ section.settings.description_collapsed_height_mobile }}px;
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tabs-wrap {
      width: calc(100% + var(--hero-padding-x-mobile));
      margin-top: var(--tabs-margin-top-mobile);
      overflow: hidden;
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tabs {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--tabs-gap);
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      padding-right: var(--hero-padding-x-mobile);
      padding-bottom: 4px;

      scroll-behavior: smooth;
      scroll-snap-type: x proximity;
      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tabs::-webkit-scrollbar {
      display: none;
    }

    #AjaxCollectionHero-{{ section.id }} .ajax-collection-hero__tab {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
  }
</style>


<script>
  (() => {
    const sectionId = 'AjaxCollectionHero-{{ section.id }}';

    function initAjaxCollectionHero() {
      const section = document.getElementById(sectionId);

      if (!section || section.dataset.initialized === 'true') return;

      section.dataset.initialized = 'true';

      const tabs = section.querySelectorAll('[data-collection-tab]');
      const readMoreButton = section.querySelector('[data-read-more]');

      /* ============================
         READ MORE
      ============================ */

      if (readMoreButton) {
        readMoreButton.addEventListener('click', function () {
          const description = section.querySelector('[data-description]');
          const moreText = this.querySelector('[data-read-more-text]');
          const lessText = this.querySelector('[data-read-less-text]');

          if (!description) return;

          const expanded = this.getAttribute('aria-expanded') === 'true';

          if (expanded) {
            description.classList.remove('is-expanded');
            description.classList.add('is-collapsed');

            this.setAttribute('aria-expanded', 'false');

            if (moreText) moreText.hidden = false;
            if (lessText) lessText.hidden = true;
          } else {
            description.classList.remove('is-collapsed');
            description.classList.add('is-expanded');

            this.setAttribute('aria-expanded', 'true');

            if (moreText) moreText.hidden = true;
            if (lessText) lessText.hidden = false;
          }
        });
      }

      /* ============================
         COLLECTION AJAX
      ============================ */

      tabs.forEach((tab) => {
        tab.addEventListener('click', async function (event) {
          if (
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          event.preventDefault();

          const url = this.href;

          if (!url || this.classList.contains('is-active')) {
            scrollActiveTab(this);
            return;
          }

          await loadCollection(url, this);
        });
      });

      /* Mobile: active tab visible automatically */
      const activeTab = section.querySelector(
        '[data-collection-tab].is-active'
      );

      if (activeTab) {
        setTimeout(() => {
          scrollActiveTab(activeTab, false);
        }, 150);
      }
    }


    async function loadCollection(url, clickedTab, pushState = true) {
      const section = document.getElementById(sectionId);

      if (!section || section.classList.contains('is-loading')) return;

      section.classList.add('is-loading');
      section.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        if (!response.ok) {
          throw new Error('Collection AJAX request failed');
        }

        const html = await response.text();

        const parser = new DOMParser();
        const newDocument = parser.parseFromString(html, 'text/html');

        /*
          Product grid selectors.

          #ProductGridContainer = Dawn / many Shopify themes
          .product-grid-container = common Shopify structure
          [data-product-grid] = custom themes
          .collection-product-list = some premium themes
        */

        const currentGrid =
          document.querySelector('#ProductGridContainer') ||
          document.querySelector('[data-product-grid]') ||
          document.querySelector('.product-grid-container') ||
          document.querySelector('.collection-product-list');

        const newGrid =
          newDocument.querySelector('#ProductGridContainer') ||
          newDocument.querySelector('[data-product-grid]') ||
          newDocument.querySelector('.product-grid-container') ||
          newDocument.querySelector('.collection-product-list');

        if (!currentGrid || !newGrid) {
          /*
            Fallback:
            Agar theme ka product grid selector different ho,
            user ko broken page dikhane ke bajaye normal URL open hoga.
          */
          window.location.href = url;
          return;
        }

        /* Replace products / filters / pagination */
        currentGrid.innerHTML = newGrid.innerHTML;

        /* Update collection title */
        const currentTitle = section.querySelector(
          '.ajax-collection-hero__title'
        );

        const newTitle = newDocument.querySelector(
          '.ajax-collection-hero__title'
        );

        if (currentTitle && newTitle) {
          currentTitle.innerHTML = newTitle.innerHTML;
        }

        /* Update description */
        const currentDescription = section.querySelector(
          '[data-description]'
        );

        const newDescription = newDocument.querySelector(
          '[data-description]'
        );

        if (currentDescription && newDescription) {
          currentDescription.innerHTML = newDescription.innerHTML;

          currentDescription.classList.remove('is-expanded');

          {% if section.settings.enable_read_more %}
            currentDescription.classList.add('is-collapsed');
          {% else %}
            currentDescription.classList.remove('is-collapsed');
          {% endif %}
        }

        /* Reset read more button */
        const readMore = section.querySelector('[data-read-more]');

        if (readMore) {
          const moreText = readMore.querySelector(
            '[data-read-more-text]'
          );

          const lessText = readMore.querySelector(
            '[data-read-less-text]'
          );

          readMore.setAttribute('aria-expanded', 'false');

          if (moreText) moreText.hidden = false;
          if (lessText) lessText.hidden = true;
        }

        /* Active tab */
        section
          .querySelectorAll('[data-collection-tab]')
          .forEach((tab) => {
            tab.classList.remove('is-active');
            tab.removeAttribute('aria-current');
          });

        if (clickedTab) {
          clickedTab.classList.add('is-active');
          clickedTab.setAttribute('aria-current', 'page');

          scrollActiveTab(clickedTab);
        }

        /* Update URL without refresh */
        if (
          pushState &&
          section.dataset.updateUrl !== 'false'
        ) {
          window.history.pushState(
            {
              ajaxCollection: true,
              url: url
            },
            '',
            url
          );
        }

        /*
          Re-run common Shopify events.
          Useful for product cards, quick add, swatches etc.
        */
        document.dispatchEvent(
          new CustomEvent('collection:ajax:loaded', {
            detail: {
              url: url,
              container: currentGrid
            }
          })
        );

        window.dispatchEvent(new Event('resize'));

        {% if section.settings.scroll_to_products %}
          const productTop =
            currentGrid.getBoundingClientRect().top +
            window.pageYOffset -
            {{ section.settings.scroll_offset }};

          window.scrollTo({
            top: productTop,
            behavior: 'smooth'
          });
        {% endif %}
      } catch (error) {
        console.error(error);

        /*
          Safe fallback if fetch fails.
        */
        window.location.href = url;
      } finally {
        const currentSection =
          document.getElementById(sectionId);

        if (currentSection) {
          currentSection.classList.remove('is-loading');
          currentSection.removeAttribute('aria-busy');
        }
      }
    }


    function scrollActiveTab(tab, smooth = true) {
      if (!tab) return;

      const tabsContainer = tab.closest(
        '.ajax-collection-hero__tabs'
      );

      if (!tabsContainer) return;

      if (window.innerWidth <= 749) {
        tab.scrollIntoView({
          behavior: smooth ? 'smooth' : 'auto',
          inline: 'center',
          block: 'nearest'
        });
      }
    }


    /* Browser back / forward */
    window.addEventListener('popstate', function () {
      const section =
        document.getElementById(sectionId);

      if (!section) return;

      const currentPath =
        window.location.pathname.replace(/\/$/, '');

      const matchingTab = Array.from(
        section.querySelectorAll('[data-collection-tab]')
      ).find((tab) => {
        try {
          return (
            new URL(tab.href).pathname.replace(/\/$/, '') ===
            currentPath
          );
        } catch (e) {
          return false;
        }
      });

      if (matchingTab) {
        loadCollection(
          window.location.href,
          matchingTab,
          false
        );
      } else {
        window.location.reload();
      }
    });


    /* Initial load */
    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        initAjaxCollectionHero
      );
    } else {
      initAjaxCollectionHero();
    }

    /* Shopify Theme Editor */
    document.addEventListener(
      'shopify:section:load',
      function (event) {
        if (
          event.target &&
          event.target.querySelector &&
          (
            event.target.id === sectionId ||
            event.target.querySelector(
              '#' + sectionId
            )
          )
        ) {
          const section =
            document.getElementById(sectionId);

          if (section) {
            delete section.dataset.initialized;
          }

          initAjaxCollectionHero();
        }
      }
    );
  })();
</script>


