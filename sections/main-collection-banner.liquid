{%- liquid
  assign hero_background_image = section.settings.background_image
  assign dar_banner_url = blank
  if collection.handle == 'dar-collection'
    assign hero_background_image = section.settings.dar_background_image
    if hero_background_image == blank
      assign dar_banner_url = 'https://cdn.shopify.com/s/files/1/0662/1095/5470/files/WhatsApp_Image_2026-11-16_at_16.44.34.jpg?v=1794833440'
    endif
  endif
  assign has_hero_image = false
  if hero_background_image != blank or dar_banner_url != blank
    assign has_hero_image = true
  endif
  assign description_text = collection.description

  if section.settings.description_source == 'custom'
    assign description_text = section.settings.custom_description
  elsif description_text == blank
    assign description_text = section.settings.custom_description
  endif
-%}

