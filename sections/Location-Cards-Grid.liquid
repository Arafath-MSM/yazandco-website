{%- style -%}
  .loc-sec-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_left_mobile }}px;
    padding-right: {{ section.settings.padding_right_mobile }}px;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      padding-left: {{ section.settings.padding_left_desktop }}px;
      padding-right: {{ section.settings.padding_right_desktop }}px;
    }
  }

  .loc-sec-{{ section.id }} .loc-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  /* Main Title Styling */
  .loc-sec-{{ section.id }} .loc-main-title {
    text-align: {{ section.settings.main_title_align_mobile }};
    font-size: {{ section.settings.main_title_size_mobile }}px;
    font-weight: {{ section.settings.main_title_weight }};
    color: {{ section.settings.main_title_color }};
    line-height: {{ section.settings.main_title_lh }};
    letter-spacing: {{ section.settings.main_title_ls }}px;
    text-transform: {{ section.settings.main_title_transform }};
    margin: 0 0 {{ section.settings.main_title_mb_mobile }}px 0;
  }

  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} .loc-main-title {
      text-align: {{ section.settings.main_title_align_desktop }};
      font-size: {{ section.settings.main_title_size_desktop }}px;
      margin-bottom: {{ section.settings.main_title_mb_desktop }}px;
    }
  }

  /* MOBILE SCROLL TRACK / GRID */
  .loc-sec-{{ section.id }} .loc-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: {{ section.settings.gap_mobile }}px;
    padding-bottom: {{ section.settings.scroll_padding_bottom }}px;
    -webkit-overflow-scrolling: touch;
    {% if section.settings.hide_scrollbar_mobile %}
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none;  /* IE/Edge */
    {% endif %}
  }

  {% if section.settings.hide_scrollbar_mobile %}
    .loc-sec-{{ section.id }} .loc-track::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }
  {% endif %}

  /* MOBILE CARD WIDTH */
  .loc-sec-{{ section.id }} .loc-card {
    flex: 0 0 {{ section.settings.mobile_card_width }}%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background-color: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius_mobile }}px;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    box-sizing: border-box;
  }

  /* DESKTOP GRID CONVERSION */
  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} .loc-track {
      display: grid;
      grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
      gap: {{ section.settings.gap_desktop }}px;
      overflow-x: visible;
      padding-bottom: 0;
    }

    .loc-sec-{{ section.id }} .loc-card {
      flex: initial;
      border-radius: {{ section.settings.card_radius_desktop }}px;
    }
  }

  /* Image Wrap */
  .loc-sec-{{ section.id }} .loc-image-wrap {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio_mobile }};
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} .loc-image-wrap {
      aspect-ratio: {{ section.settings.image_aspect_ratio_desktop }};
    }
  }

  .loc-sec-{{ section.id }} .loc-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
    display: block;
    transition: transform 0.4s ease;
  }

  .loc-sec-{{ section.id }} .loc-card:hover .loc-img {
    transform: scale({{ section.settings.hover_scale }});
  }

  /* Content Padding & Typography */
  .loc-sec-{{ section.id }} .loc-content {
    padding-top: {{ section.settings.card_pt_mobile }}px;
    padding-bottom: {{ section.settings.card_pb_mobile }}px;
    padding-left: {{ section.settings.card_pl_mobile }}px;
    padding-right: {{ section.settings.card_pr_mobile }}px;
    text-align: {{ section.settings.content_align_mobile }};
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} .loc-content {
      padding-top: {{ section.settings.card_pt_desktop }}px;
      padding-bottom: {{ section.settings.card_pb_desktop }}px;
      padding-left: {{ section.settings.card_pl_desktop }}px;
      padding-right: {{ section.settings.card_pr_desktop }}px;
      text-align: {{ section.settings.content_align_desktop }};
      gap: {{ section.settings.content_gap_desktop }}px;
    }
  }

  .loc-sec-{{ section.id }} .loc-title {
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    line-height: {{ section.settings.title_lh }};
    letter-spacing: {{ section.settings.title_ls }}px;
    text-transform: {{ section.settings.title_transform }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} .loc-title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }

  .loc-sec-{{ section.id }} .loc-link {
    font-size: {{ section.settings.link_size_mobile }}px;
    font-weight: {{ section.settings.link_weight }};
    color: {{ section.settings.link_color }};
    line-height: {{ section.settings.link_lh }};
    letter-spacing: {{ section.settings.link_ls }}px;
    text-transform: {{ section.settings.link_transform }};
    text-decoration: {{ section.settings.link_decoration }};
    margin: 0;
    display: inline-block;
  }

  @media screen and (min-width: 750px) {
    .loc-sec-{{ section.id }} .loc-link {
      font-size: {{ section.settings.link_size_desktop }}px;
    }
  }

  .loc-sec-{{ section.id }} .loc-card:hover .loc-link {
    color: {{ section.settings.link_hover_color }};
  }
{%- endstyle -%}

<div class="loc-sec-{{ section.id }}">
  <div class="loc-container">
    
    {%- if section.settings.main_title != blank -%}
      <h2 class="loc-main-title">{{ section.settings.main_title }}</h2>
    {%- endif -%}

    <div class="loc-track">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="loc-card" {{ block.shopify_attributes }}>
          
          <div class="loc-image-wrap">
            {%- if block.settings.image != blank -%}
              <img 
                class="loc-img" 
                src="{{ block.settings.image | image_url: width: 1000 }}" 
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="loc-img" style="background: #e2e8f0; width: 100%; height: 100%;"></div>
            {%- endif -%}
          </div>

          <div class="loc-content">
            {%- if block.settings.title != blank -%}
              <h3 class="loc-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.link_text != blank -%}
              <span class="loc-link">{{ block.settings.link_text }}</span>
            {%- endif -%}
          </div>

        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

