{%- comment -%}
  Tiffany-style FAQ Landing (tiles grid) + FAQ accordion under tiles
  - Tiles are same as your current code (unchanged)
  - Add FAQ items as blocks in Theme Editor (Question + Answer)
{%- endcomment -%}

<section id="faq-landing-{{ section.id }}" class="faq-landing">
  <div class="faq-landing__inner">
    <header class="faq-landing__header">
      <h1 class="faq-landing__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="faq-landing__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <!-- ===== Tiles grid (UNCHANGED) ===== -->
    <div class="faq-landing__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tile' -%}
          {%- assign img = block.settings.image -%}
          <a class="faq-landing__tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <div class="faq-landing__img">
              {%- if img != blank -%}
                {{ img | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <div class="faq-landing__img--placeholder"></div>
              {%- endif -%}
            </div>
            <h3 class="faq-landing__tile-title">{{ block.settings.title }}</h3>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- ===== FAQ Accordion under tiles (Tiffany style) ===== -->
    {%- assign has_faq = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        {%- assign has_faq = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_faq -%}
      <div class="faq-landing__accordionWrap">
        <h2 class="faq-landing__faqTitle">{{ section.settings.faq_heading }}</h2>

        <div class="faq-landing__accordion" data-faq-accordion>
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              {%- capture faq_answer_html -%}{{ block.settings.answer }}{%- endcapture -%}
              {%- assign faq_answer_html = faq_answer_html
                | replace: '<br />', ' '
                | replace: '<br/>', ' '
                | replace: '<br>', ' '
              -%}
              <details class="faq-acc__item" {{ block.shopify_attributes }}>
                <summary class="faq-acc__q">
                  <span class="faq-acc__qText">{{ block.settings.question }}</span>
                  <span class="faq-acc__chev" aria-hidden="true"></span>
                </summary>
                <div class="faq-acc__a">
                  {{ faq_answer_html }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ===== Tiffany FAQ Landing (scoped) ===== */
  #faq-landing-{{ section.id }}{
    padding: clamp(28px, 4vw, 64px) 0;
  }
  #faq-landing-{{ section.id }} .faq-landing__inner{
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }
  #faq-landing-{{ section.id }} .faq-landing__header{
    text-align: center;
    padding: clamp(10px, 2vw, 22px) 0 clamp(20px, 4vw, 56px);
  }
  #faq-landing-{{ section.id }} .faq-landing__title{
    font-size: clamp(34px, 4.3vw, 56px);
    line-height: 1.08;
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  #faq-landing-{{ section.id }} .faq-landing__sub{
    max-width: 720px;
    margin: 14px auto 0;
    font-size: 15px;
    line-height: 1.8;
    opacity: .9;
  }

  /* Tiles */
  #faq-landing-{{ section.id }} .faq-landing__grid{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2vw, 28px);
  }
  #faq-landing-{{ section.id }} .faq-landing__tile{
    text-decoration: none;
    color: inherit;
    display: block;
  }
  #faq-landing-{{ section.id }} .faq-landing__img{
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }
  #faq-landing-{{ section.id }} .faq-landing__img img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform .35s ease;
  }
  #faq-landing-{{ section.id }} .faq-landing__tile:hover .faq-landing__img img{
    transform: scale(1.04);
  }
  #faq-landing-{{ section.id }} .faq-landing__tile-title{
    text-align: center;
    margin: 16px 0 0;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 500;
  }
  #faq-landing-{{ section.id }} .faq-landing__img--placeholder{
    width: 100%;
    height: 100%;
  }

  /* ===== Accordion (Tiffany-like) ===== */
  #faq-landing-{{ section.id }} .faq-landing__accordionWrap{
    padding-top: clamp(40px, 5vw, 70px);
  }
  #faq-landing-{{ section.id }} .faq-landing__faqTitle{
    text-align: center;
    font-size: 34px;
    font-weight: 500;
    margin: 0 0 26px;
  }

  #faq-landing-{{ section.id }} .faq-landing__accordion{
    width: min(1100px, 100%);
    margin: 0 auto;
    border-top: 1px solid rgba(0,0,0,.14);
  }
  #faq-landing-{{ section.id }} .faq-acc__item{
    border-bottom: 1px solid rgba(0,0,0,.14);
    padding: 26px 0;
  }

  #faq-landing-{{ section.id }} .faq-acc__q{
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 22px;
    font-weight: 500;
  }
  #faq-landing-{{ section.id }} .faq-acc__q::-webkit-details-marker{ display:none; }

  #faq-landing-{{ section.id }} .faq-acc__chev{
    width: 14px;
    height: 14px;
    display: inline-block;
    border-right: 2px solid rgba(0,0,0,.75);
    border-bottom: 2px solid rgba(0,0,0,.75);
    transform: rotate(45deg);
    transition: transform .2s ease;
    margin-top: -6px;
    flex: 0 0 auto;
  }
  #faq-landing-{{ section.id }} details[open] .faq-acc__chev{
    transform: rotate(-135deg);
    margin-top: 4px;
  }

  #faq-landing-{{ section.id }} .faq-acc__a{
    padding: 18px 0 0;
    font-size: 16px;
    line-height: 1.9;
    opacity: .9;
    max-width: none;
    width: 100%;
  }
  #faq-landing-{{ section.id }} .faq-acc__a > *{
    max-width: none !important;
  }
  #faq-landing-{{ section.id }} .faq-acc__a p{ margin: 0 0 14px; }
  #faq-landing-{{ section.id }} .faq-acc__a p:last-child{ margin-bottom: 0; }
  #faq-landing-{{ section.id }} .faq-acc__a ul,
  #faq-landing-{{ section.id }} .faq-acc__a ol{
    margin: 0 0 14px 22px;
    padding: 0;
  }
  #faq-landing-{{ section.id }} .faq-acc__a li{
    margin-bottom: 8px;
  }

  @media (max-width: 1024px){
    #faq-landing-{{ section.id }} .faq-landing__grid{
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px){
    #faq-landing-{{ section.id }} .faq-landing__inner{
      width: min(1200px, calc(100% - 28px));
    }
    #faq-landing-{{ section.id }} .faq-landing__grid{
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 14px;
    }
    #faq-landing-{{ section.id }} .faq-landing__tile-title{
      font-size: 15px;
      margin-top: 12px;
    }
    #faq-landing-{{ section.id }} .faq-acc__q{
      font-size: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "FAQ Landing",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "textarea", "id": "subheading", "label": "Intro text", "default": "How can we assist you?\nThere’s no question too small or request too big for our client advisors." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading (under tiles)", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "FAQ Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Tile image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping & Returns" },
        { "type": "url", "id": "link", "label": "Link to detail page" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How can I schedule a consultation?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add your answer here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ Landing" }]
}
{% endschema %}
