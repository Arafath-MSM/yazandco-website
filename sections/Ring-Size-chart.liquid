{%- style -%}
  /* ==========================================================================
     1. MAIN SECTION & CONTAINER PADDINGS (DESKTOP & MOBILE)
     ========================================================================== */
  #size-chart-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.pad_top_m }}px;
    padding-bottom: {{ section.settings.pad_bottom_m }}px;
    padding-left: {{ section.settings.pad_left_m }}px;
    padding-right: {{ section.settings.pad_right_m }}px;
  }

  @media screen and (min-width: 769px) {
    #size-chart-{{ section.id }} {
      padding-top: {{ section.settings.pad_top_d }}px;
      padding-bottom: {{ section.settings.pad_bottom_d }}px;
      padding-left: {{ section.settings.pad_left_d }}px;
      padding-right: {{ section.settings.pad_right_d }}px;
    }
  }

  .size-chart-container-{{ section.id }} {
    max-width: {{ section.settings.container_max_w }}px;
    margin: 0 auto;
    width: 100%;
  }

  /* ==========================================================================
     2. HEADING & SUBTEXT TYPOGRAPHY
     ========================================================================== */
  .size-chart-title-{{ section.id }} {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_m }}px;
    font-weight: {{ section.settings.title_weight }};
    text-transform: {{ section.settings.title_transform }};
    letter-spacing: {{ section.settings.title_ls }}px;
    line-height: {{ section.settings.title_lh }};
    text-align: {{ section.settings.title_align_m }};
    margin: 0 0 {{ section.settings.title_mb_m }}px 0;
  }

  @media screen and (min-width: 769px) {
    .size-chart-title-{{ section.id }} {
      font-size: {{ section.settings.title_size_d }}px;
      text-align: {{ section.settings.title_align_d }};
      margin-bottom: {{ section.settings.title_mb_d }}px;
    }
  }

  .size-chart-subtext-{{ section.id }} {
    color: {{ section.settings.subtext_color }};
    font-size: {{ section.settings.subtext_size_m }}px;
    font-weight: {{ section.settings.subtext_weight }};
    line-height: {{ section.settings.subtext_lh }};
    text-align: {{ section.settings.subtext_align_m }};
    margin-bottom: {{ section.settings.subtext_mb_m }}px;
  }

  .size-chart-subtext-{{ section.id }} p {
    margin: 0 0 8px 0;
  }

  @media screen and (min-width: 769px) {
    .size-chart-subtext-{{ section.id }} {
      font-size: {{ section.settings.subtext_size_d }}px;
      text-align: {{ section.settings.subtext_align_d }};
      margin-bottom: {{ section.settings.subtext_mb_d }}px;
    }
  }

  /* ==========================================================================
     3. TABLE CONTAINER & GRID STYLING
     ========================================================================== */
  .size-chart-table-wrapper-{{ section.id }} {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: {{ section.settings.table_border_radius }}px;
    border: {{ section.settings.table_border_w }}px solid {{ section.settings.table_border_color }};
    margin-bottom: {{ section.settings.table_mb_m }}px;
  }

  @media screen and (min-width: 769px) {
    .size-chart-table-wrapper-{{ section.id }} {
      margin-bottom: {{ section.settings.table_mb_d }}px;
    }
  }

  .size-chart-table-{{ section.id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ section.settings.table_bg_color }};
  }

  /* HEADER STYLES */
  .size-chart-table-{{ section.id }} th {
    background-color: {{ section.settings.th_bg_color }};
    color: {{ section.settings.th_text_color }};
    font-size: {{ section.settings.th_size_m }}px;
    font-weight: {{ section.settings.th_weight }};
    text-transform: {{ section.settings.th_transform }};
    letter-spacing: {{ section.settings.th_ls }}px;
    text-align: {{ section.settings.th_align }};
    padding: {{ section.settings.th_pad_v_m }}px {{ section.settings.th_pad_h_m }}px;
    border: {{ section.settings.grid_line_w }}px solid {{ section.settings.grid_line_color }};
  }

  @media screen and (min-width: 769px) {
    .size-chart-table-{{ section.id }} th {
      font-size: {{ section.settings.th_size_d }}px;
      padding: {{ section.settings.th_pad_v_d }}px {{ section.settings.th_pad_h_d }}px;
    }
  }

  /* BODY CELL STYLES */
  .size-chart-table-{{ section.id }} td {
    color: {{ section.settings.td_text_color }};
    font-size: {{ section.settings.td_size_m }}px;
    font-weight: {{ section.settings.td_weight }};
    text-align: {{ section.settings.td_align }};
    padding: {{ section.settings.td_pad_v_m }}px {{ section.settings.td_pad_h_m }}px;
    border: {{ section.settings.grid_line_w }}px solid {{ section.settings.grid_line_color }};
  }

  @media screen and (min-width: 769px) {
    .size-chart-table-{{ section.id }} td {
      font-size: {{ section.settings.td_size_d }}px;
      padding: {{ section.settings.td_pad_v_d }}px {{ section.settings.td_pad_h_d }}px;
    }
  }

  {% if section.settings.enable_zebra %}
    .size-chart-table-{{ section.id }} tbody tr:nth-child(even) {
      background-color: {{ section.settings.zebra_bg_color }};
    }
  {% endif %}

  /* ==========================================================================
     4. FOOTER NOTE TYPOGRAPHY
     ========================================================================== */
  .size-chart-footer-{{ section.id }} {
    color: {{ section.settings.footer_color }};
    font-size: {{ section.settings.footer_size_m }}px;
    font-weight: {{ section.settings.footer_weight }};
    line-height: {{ section.settings.footer_lh }};
    text-align: {{ section.settings.footer_align_m }};
    margin-top: {{ section.settings.footer_mt_m }}px;
  }

  .size-chart-footer-{{ section.id }} p {
    margin: 0 0 6px 0;
  }

  @media screen and (min-width: 769px) {
    .size-chart-footer-{{ section.id }} {
      font-size: {{ section.settings.footer_size_d }}px;
      text-align: {{ section.settings.footer_align_d }};
      margin-top: {{ section.settings.footer_mt_d }}px;
    }
  }
{%- endstyle -%}

<section class="size-chart-section" id="size-chart-{{ section.id }}">
  <div class="size-chart-container-{{ section.id }}">

    <!-- SECTION TITLE -->
    {%- if section.settings.title != blank -%}
      <h2 class="size-chart-title-{{ section.id }}">{{ section.settings.title }}</h2>
    {%- endif -%}

    <!-- PRE-TABLE SUBTEXT / INSTRUCTIONS -->
    {%- if section.settings.subtext != blank -%}
      <div class="size-chart-subtext-{{ section.id }}">
        {{ section.settings.subtext }}
      </div>
    {%- endif -%}

    <!-- RING SIZE TABLE -->
    <div class="size-chart-table-wrapper-{{ section.id }}">
      <table class="size-chart-table-{{ section.id }}">
        <thead>
          <tr>
            {%- if section.settings.col1_title != blank -%}<th>{{ section.settings.col1_title }}</th>{%- endif -%}
            {%- if section.settings.col2_title != blank -%}<th>{{ section.settings.col2_title }}</th>{%- endif -%}
            {%- if section.settings.col3_title != blank -%}<th>{{ section.settings.col3_title }}</th>{%- endif -%}
            {%- if section.settings.col4_title != blank -%}<th>{{ section.settings.col4_title }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              {%- if section.settings.col1_title != blank -%}<td>{{ block.settings.col1_val }}</td>{%- endif -%}
              {%- if section.settings.col2_title != blank -%}<td>{{ block.settings.col2_val }}</td>{%- endif -%}
              {%- if section.settings.col3_title != blank -%}<td>{{ block.settings.col3_val }}</td>{%- endif -%}
              {%- if section.settings.col4_title != blank -%}<td>{{ block.settings.col4_val }}</td>{%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <!-- POST-TABLE FOOTER NOTES -->
    {%- if section.settings.footer_text != blank -%}
      <div class="size-chart-footer-{{ section.id }}">
        {{ section.settings.footer_text }}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Ring Size Chart Table",
  "tag": "section",
  "settings": [
    {
      "type": "header",
