{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}

  {%- for block in section.blocks -%}
    {%- if block.type == 'image' -%}
      {%- liquid
        assign align_ml = '0'
        assign align_mr = 'auto'
        case block.settings.alignment
          when 'center'
            assign align_ml = 'auto'
            assign align_mr = 'auto'
          when 'right'
            assign align_ml = 'auto'
            assign align_mr = '0'
        endcase
      -%}

      .rich-text-image-{{ block.id }} {
        display: block;
        width: {{ block.settings.image_width_mobile }}%;
        max-width: 100%;
        margin-left: {{ align_ml }};
        margin-right: {{ align_mr }};
        margin-top: {{ block.settings.margin_top_mobile }}px;
        margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
      }

      .rich-text-image-{{ block.id }} img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: {{ block.settings.image_radius }}px;
        {%- if block.settings.aspect_ratio != 'natural' %}
          aspect-ratio: {{ block.settings.aspect_ratio }};
          height: 100%;
          object-fit: cover;
          object-position: {{ block.settings.image_position }};
        {%- endif %}
      }

      .rich-text-image-{{ block.id }} .rich-text__image-caption {
        margin-top: 10px;
        font-size: {{ block.settings.caption_size }}px;
        text-align: {{ block.settings.alignment }};
        opacity: 0.75;
      }

      .rich-text-image-{{ block.id }} .rich-text__img--desktop { display: none; }
      .rich-text-image-{{ block.id }} .rich-text__img--mobile { display: block; }

      @media screen and (min-width: 990px) {
        .rich-text-image-{{ block.id }} {
          width: {{ block.settings.image_width_desktop }}%;
          margin-top: {{ block.settings.margin_top_desktop }}px;
          margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
        }

        .rich-text-image-{{ block.id }} .rich-text__img--desktop { display: block; }
        .rich-text-image-{{ block.id }} .rich-text__img--mobile { display: none; }
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="rich-text rich-text--full-width rich-text--align-{{ section.settings.alignment }} rich-text-{{ section.settings.width }}-width background color-background-1">
  <div class="container">
    <div class="rich-text__blocks  background section-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <div
              class="rich-text__subheading subtitle"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.subheading | escape }}
            </div>
          {%- when 'heading' -%}
            <div
              class="rich-text__heading title--section {{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </div>
          {%- when 'text' -%}
            <div class="rich-text__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'image' -%}
            {%- if block.settings.image != blank or block.settings.mobile_image != blank -%}
              <div
                class="rich-text__image rich-text-image-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image_link != blank -%}
                  <a href="{{ block.settings.image_link }}" class="rich-text__image-link">
                {%- endif -%}

                {%- if block.settings.mobile_image == blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      alt: block.settings.image.alt | default: shop.name,
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      alt: block.settings.image.alt
                  }}
                {%- elsif block.settings.image == blank -%}
                  {{
                    block.settings.mobile_image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      sizes: '100vw',
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      alt: block.settings.mobile_image.alt
                  }}
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'rich-text__img--desktop',
                      loading: 'lazy',
                      sizes: '50vw',
                      widths: '600, 800, 1000, 1200, 1600',
                      alt: block.settings.image.alt
                  }}
                  {{
                    block.settings.mobile_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'rich-text__img--mobile',
                      loading: 'lazy',
                      sizes: '100vw',
                      widths: '400, 600, 800, 1000, 1200',
                      alt: block.settings.mobile_image.alt
                  }}
                {%- endif -%}

                {%- if block.settings.image_link != blank -%}
                  </a>
                {%- endif -%}

                {%- if block.settings.caption != blank -%}
                  <div class="rich-text__image-caption">{{ block.settings.caption }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- when 'button' -%}
            <a
              {% if block.settings.button_link == blank %}
                aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link }}"
              {% endif %}
              class="button button--{{ block.settings.button_style }} focus-inset"
              {{ block.shopify_attributes }}
            >
              <span> {{ block.settings.button_label | escape }} </span>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

