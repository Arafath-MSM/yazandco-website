    width: {{ section.settings.star_size_d }}px;
    height: {{ section.settings.star_size_d }}px;
    fill: currentColor;
  }

  @media (max-width: 768px) {
    .testimonial-stars-{{ section.id }} {
      margin-bottom: {{ section.settings.stars_mb_m }}px;
    }
    .testimonial-stars-{{ section.id }} svg {
      width: {{ section.settings.star_size_m }}px;
      height: {{ section.settings.star_size_m }}px;
    }
  }

  /* Quote Body Text */
  .testimonial-quote-{{ section.id }} {
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.quote_size_d }}px;
    font-weight: {{ section.settings.quote_weight_d }};
    line-height: {{ section.settings.quote_line_height }};
    margin: 0 0 {{ section.settings.quote_mb_d }}px 0;
  }

  .testimonial-quote-{{ section.id }} p { margin: 0 0 8px 0; }
  .testimonial-quote-{{ section.id }} p:last-child { margin-bottom: 0; }

  @media (max-width: 768px) {
    .testimonial-quote-{{ section.id }} {
      font-size: {{ section.settings.quote_size_m }}px;
      font-weight: {{ section.settings.quote_weight_m }};
      margin-bottom: {{ section.settings.quote_mb_m }}px;
    }
  }

  /* Author Meta */
  .testimonial-author-{{ section.id }} {
    color: {{ section.settings.author_color }};
    font-size: {{ section.settings.author_size_d }}px;
    font-weight: {{ section.settings.author_weight_d }};
    margin: 0;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .testimonial-author-{{ section.id }} {
      font-size: {{ section.settings.author_size_m }}px;
      font-weight: {{ section.settings.author_weight_m }};
    }
  }

  .testimonial-location-{{ section.id }} {
    color: {{ section.settings.location_color }};
    font-size: {{ section.settings.location_size_d }}px;
    font-weight: {{ section.settings.location_weight_d }};
    margin-top: {{ section.settings.location_mt }}px;
    margin-bottom: 0;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .testimonial-location-{{ section.id }} {
      font-size: {{ section.settings.location_size_m }}px;
      font-weight: {{ section.settings.location_weight_m }};
    }
  }

  /* Footer Controls Row (Dots & Arrows) */
  .testimonials-footer-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: {{ section.settings.footer_mt_d }}px;
  }

  @media (max-width: 768px) {
    .testimonials-footer-{{ section.id }} {
      margin-top: {{ section.settings.footer_mt_m }}px;
    }
  }

  /* Dots Controls */
