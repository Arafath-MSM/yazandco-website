{% comment %} {% comment %}
  Section: Client Testimonials Slider
  Design: Minimal Luxury (Card Layout with Star Ratings, Header Link, Arrows & Dots)
  Customization: 100% Dynamic Schema Settings (Mobile & Desktop independent controls)
{% endcomment %}

<style>
  .testimonials-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    
    /* Desktop Section Padding */
    padding-top: {{ section.settings.padding_top_d }}px;
    padding-bottom: {{ section.settings.padding_bottom_d }}px;
    padding-left: {{ section.settings.padding_left_d }}px;
    padding-right: {{ section.settings.padding_right_d }}px;
  }

  @media (max-width: 768px) {
    .testimonials-{{ section.id }} {
      /* Mobile Section Padding */
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
      padding-left: {{ section.settings.padding_left_m }}px;
      padding-right: {{ section.settings.padding_right_m }}px;
    }
  }

  .testimonials-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Header Row Styling */
  .testimonials-header-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ section.settings.header_mb_d }}px;
  }

  @media (max-width: 768px) {
    .testimonials-header-{{ section.id }} {
      margin-bottom: {{ section.settings.header_mb_m }}px;
      flex-direction: {{ section.settings.header_direction_m }};
      align-items: {{ section.settings.header_align_m }};
      gap: 12px;
    }
  }

  .testimonials-heading-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_d }}px;
    font-weight: {{ section.settings.heading_weight_d }};
    text-transform: {{ section.settings.heading_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .testimonials-heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_m }}px;
      font-weight: {{ section.settings.heading_weight_m }};
    }
  }

  .testimonials-link-{{ section.id }} {
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size_d }}px;
    font-weight: {{ section.settings.link_weight_d }};
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.3s ease;
  }

  .testimonials-link-{{ section.id }}:hover {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .testimonials-link-{{ section.id }} {
      font-size: {{ section.settings.link_size_m }}px;
      font-weight: {{ section.settings.link_weight_m }};
    }
  }

  /* Slider / Track Styling */
  .testimonials-track-{{ section.id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    gap: {{ section.settings.gap_d }}px;
    padding-bottom: 8px;
    
    /* Hide Scrollbar */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .testimonials-track-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 768px) {
    .testimonials-track-{{ section.id }} {
      gap: {{ section.settings.gap_m }}px;
    }
  }

  /* Card Item Styling */
  .testimonial-card-{{ section.id }} {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - ({{ section.settings.gap_d }}px * ({{ section.settings.columns_d }} - 1))) / {{ section.settings.columns_d }});
    box-sizing: border-box;
    background-color: {{ section.settings.card_bg }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    
    /* Desktop Card Padding */
    padding-top: {{ section.settings.card_padding_top_d }}px;
    padding-bottom: {{ section.settings.card_padding_bottom_d }}px;
    padding-left: {{ section.settings.card_padding_left_d }}px;
    padding-right: {{ section.settings.card_padding_right_d }}px;
    
    box-shadow: {{ section.settings.card_shadow }};
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 1024px) {
    .testimonial-card-{{ section.id }} {
      flex: 0 0 calc((100% - ({{ section.settings.gap_d }}px * 1)) / 2);
    }
  }

  @media (max-width: 768px) {
    .testimonial-card-{{ section.id }} {
      flex: 0 0 {{ section.settings.card_width_m }}%;
      
      /* Mobile Card Padding */
      padding-top: {{ section.settings.card_padding_top_m }}px;
      padding-bottom: {{ section.settings.card_padding_bottom_m }}px;
      padding-left: {{ section.settings.card_padding_left_m }}px;
      padding-right: {{ section.settings.card_padding_right_m }}px;
    }
  }

  /* Stars Rating Styling */
  .testimonial-stars-{{ section.id }} {
    display: flex;
    gap: 4px;
    margin-bottom: {{ section.settings.stars_mb_d }}px;
    color: {{ section.settings.star_color }};
  }

  .testimonial-stars-{{ section.id }} svg {
    width: {{ section.settings.star_size_d }}px;
    height: {{ section.settings.star_size_d }}px;
    fill: currentColor;
  }

  @media (max-width: 768px) {
    .testimonial-stars-{{ section.id }} {
      margin-bottom: {{ section.settings.stars_mb_m }}px;
    }
    .testimonial-stars-{{ section.id }} svg {
      width: {{ section.settings.star_size_m }}px;
      height: {{ section.settings.star_size_m }}px;
    }
  }

  /* Quote Body Text */
  .testimonial-quote-{{ section.id }} {
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.quote_size_d }}px;
    font-weight: {{ section.settings.quote_weight_d }};
    line-height: {{ section.settings.quote_line_height }};
    margin: 0 0 {{ section.settings.quote_mb_d }}px 0;
  }

  @media (max-width: 768px) {
    .testimonial-quote-{{ section.id }} {
      font-size: {{ section.settings.quote_size_m }}px;
      font-weight: {{ section.settings.quote_weight_m }};
      margin-bottom: {{ section.settings.quote_mb_m }}px;
    }
  }

  /* Author Meta */
  .testimonial-author-{{ section.id }} {
    color: {{ section.settings.author_color }};
    font-size: {{ section.settings.author_size_d }}px;
    font-weight: {{ section.settings.author_weight_d }};
    margin: 0;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .testimonial-author-{{ section.id }} {
      font-size: {{ section.settings.author_size_m }}px;
      font-weight: {{ section.settings.author_weight_m }};
    }
  }

  .testimonial-location-{{ section.id }} {
    color: {{ section.settings.location_color }};
    font-size: {{ section.settings.location_size_d }}px;
    font-weight: {{ section.settings.location_weight_d }};
    margin-top: {{ section.settings.location_mt }}px;
    margin-bottom: 0;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .testimonial-location-{{ section.id }} {
      font-size: {{ section.settings.location_size_m }}px;
      font-weight: {{ section.settings.location_weight_m }};
    }
  }

  /* Footer Controls Row (Dots & Arrows) */
  .testimonials-footer-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: {{ section.settings.footer_mt_d }}px;
  }

  @media (max-width: 768px) {
    .testimonials-footer-{{ section.id }} {
      margin-top: {{ section.settings.footer_mt_m }}px;
    }
  }

  /* Dots Controls */
  .testimonials-dots-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .testimonials-dot-{{ section.id }} {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.dot_color }};
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .testimonials-dot-{{ section.id }}.active {
    background-color: {{ section.settings.dot_active_color }};
    transform: scale(1.2);
  }

  /* Arrows Controls */
  .testimonials-arrows-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.arrow_gap }}px;
  }

  .testimonials-arrow-{{ section.id }} {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: {{ section.settings.arrow_radius }}%;
    background-color: {{ section.settings.arrow_bg }};
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_border_color }};
    color: {{ section.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .testimonials-arrow-{{ section.id }}:hover {
    background-color: {{ section.settings.arrow_bg_hover }};
    color: {{ section.settings.arrow_color_hover }};
  }

  .testimonials-arrow-{{ section.id }} svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
</style>

<div class="testimonials-{{ section.id }}">
  <div class="testimonials-container-{{ section.id }}">
    
    {% comment %} Section Header {% endcomment %}
    <div class="testimonials-header-{{ section.id }}">
      {% if section.settings.heading != blank %}
        <h2 class="testimonials-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url | default: '#' }}" class="testimonials-link-{{ section.id }}">
          {{ section.settings.link_text | escape }}
        </a>
      {% endif %}
    </div>

    {% comment %} Cards Slider Track {% endcomment %}
    <div class="testimonials-track-{{ section.id }}" id="TestimonialsTrack-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="testimonial-card-{{ section.id }}" {{ block.shopify_attributes }}>
          <div>
            {% comment %} Rating Stars {% endcomment %}
            <div class="testimonial-stars-{{ section.id }}">
              {% assign rating = block.settings.rating | default: 5 %}
              {% for i in (1..rating) %}
                <svg viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              {% endfor %}
            </div>

            {% comment %} Quote Body Text {% endcomment %}
            {% if block.settings.quote != blank %}
              <div class="testimonial-quote-{{ section.id }}">
                {{ block.settings.quote }}
              </div>
            {% endif %}
          </div>

          {% comment %} Author Info {% endcomment %}
          <div>
            {% if block.settings.author != blank %}
              <p class="testimonial-author-{{ section.id }}">{{ block.settings.author | escape }}</p>
            {% endif %}
            
            {% if block.settings.location != blank %}
              <p class="testimonial-location-{{ section.id }}">{{ block.settings.location | escape }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% comment %} Bottom Controls (Dots & Navigation Arrows) {% endcomment %}
    <div class="testimonials-footer-{{ section.id }}">
      
      {% if section.settings.show_dots %}
        <div class="testimonials-dots-{{ section.id }}" id="TestimonialsDots-{{ section.id }}">
          {% for block in section.blocks %}
            <button 
              class="testimonials-dot-{{ section.id }} {% if forloop.first %}active{% endif %}" 
              aria-label="Go to slide {{ forloop.index }}"
              data-index="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% else %}
        <div></div>
      {% endif %}

      {% if section.settings.show_arrows %}
        <div class="testimonials-arrows-{{ section.id }}">
          <button class="testimonials-arrow-{{ section.id }}" id="PrevBtn-{{ section.id }}" aria-label="Previous slide">
            <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          </button>
          <button class="testimonials-arrow-{{ section.id }}" id="NextBtn-{{ section.id }}" aria-label="Next slide">
            <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
          </button>
        </div>
      {% endif %}

    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('TestimonialsTrack-{{ section.id }}');
    const prevBtn = document.getElementById('PrevBtn-{{ section.id }}');
    const nextBtn = document.getElementById('NextBtn-{{ section.id }}');
    const dotsContainer = document.getElementById('TestimonialsDots-{{ section.id }}');

    if (!track) return;

    // Smooth Scroll Navigation with Arrows
    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const cardWidth = track.querySelector('.testimonial-card-{{ section.id }}').offsetWidth;
        track.scrollBy({ left: -(cardWidth + {{ section.settings.gap_d }}), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const cardWidth = track.querySelector('.testimonial-card-{{ section.id }}').offsetWidth;
        track.scrollBy({ left: cardWidth + {{ section.settings.gap_d }}, behavior: 'smooth' });
      });
    }

    // Active Dot Tracker on Scroll
    if (dotsContainer) {
      const dots = dotsContainer.querySelectorAll('.testimonials-dot-{{ section.id }}');

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          const cards = track.querySelectorAll('.testimonial-card-{{ section.id }}');
          if (cards[index]) {
            cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }
        });
      });

      track.addEventListener('scroll', () => {
        const cards = track.querySelectorAll('.testimonial-card-{{ section.id }}');
        let activeIndex = 0;
        
        cards.forEach((card, i) => {
          const rect = card.getBoundingClientRect();
          const trackRect = track.getBoundingClientRect();
          if (Math.abs(rect.left - trackRect.left) < rect.width / 2) {
            activeIndex = i;
          }
        });

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === activeIndex);
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Testimonials Slider",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "CLIENT TESTIMONIALS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "heading_size_d",
      "min": 14, "max": 48, "step": 1, "unit": "px",
      "label": "Title Size (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "min": 12, "max": 36, "step": 1, "unit": "px",
      "label": "Title Size (Mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "heading_weight_d",
      "label": "Title Font Weight (Desktop)",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "heading_weight_m",
      "label": "Title Font Weight (Mobile)",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
