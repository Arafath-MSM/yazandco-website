<div class="testimonials-{{ section.id }}">
  <div class="testimonials-container-{{ section.id }}">

    {% comment %} Section Header {% endcomment %}
    <div class="testimonials-header-{{ section.id }}">
      {% if section.settings.heading != blank %}
        <h2 class="testimonials-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url | default: '#' }}" class="testimonials-link-{{ section.id }}">
          {{ section.settings.link_text | escape }}
        </a>
      {% endif %}
    </div>

    {% comment %} Cards Slider Track {% endcomment %}
    <div class="testimonials-track-{{ section.id }}" id="TestimonialsTrack-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="testimonial-card-{{ section.id }}" {{ block.shopify_attributes }}>

          {% comment %} Review Image (left by default) {% endcomment %}
          {% if block.settings.image != blank %}
            <div class="testimonial-media-{{ section.id }}">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                        {{ block.settings.image | image_url: width: 500 }} 500w,
                        {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 769px) {{ section.settings.media_width_d }}vw, 60vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | default: block.settings.author | escape }}"
                loading="lazy"
              >
            </div>
          {% elsif section.settings.show_image_placeholder %}
            <div class="testimonial-media-{{ section.id }}">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% comment %} Content Column {% endcomment %}
          <div class="testimonial-content-{{ section.id }}">
            <div>
              {% comment %} Rating Stars {% endcomment %}
              <div class="testimonial-stars-{{ section.id }}">
                {% assign rating = block.settings.rating | default: 5 %}
                {% for i in (1..rating) %}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                {% endfor %}
              </div>

              {% comment %} Quote Body Text {% endcomment %}
              {% if block.settings.quote != blank %}
                <div class="testimonial-quote-{{ section.id }}">
                  {{ block.settings.quote }}
                </div>
              {% endif %}
            </div>

            {% comment %} Author Info {% endcomment %}
            <div>
              {% if block.settings.author != blank %}
                <p class="testimonial-author-{{ section.id }}">{{ block.settings.author | escape }}</p>
              {% endif %}

              {% if block.settings.location != blank %}
                <p class="testimonial-location-{{ section.id }}">{{ block.settings.location | escape }}</p>
              {% endif %}
            </div>
          </div>

        </div>
      {% endfor %}
    </div>

    {% comment %} Bottom Controls (Dots & Navigation Arrows) {% endcomment %}
    <div class="testimonials-footer-{{ section.id }}">

      {% if section.settings.show_dots %}
        <div class="testimonials-dots-{{ section.id }}" id="TestimonialsDots-{{ section.id }}">
          {% for block in section.blocks %}
            <button
              class="testimonials-dot-{{ section.id }} {% if forloop.first %}active{% endif %}"
              aria-label="Go to slide {{ forloop.index }}"
              data-index="{{ forloop.index0 }}"
              type="button"
            ></button>
          {% endfor %}
        </div>
      {% else %}
        <div></div>
      {% endif %}

      {% if section.settings.show_arrows %}
        <div class="testimonials-arrows-{{ section.id }}">
          <button class="testimonials-arrow-{{ section.id }}" id="PrevBtn-{{ section.id }}" aria-label="Previous slide" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          </button>
          <button class="testimonials-arrow-{{ section.id }}" id="NextBtn-{{ section.id }}" aria-label="Next slide" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
          </button>
        </div>
      {% endif %}

    </div>

  </div>
</div>

<script>
  (function () {
    function initTestimonials{{ section.id | replace: '-', '_' | replace: '.', '_' }}() {
      var track = document.getElementById('TestimonialsTrack-{{ section.id }}');
      if (!track) return;

      var prevBtn = document.getElementById('PrevBtn-{{ section.id }}');
      var nextBtn = document.getElementById('NextBtn-{{ section.id }}');
      var dotsContainer = document.getElementById('TestimonialsDots-{{ section.id }}');
      var cards = track.querySelectorAll('.testimonial-card-{{ section.id }}');

      function step() {
        if (!cards.length) return 320;
        var gap = parseInt(window.getComputedStyle(track).getPropertyValue('gap'), 10) || 0;
        return cards[0].getBoundingClientRect().width + gap;
      }

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 2;
        nextBtn.disabled = track.scrollLeft >= maxScroll - 2;
      }

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', function () {
          track.scrollBy({ left: -step(), behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function () {
          track.scrollBy({ left: step(), behavior: 'smooth' });
        });
      }

      var dots = dotsContainer ? dotsContainer.querySelectorAll('.testimonials-dot-{{ section.id }}') : [];

      dots.forEach(function (dot, index) {
        dot.addEventListener('click', function () {
          if (cards[index]) {
            track.scrollTo({ left: cards[index].offsetLeft - track.offsetLeft, behavior: 'smooth' });
          }
        });
      });

      track.addEventListener('scroll', function () {
        var activeIndex = 0;
        var trackRect = track.getBoundingClientRect();
        cards.forEach(function (card, i) {
          var rect = card.getBoundingClientRect();
          if (rect.left - trackRect.left < rect.width / 2) activeIndex = i;
        });
        dots.forEach(function (dot, i) {
          dot.classList.toggle('active', i === activeIndex);
        });
        updateArrows();
      }, { passive: true });

      updateArrows();
      window.addEventListener('resize', updateArrows);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTestimonials{{ section.id | replace: '-', '_' | replace: '.', '_' }});
    } else {
      initTestimonials{{ section.id | replace: '-', '_' | replace: '.', '_' }}();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initTestimonials{{ section.id | replace: '-', '_' | replace: '.', '_' }}();
      }
    });
  })();
</script>

