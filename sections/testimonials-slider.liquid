{% comment %}
  Section: Client Testimonials Slider
  Design: Minimal Luxury (Image + Content Card Layout, Star Ratings, Header Link, Arrows & Dots)
  Customization: 100% Dynamic Schema Settings (Mobile & Desktop independent controls)
{% endcomment %}

<style>
  .testimonials-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};

    /* Desktop Section Padding */
    padding-top: {{ section.settings.padding_top_d }}px;
    padding-bottom: {{ section.settings.padding_bottom_d }}px;
    padding-left: {{ section.settings.padding_left_d }}px;
    padding-right: {{ section.settings.padding_right_d }}px;
  }

  @media (max-width: 768px) {
    .testimonials-{{ section.id }} {
      /* Mobile Section Padding */
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
      padding-left: {{ section.settings.padding_left_m }}px;
      padding-right: {{ section.settings.padding_right_m }}px;
    }
  }

  .testimonials-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Header Row Styling */
  .testimonials-header-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ section.settings.header_mb_d }}px;
  }

  @media (max-width: 768px) {
    .testimonials-header-{{ section.id }} {
      margin-bottom: {{ section.settings.header_mb_m }}px;
      flex-direction: {{ section.settings.header_direction_m }};
      align-items: {{ section.settings.header_align_m }};
      gap: 12px;
    }
  }

  .testimonials-heading-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_d }}px;
    font-weight: {{ section.settings.heading_weight_d }};
    text-transform: {{ section.settings.heading_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .testimonials-heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_m }}px;
      font-weight: {{ section.settings.heading_weight_m }};
    }
  }

  .testimonials-link-{{ section.id }} {
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size_d }}px;
    font-weight: {{ section.settings.link_weight_d }};
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }

  .testimonials-link-{{ section.id }}:hover {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .testimonials-link-{{ section.id }} {
      font-size: {{ section.settings.link_size_m }}px;
      font-weight: {{ section.settings.link_weight_m }};
    }
  }

  /* Slider / Track Styling */
  .testimonials-track-{{ section.id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    gap: {{ section.settings.gap_d }}px;
    padding-bottom: 8px;

    /* Hide Scrollbar */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .testimonials-track-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 768px) {
    .testimonials-track-{{ section.id }} {
      gap: {{ section.settings.gap_m }}px;
    }
  }

  /* Card Item Styling */
  .testimonial-card-{{ section.id }} {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - ({{ section.settings.gap_d }}px * ({{ section.settings.columns_d }} - 1))) / {{ section.settings.columns_d }});
    box-sizing: border-box;
    background-color: {{ section.settings.card_bg }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;

    /* Desktop Card Padding */
    padding-top: {{ section.settings.card_padding_top_d }}px;
    padding-bottom: {{ section.settings.card_padding_bottom_d }}px;
    padding-left: {{ section.settings.card_padding_left_d }}px;
    padding-right: {{ section.settings.card_padding_right_d }}px;

    box-shadow: {{ section.settings.card_shadow }};

    /* Image + Content layout */
    display: flex;
    flex-direction: column;
    {% comment %} align-items: {{ section.settings.media_align }}; {% endcomment %}
    gap: {{ section.settings.media_gap_d }}px;
  }

  @media (max-width: 1024px) {
    .testimonial-card-{{ section.id }} {
      flex: 0 0 calc((100% - ({{ section.settings.gap_d }}px * 1)) / 2);
    }
  }

  @media (max-width: 768px) {
    .testimonial-card-{{ section.id }} {
      flex: 0 0 {{ section.settings.card_width_m }}%;
      gap: {{ section.settings.media_gap_m }}px;
      {% if section.settings.stack_on_mobile %}
        flex-direction: column;
        align-items: stretch;
      {% endif %}

      /* Mobile Card Padding */
      padding-top: {{ section.settings.card_padding_top_m }}px;
      padding-bottom: {{ section.settings.card_padding_bottom_m }}px;
      padding-left: {{ section.settings.card_padding_left_m }}px;
      padding-right: {{ section.settings.card_padding_right_m }}px;
    }
  }

  /* Review Image */
  .testimonial-media-{{ section.id }} {
    flex: 0 0 50%;
    max-width: 100%;
    position: relative;
    padding-bottom: calc({{ section.settings.media_width_d }}% * {{ section.settings.media_ratio }} / 100);
    height: 0;
    overflow: hidden;
    border-radius: {{ section.settings.media_radius }}px;
    background-color: {{ section.settings.media_bg }};
  }

  .testimonial-media-{{ section.id }} img,
  .testimonial-media-{{ section.id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.media_fit }};
    object-position: center;
    display: block;
  }

  @media (max-width: 768px) {
    .testimonial-media-{{ section.id }} {
      flex: 0 0 {% if section.settings.stack_on_mobile %}auto{% else %}{{ section.settings.media_width_m }}%{% endif %};
      max-width: {% if section.settings.stack_on_mobile %}100%{% else %}{{ section.settings.media_width_m }}%{% endif %};
      padding-bottom: calc({% if section.settings.stack_on_mobile %}100%{% else %}{{ section.settings.media_width_m }}%{% endif %} * {{ section.settings.media_ratio_m }} / 100);
      border-radius: {{ section.settings.media_radius_m }}px;
    }
  }

  /* Content Column */
  .testimonial-content-{{ section.id }} {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

