{%- style -%}
  html {
    scroll-behavior: smooth;
  }

  .guide-nav-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    border-radius: {{ section.settings.border_radius_desktop }}px;
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    padding-left: {{ section.settings.padding_left_desktop }}px;
    padding-right: {{ section.settings.padding_right_desktop }}px;
  }

  .guide-nav-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .guide-nav-header-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.header_line_gap }}px;
    margin-bottom: {{ section.settings.header_margin_bottom_desktop }}px;
  }

  .guide-nav-title-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_transform }};
    white-space: nowrap;
    margin: 0;
  }

  .guide-nav-line-{{ section.id }} {
    flex-grow: 1;
    height: {{ section.settings.line_thickness }}px;
    background-color: {{ section.settings.line_color }};
  }

  .guide-nav-items-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ section.settings.gap_desktop }}px;
  }

  .guide-nav-item-{{ section.id }} {
    display: flex;
    align-items: baseline;
    gap: {{ section.settings.number_text_gap_desktop }}px;
    text-decoration: none;
    padding-top: {{ section.settings.item_padding_top_desktop }}px;
    padding-bottom: {{ section.settings.item_padding_bottom_desktop }}px;
    padding-left: {{ section.settings.item_padding_left_desktop }}px;
    padding-right: {{ section.settings.item_padding_right_desktop }}px;
    border-radius: {{ section.settings.item_border_radius_desktop }}px;
  }

  .guide-nav-number-{{ section.id }} {
    color: {{ section.settings.number_color }};
    font-size: {{ section.settings.number_size_desktop }}px;
    font-weight: {{ section.settings.number_weight }};
    line-height: 1;
  }

  .guide-nav-text-{{ section.id }} {
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size_desktop }}px;
    font-weight: {{ section.settings.link_weight }};
    line-height: {{ section.settings.link_line_height }};
    letter-spacing: {{ section.settings.link_letter_spacing }}px;
    text-decoration: {{ section.settings.link_decoration }};
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .guide-nav-item-{{ section.id }}:hover .guide-nav-text-{{ section.id }} {
    color: {{ section.settings.link_hover_color }};
    text-decoration: {{ section.settings.link_hover_decoration }};
  }

  @media screen and (max-width: 768px) {
    .guide-nav-section-{{ section.id }} {
      border-radius: {{ section.settings.border_radius_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;
    }

    .guide-nav-header-{{ section.id }} {
      margin-bottom: {{ section.settings.header_margin_bottom_mobile }}px;
    }

    .guide-nav-title-{{ section.id }} {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .guide-nav-items-{{ section.id }} {
      flex-direction: {{ section.settings.mobile_layout }};
      align-items: {% if section.settings.mobile_layout == 'column' %}flex-start{% else %}center{% endif %};
      gap: {{ section.settings.gap_mobile }}px;
    }

    .guide-nav-item-{{ section.id }} {
      gap: {{ section.settings.number_text_gap_mobile }}px;
      padding-top: {{ section.settings.item_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.item_padding_bottom_mobile }}px;
      padding-left: {{ section.settings.item_padding_left_mobile }}px;
      padding-right: {{ section.settings.item_padding_right_mobile }}px;
      border-radius: {{ section.settings.item_border_radius_mobile }}px;
    }

    .guide-nav-number-{{ section.id }} {
      font-size: {{ section.settings.number_size_mobile }}px;
    }

    .guide-nav-text-{{ section.id }} {
      font-size: {{ section.settings.link_size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="guide-nav-section-{{ section.id }}">
  <div class="guide-nav-container-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <div class="guide-nav-header-{{ section.id }}">
        <h3 class="guide-nav-title-{{ section.id }}">{{ section.settings.heading }}</h3>
        <div class="guide-nav-line-{{ section.id }}"></div>
      </div>
    {%- endif -%}

    <div class="guide-nav-items-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign raw_target = block.settings.target_id | strip
          assign first_char = raw_target | slice: 0
          if first_char == '#'
            assign target_hash = raw_target
          else
            assign target_hash = '#' | append: raw_target
          endif
        -%}
        <a
          href="{{ target_hash }}"
          class="guide-nav-item-{{ section.id }} js-smooth-scroll"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.number_prefix != blank -%}
            <span class="guide-nav-number-{{ section.id }}">{{ block.settings.number_prefix }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <span class="guide-nav-text-{{ section.id }}">{{ block.settings.title }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var scrollLinks = document.querySelectorAll('.guide-nav-section-{{ section.id }} .js-smooth-scroll');
    scrollLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        var targetId = this.getAttribute('href');
        if (targetId && targetId !== '#') {
          var targetElement = document.querySelector(targetId);
          if (targetElement) {
            e.preventDefault();
            targetElement.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        }
      });
    });
  });
</script>

