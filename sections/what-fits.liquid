{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign list_items = section.blocks | where: 'type', 'list_item'
-%}

<style>
  #WhatFits-{{ uid }} {
    --wf-bg: {{ s.bg_color }};
    --wf-heading: {{ s.heading_color }};
    --wf-text: {{ s.text_color }};
    --wf-num: {{ s.number_color }};
    --wf-item: {{ s.item_color }};
    --wf-item-link: {{ s.item_link_color }};
    --wf-btn-bg: {{ s.button_bg }};
    --wf-btn-text: {{ s.button_text_color }};
    --wf-btn-border: {{ s.button_border_color }};
    background-color: var(--wf-bg);
    padding-top: {{ s.padding_top_mobile }}px;
    padding-bottom: {{ s.padding_bottom_mobile }}px;
  }

  .wf__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.column_gap_mobile }}px;
    align-items: stretch;
    max-width: {{ s.container_max_width }}px;
    margin: 0 auto;
  }

  /* ===== MEDIA SIDE ===== */
  .wf__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ s.media_aspect_mobile }};
    overflow: hidden;
    border-radius: {{ s.media_radius }}px;
    background: #f2f2f0;
  }
  .wf__media img,
  .wf__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ===== CONTENT SIDE ===== */
  .wf__content {
    display: flex;
    flex-direction: column;
    justify-content: {{ s.content_valign }};
    padding: {{ s.content_padding_mobile }}px;
  }

  .wf__eyebrow {
    font-size: {{ s.eyebrow_size }}px;
    font-weight: {{ s.eyebrow_weight }};
    letter-spacing: {{ s.eyebrow_spacing }}em;
    text-transform: uppercase;
    color: var(--wf-text);
    opacity: 0.7;
    margin: 0 0 12px 0;
  }

  .wf__heading {
    font-size: {{ s.heading_size_mobile }}px;
    font-weight: {{ s.heading_weight }};
    letter-spacing: {{ s.heading_spacing }}em;
    line-height: 1.1;
    color: var(--wf-heading);
    margin: 0 0 18px 0;
  }

  .wf__text {
    font-size: {{ s.text_size_mobile }}px;
    font-weight: {{ s.text_weight }};
    line-height: 1.6;
    color: var(--wf-text);
    margin: 0 0 24px 0;
    max-width: 32em;
  }

  .wf__button {
    display: inline-block;
    align-self: flex-start;
    font-size: {{ s.button_size }}px;
    font-weight: {{ s.button_weight }};
    letter-spacing: {{ s.button_spacing }}em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--wf-btn-text);
    background: var(--wf-btn-bg);
    border: 1px solid var(--wf-btn-border);
    padding: {{ s.button_pad_v }}px {{ s.button_pad_h }}px;
    border-radius: {{ s.button_radius }}px;
    transition: opacity 0.2s;
    margin-bottom: {{ s.list_top_gap }}px;
  }
  .wf__button:hover { opacity: 0.8; }

  /* ===== NUMBERED LIST ===== */
  .wf__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ s.list_row_gap }}px;
  }
  .wf__list-item {
    display: flex;
    align-items: baseline;
    gap: {{ s.list_number_gap }}px;
    font-size: {{ s.item_size_mobile }}px;
    font-weight: {{ s.item_weight }};
    line-height: 1.4;
  }
  .wf__list-number {
    flex: 0 0 auto;
    font-size: {{ s.number_size_mobile }}px;
    font-weight: {{ s.number_weight }};
    color: var(--wf-num);
    min-width: 2.2em;
  }
  .wf__list-text { color: var(--wf-item); }
  .wf__list-text a {
    color: var(--wf-item-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wf__list-text a:hover { opacity: 0.7; }

  /* ===== SCROLL REVEAL ===== */
  .wf-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    will-change: opacity, transform;
  }
  .wf-reveal.wf-in {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .wf-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ===== DESKTOP (750px+) ===== */
  @media (min-width: 750px) {
    #WhatFits-{{ uid }} {
      padding-top: {{ s.padding_top_desktop }}px;
      padding-bottom: {{ s.padding_bottom_desktop }}px;
    }
    .wf__grid {
      grid-template-columns: {{ s.media_width }}fr {{ 100 | minus: s.media_width }}fr;
      gap: {{ s.column_gap_desktop }}px;
      {% if s.media_position == 'right' %}direction: rtl;{% endif %}
    }
    {% if s.media_position == 'right' %}
    .wf__grid > * { direction: ltr; }
    {% endif %}
    .wf__media { aspect-ratio: {{ s.media_aspect_desktop }}; }
    .wf__content { padding: {{ s.content_padding_desktop }}px; }
    .wf__heading { font-size: {{ s.heading_size_desktop }}px; }
    .wf__text { font-size: {{ s.text_size_desktop }}px; }
    .wf__list-item { font-size: {{ s.item_size_desktop }}px; }
    .wf__list-number { font-size: {{ s.number_size_desktop }}px; }
  }
</style>

<section id="WhatFits-{{ uid }}">
  <div class="wf__grid">

    {%- comment -%} ===== MEDIA SIDE ===== {%- endcomment -%}
    <div class="wf__media wf-reveal">
      {%- if s.video != blank -%}
        <video
          src="{{ s.video.sources[1].url | default: s.video.sources[0].url }}"
          autoplay muted loop playsinline
          {% if s.poster != blank %}poster="{{ s.poster | image_url: width: 1200 }}"{% endif %}
        ></video>
      {%- elsif s.video_url != blank -%}
        <video
          src="{{ s.video_url }}"
          autoplay muted loop playsinline
          {% if s.poster != blank %}poster="{{ s.poster | image_url: width: 1200 }}"{% endif %}
        ></video>
      {%- elsif s.image != blank -%}
        <img src="{{ s.image | image_url: width: 1400 }}" alt="{{ s.image.alt | escape }}" loading="lazy" width="auto" height="auto">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    {%- comment -%} ===== CONTENT SIDE ===== {%- endcomment -%}
    <div class="wf__content">
      {%- if s.eyebrow != blank -%}
        <p class="wf__eyebrow wf-reveal">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="wf__heading wf-reveal">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.text != blank -%}
        <div class="wf__text wf-reveal">{{ s.text }}</div>
      {%- endif -%}

      {%- if s.button_text != blank and s.button_link != blank -%}
        <a href="{{ s.button_link }}" class="wf__button wf-reveal">{{ s.button_text | escape }}</a>
      {%- endif -%}

      {%- if list_items.size > 0 -%}
        <ol class="wf__list wf-reveal">
          {%- for block in list_items -%}
            {%- assign b = block.settings -%}
            <li class="wf__list-item" {{ block.shopify_attributes }}>
              <span class="wf__list-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="wf__list-text">
                {%- if b.link != blank -%}
                  <a href="{{ b.link }}">{{ b.text | escape }}</a>
                {%- else -%}
                  {{ b.text | escape }}
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('WhatFits-{{ uid }}');
    if (!root) return;
    var items = root.querySelectorAll('.wf-reveal');
    if (!('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('wf-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('wf-in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    items.forEach(function (el, i) {
      el.style.transitionDelay = (i * 90) + 'ms';
      io.observe(el);
    });
  })();
</script>

