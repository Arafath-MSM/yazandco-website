{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- if settings.quickview_show or settings.show_on_mobile or settings.type_color_swatch == 'custom' -%}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{% if settings.on_hover == 'slider' %}
  <script src="{{ 'product-card-slider.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  {% render 'section-margin' %}

  #shopify-section-{{ section.id }} {
    --pp-per-row-desktop: {{ section.settings.products_to_show }};
    --pp-per-view-mobile: {{ section.settings.products_per_view_mobile }};
    --pp-slide-gap: {{ section.settings.slide_spacing }}px;
  }

  .popular-products__slider {
    position: relative;
  }

  .popular-products__slider-viewport {
    overflow: hidden;
  }

  .popular-products__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--pp-slide-gap, 16px);
  }

  .popular-products__slide {
    height: auto;
    flex-shrink: 0;
    width: calc((100% - (var(--pp-slide-gap, 16px) * (var(--pp-per-view-mobile, 1.2) - 1))) / var(--pp-per-view-mobile, 1.2));
  }

  .popular-products__slide img,
  .popular-products__slide svg {
    max-width: 100%;
  }

  @media screen and (min-width: 750px) {
    .popular-products__slide {
      width: calc((100% - (var(--pp-slide-gap, 16px) * (var(--pp-per-row-desktop, 4) - 1))) / var(--pp-per-row-desktop, 4));
    }
  }

  .popular-products__nav {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: opacity var(--duration-short) ease, visibility var(--duration-short) ease;
  }

  .popular-products__nav:hover {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }

  .popular-products__nav--prev {
    left: 0.4rem;
  }

  .popular-products__nav--next {
    right: 0.4rem;
  }

  .popular-products__nav[disabled],
  .popular-products__nav.swiper-button-disabled,
  .popular-products__nav.swiper-button-lock {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .popular-products__nav {
    display: none;
  }

  {% if section.settings.show_arrows_mobile %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .popular-products__nav {
        display: flex;
      }
    }
  {% endif %}

  {% if section.settings.show_arrows_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .popular-products__nav {
        display: flex;
        width: 4.4rem;
        height: 4.4rem;
      }

      #shopify-section-{{ section.id }} .popular-products__nav--prev {
        left: -1.6rem;
      }

      #shopify-section-{{ section.id }} .popular-products__nav--next {
        right: -1.6rem;
      }
    }
  {% endif %}
{%- endstyle -%}

{% liquid
  assign product_source = section.settings.product_source
  assign display_products = section.settings.product_list

  if product_source == 'collection' and section.settings.collection != blank
    assign display_products = section.settings.collection.products | limit: section.settings.collection_limit
  endif
%}

<div class="popular-products section-{{ section.id }}-padding background color-background-1">
  <div class="container popular-products__container">
    {% render 'section-header' %}
    <div class="popular-products__content">
      <div class="popular-products__slider">
        <div class="popular-products__slider-viewport swiper" data-pp-swiper>
          <ul class="popular-products__track swiper-wrapper list-unstyled">
            {%- for product in display_products -%}
              <li
                class="
                  popular-products__slide collection-product-card swiper-slide
                  quickview{%- if settings.on_hover == "hover" -%}--hover{% endif %}
                "
              >
                {% render 'product-card',
                  product_card_product: product,
                  media_size: section.settings.image_ratio,
                  media_fit: section.settings.image_fit,
                  show_vendor: section.settings.show_vendor,
                  show_color_count: section.settings.show_color_count,
                  show_size_count: section.settings.show_size_count,
                  show_collection: section.settings.show_collection,
                  show_desc: section.settings.show_desc,
                  section_id: section.id,
                  add_id: forloop.index
                %}
              </li>
            {%- else -%}
              {%- for i in (1..4) -%}
                <li class="popular-products__slide collection-popular-card collection-popular-card--placeholder swiper-slide">
                  {% render 'product-card-placeholder',
                    media_size: section.settings.image_ratio,
                    placeholder_index: forloop.index
                  %}
                </li>
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        </div>

        <button
          type="button"
          class="popular-products__nav popular-products__nav--prev"
          aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous slide' }}"
          data-pp-prev
        >
          {%- render 'icon-caret-left' -%}
        </button>
        <button
          type="button"
          class="popular-products__nav popular-products__nav--next"
          aria-label="{{ 'general.slider.next_slide' | t | default: 'Next slide' }}"
          data-pp-next
        >
          {%- render 'icon-caret-right' -%}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    'use strict';

    function initPopularProductsSlider(root) {
      if (root.dataset.ppInitialized) return;
      root.dataset.ppInitialized = 'true';

      var sliderEl = root.querySelector('[data-pp-swiper]');
      if (!sliderEl || typeof Swiper === 'undefined') return;

      var prevEl = root.querySelector('[data-pp-prev]');
      var nextEl = root.querySelector('[data-pp-next]');

      new Swiper(sliderEl, {
        slidesPerView: 'auto',
        spaceBetween: 0,
        watchOverflow: true,
        grabCursor: true,
        a11y: {
          enabled: true
        },
        keyboard: {
          enabled: true,
          onlyInViewport: true
        },
        navigation: prevEl && nextEl ? {
          prevEl: prevEl,
          nextEl: nextEl,
          disabledClass: 'swiper-button-disabled',
          lockClass: 'swiper-button-lock'
        } : false
      });
    }

    function initAll() {
      document.querySelectorAll('.popular-products__slider').forEach(initPopularProductsSlider);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        var root = event.target.querySelector('.popular-products__slider');
        if (root) {
          root.dataset.ppInitialized = '';
          initPopularProductsSlider(root);
        }
      });
    }
  })();
</script>

