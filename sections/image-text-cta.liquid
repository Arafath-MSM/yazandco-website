{% comment %}
  Image with Text CTA
  Self-contained OS 2.0 section: heading/description/two buttons on one side,
  an image on the other. Uses the theme's existing title, heading-size and
  button classes so it stays visually consistent with the rest of the store.
{% endcomment %}

{%- style -%}
  {% render 'section-margin' %}

  .itc {
    position: relative;
  }

  .itc__wrapper {
    display: grid;
    grid-template-columns: 1fr;
  }

  .itc__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 2rem;
  }

  .itc--full .itc__content {
    padding: 4rem 5%;
  }

  .itc__subheading {
    margin: 0 0 1rem;
  }

  .itc__heading {
    margin: 0 0 1.6rem;
  }

  .itc__text {
    margin: 0 0 2.4rem;
  }

  .itc__text:last-child {
    margin-bottom: 0;
  }

  .itc__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .itc__media {
    position: relative;
    overflow: hidden;
  }

  .itc__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .itc__media--ratio {
    padding-bottom: 100%;
  }

  /* .itc__media--ratio.itc__media--landscape {
    padding-bottom: 70%;
  }

  .itc__media--ratio.itc__media--portrait {
    padding-bottom: 130%;
  }

  .itc__media--ratio.itc__media--square {
    padding-bottom: 100%;
  } */

  .itc__media--ratio img {
    position: absolute;
    top: 0;
    left: 0;
  }

  .itc__media--placeholder {
    background: rgba(var(--color-foreground), 0.05);
  }

  .itc__media--placeholder .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .itc--mobile-image-last .itc__media {
    order: 2;
  }

  .itc--mobile-image-last .itc__content {
    order: 1;
  }

  @media screen and (min-width: 750px) {
    .itc__wrapper {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .itc--desktop-image-right .itc__media {
      order: 2;
    }

    .itc--desktop-image-right .itc__content {
      order: 1;
    }

    .itc--desktop-image-left .itc__media {
      order: 1;
    }

    .itc--desktop-image-left .itc__content {
      order: 2;
    }

    .itc__media--ratio {
      padding-bottom: 0;
      height: 100%;
    }

    .itc__media--ratio img {
      position: static;
    }

    .itc__content {
      padding: 6rem 8%;
    }
  }
{%- endstyle -%}

<div class="itc color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding{% if section.settings.full_width %} itc--full{% endif %} itc--desktop-{{ section.settings.layout_desktop }} itc--mobile-{{ section.settings.layout_mobile }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="itc__wrapper">
      <div class="itc__content">
        {%- if section.settings.subheading != blank -%}
          <p class="subtitle itc__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="title--section itc__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="itc__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="itc__buttons">
            {%- if section.settings.button_label_1 != blank -%}
              <a
                {% if section.settings.button_link_1 != blank %}
                  href="{{ section.settings.button_link_1 }}"
                {% endif %}
                class="button button--{{ section.settings.button_style_1 }} focus-inset"
                {% if section.settings.button_link_1 == blank %}
                  aria-disabled="true"
                {% endif %}
              >
                <span>{{- section.settings.button_label_1 | escape -}}</span>
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a
                {% if section.settings.button_link_2 != blank %}
                  href="{{ section.settings.button_link_2 }}"
                {% endif %}
                class="button button--{{ section.settings.button_style_2 }} focus-inset"
                {% if section.settings.button_link_2 == blank %}
                  aria-disabled="true"
                {% endif %}
              >
                <span>{{- section.settings.button_label_2 | escape -}}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="itc__media itc__media--ratio itc__media--{{ section.settings.image_ratio }}{% if section.settings.image == blank %} itc__media--placeholder{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375, 550, 750, 1100, 1500'
          }}
        {%- else -%}
          {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with Text CTA",
  "tag": "section",
  "class": "image-text-cta-section spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Book Appointment"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:sections.all.button.button_label.label",
      "default": "Book Appointment"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:sections.all.button.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "secondary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.all.button.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.all.button.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "simple",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.header__image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.image_ratio.options__3.label"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Image position (desktop)",
      "options": [
        {
          "value": "image-left",
          "label": "Left"
        },
        {
          "value": "image-right",
          "label": "Right"
        }
      ],
      "default": "image-right"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Image position (mobile)",
      "options": [
        {
          "value": "image-first",
          "label": "First"
        },
        {
          "value": "image-last",
          "label": "Last"
        }
      ],
      "default": "image-first"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "Image with Text CTA"
    }
  ]
}
{% endschema %}
