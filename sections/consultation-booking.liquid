{% comment %} <div
  id="{{ section.settings.anchor_id | default: 'book-a-consultation' }}"
  class="consultation-booking color-{{ section.settings.color_scheme }}"
  style="
    --consultation-pad-top: {{ section.settings.padding_top }}px;
    --consultation-pad-bottom: {{ section.settings.padding_bottom }}px;
    --consultation-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --consultation-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="consultation-booking__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="consultation-booking__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="consultation-booking__description rte">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          href="#"
          aria-disabled="true"
        {% endif %}
        class="button button--tertiary consultation-booking__button"
      >
        <span>{{ section.settings.button_label }}</span>
      </a>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="consultation-booking__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .consultation-booking {
    padding-top: var(--consultation-pad-top);
    padding-bottom: var(--consultation-pad-bottom);
    text-align: center;
  }
  .consultation-booking__inner {
    max-width: 68rem;
    margin: 0 auto;
  }
  .consultation-booking__heading {
    margin: 0 0 1.2rem;
  }
  .consultation-booking__description {
    margin-bottom: 2rem;
  }
  @media screen and (max-width: 749px) {
    .consultation-booking {
      padding-top: var(--consultation-pad-top-mobile);
      padding-bottom: var(--consultation-pad-bottom-mobile);
    }
  }
</style>

{% schema %}
{
  "name": "Consultation Booking",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "book-a-consultation", "info": "Must match the 'Target section ID' set on the Book a Consultation button block." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book a Consultation" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Meet with our specialists in person or virtually to explore this piece.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose a time" },
    { "type": "url", "id": "button_link", "label": "Booking link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop, px)", "min": 0, "max": 160, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop, px)", "min": 0, "max": 160, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile, px)", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile, px)", "min": 0, "max": 120, "step": 4, "default": 48 }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Consultation Booking" }
  ]
}
{% endschema %} {% endcomment %}


{%- liquid
  assign whatsapp_url = ''
  if section.settings.whatsapp_number != blank
    assign whatsapp_digits = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
    assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
    if section.settings.whatsapp_message != blank
      assign whatsapp_url = whatsapp_url | append: '?text=' | append: section.settings.whatsapp_message | url_encode
    endif
  elsif section.settings.whatsapp_link != blank
    assign whatsapp_url = section.settings.whatsapp_link
  endif
-%}
<div
  id="{{ section.settings.anchor_id | default: 'book-a-consultation' }}"
  data-section-id="{{ section.id }}"
  class="consultation-booking color-{{ section.settings.color_scheme }} consultation-booking--image-{{ section.settings.image_position }} {% if section.settings.full_width %}consultation-booking--full-width{% endif %}"
>
  <div class="consultation-booking__inner">
    {%- if section.settings.image != blank -%}
      <div class="consultation-booking__media">
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      </div>
    {%- endif -%}

    <div class="consultation-booking__content">
      {%- if section.settings.eyebrow_text != blank -%}
        <p class="consultation-booking__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="consultation-booking__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="consultation-booking__description rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="consultation-booking__steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li class="consultation-booking__step" {{ block.shopify_attributes }}>
                <span class="consultation-booking__step-number">
                  {%- if block.settings.number != blank -%}
                    {{ block.settings.number }}
                  {%- else -%}
                    {{ forloop.index | prepend: '00' | slice: -2, 2 }}
                  {%- endif -%}
                </span>
                <span class="consultation-booking__step-text">{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.button_label != blank or whatsapp_url != blank -%}
        <div class="consultation-booking__buttons">
          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                href="#"
                aria-disabled="true"
              {% endif %}
              class="consultation-booking__button consultation-booking__button--primary"
            >
              <span>{{ section.settings.button_label }}</span>
            </a>
          {%- endif -%}
          {%- if whatsapp_url != blank -%}
            <a
              href="{{ whatsapp_url }}"
              target="_blank"
              rel="noopener"
              class="consultation-booking__button consultation-booking__button--secondary"
            >
              <span>{{ section.settings.whatsapp_label }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="consultation-booking__app" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  [data-section-id="{{ section.id }}"].consultation-booking {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.column_gap_mobile }}px;
    align-items: center;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding_mobile }}px;
    padding-right: {{ section.settings.side_padding_mobile }}px;
  }
  [data-section-id="{{ section.id }}"].consultation-booking--full-width .consultation-booking__inner {
    max-width: none;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_radius }}px;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__content {
    text-align: {{ section.settings.content_align_mobile }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__eyebrow {
    text-transform: {{ section.settings.eyebrow_text_transform }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 1.2rem;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__heading {
    margin: 0 0 1.6rem;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__description {
    color: {{ section.settings.text_color }};
    margin-bottom: 2.4rem;
    font-size: {{ section.settings.description_font_size_mobile }}px;
    line-height: {{ section.settings.description_line_height }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__steps {
    list-style: none;
    margin: 0 0 2.8rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.step_gap }}px;
    align-items: {% if section.settings.content_align_mobile == 'center' %}center{% else %}flex-start{% endif %};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__step {
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
    text-align: left;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__step-number {
    flex-shrink: 0;
    min-width: 2.4rem;
    font-size: {{ section.settings.step_number_font_size }}px;
    font-weight: {{ section.settings.step_number_font_weight }};
    color: {{ section.settings.number_color }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__step-text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.step_text_font_size }}px;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__buttons {
    display: flex;
    flex-wrap: {% if section.settings.button_layout_mobile == 'stacked' %}nowrap{% else %}wrap{% endif %};
    flex-direction: {% if section.settings.button_layout_mobile == 'stacked' %}column{% else %}row{% endif %};
    gap: {{ section.settings.button_gap }}px;
    justify-content: {% if section.settings.content_align_mobile == 'center' %}center{% else %}flex-start{% endif %};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_min_height }}px;
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: {{ section.settings.button_font_weight }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    text-transform: {{ section.settings.button_text_transform }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__button--primary {
    background-color: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.primary_button_bg }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__button--primary:hover {
    background-color: {{ section.settings.primary_button_hover_bg }};
    color: {{ section.settings.primary_button_hover_text }};
    border-color: {{ section.settings.primary_button_hover_bg }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__button--secondary {
    background-color: {{ section.settings.secondary_button_bg }};
    color: {{ section.settings.secondary_button_text }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.secondary_button_border }};
  }
  [data-section-id="{{ section.id }}"] .consultation-booking__button--secondary:hover {
    background-color: {{ section.settings.secondary_button_hover_bg }};
    color: {{ section.settings.secondary_button_hover_text }};
    border-color: {{ section.settings.secondary_button_hover_bg }};
  }

  @media screen and (min-width: 750px) {
    [data-section-id="{{ section.id }}"].consultation-booking {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__inner {
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.column_gap }}px;
      padding-left: {{ section.settings.side_padding }}px;
      padding-right: {{ section.settings.side_padding }}px;
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__content {
      text-align: {{ section.settings.content_align_desktop }};
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__steps {
      align-items: {% if section.settings.content_align_desktop == 'center' %}center{% else %}flex-start{% endif %};
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__buttons {
      justify-content: {% if section.settings.content_align_desktop == 'center' %}center{% else %}flex-start{% endif %};
      flex-direction: {% if section.settings.button_layout_desktop == 'stacked' %}column{% else %}row{% endif %};
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_desktop }}px;
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__description {
      font-size: {{ section.settings.description_font_size_desktop }}px;
    }
    [data-section-id="{{ section.id }}"] .consultation-booking__button {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
    [data-section-id="{{ section.id }}"].consultation-booking--image-right .consultation-booking__media {
      order: 2;
    }
    [data-section-id="{{ section.id }}"].consultation-booking--image-right .consultation-booking__content {
      order: 1;
    }
  }

  @media screen and (max-width: 749px) {
    [data-section-id="{{ section.id }}"] .consultation-booking__button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Consultation Booking",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "book-a-consultation", "info": "Must match the 'Target section ID' set on the Book a Consultation button block." },

    { "type": "header", "content": "IMAGE" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "image_radius", "label": "Image corner radius (px)", "min": 0, "max": 40, "step": 1, "default": 0 },

    { "type": "header", "content": "CONTENT" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow text", "default": "Appointment-Only Boutique · Dubai" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it before you decide" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Spend an hour with our team. Try sample pieces, compare diamond shapes and gold colours in daylight, and leave knowing your exact size — with no obligation to order.</p>"
    },
    {
      "type": "select",
      "id": "content_align_desktop",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "TYPOGRAPHY — EYEBROW" },
    { "type": "range", "id": "eyebrow_font_size_desktop", "label": "Font size (desktop, px)", "min": 9, "max": 20, "step": 1, "default": 12 },
    { "type": "range", "id": "eyebrow_font_size_mobile", "label": "Font size (mobile, px)", "min": 9, "max": 18, "step": 1, "default": 11 },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Font weight",
      "default": "500",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "eyebrow_letter_spacing", "label": "Letter spacing (px)", "min": 0, "max": 3, "step": 0.1, "default": 1 },
    {
      "type": "select",
      "id": "eyebrow_text_transform",
      "label": "Text transform",
      "default": "uppercase",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },

    { "type": "header", "content": "TYPOGRAPHY — HEADING" },
    { "type": "range", "id": "heading_font_size_desktop", "label": "Font size (desktop, px)", "min": 20, "max": 64, "step": 1, "default": 34 },
    { "type": "range", "id": "heading_font_size_mobile", "label": "Font size (mobile, px)", "min": 18, "max": 44, "step": 1, "default": 26 },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },

    { "type": "header", "content": "TYPOGRAPHY — DESCRIPTION & STEPS" },
    { "type": "range", "id": "description_font_size_desktop", "label": "Description size (desktop, px)", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "description_font_size_mobile", "label": "Description size (mobile, px)", "min": 12, "max": 20, "step": 1, "default": 14 },
    { "type": "range", "id": "step_number_font_size", "label": "Step number size (px)", "min": 10, "max": 20, "step": 1, "default": 12 },
    {
      "type": "select",
      "id": "step_number_font_weight",
      "label": "Step number weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "step_text_font_size", "label": "Step text size (px)", "min": 12, "max": 20, "step": 1, "default": 15 },
    { "type": "range", "id": "step_gap", "label": "Gap between steps (px)", "min": 4, "max": 32, "step": 1, "default": 14 },

    { "type": "header", "content": "BUTTONS — CONTENT" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Book an Appointment" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Message us on WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "info": "Include country code, e.g. 971501234567. Leave blank to use the link field below instead." },
    { "type": "text", "id": "whatsapp_message", "label": "Pre-filled WhatsApp message (optional)" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link (used only if number above is blank)" },

    { "type": "header", "content": "BUTTONS — LAYOUT" },
    {
      "type": "select",
      "id": "button_layout_desktop",
      "label": "Layout (desktop)",
      "default": "side_by_side",
      "options": [
        { "value": "side_by_side", "label": "Side by side" },
        { "value": "stacked", "label": "Stacked" }
      ]
    },
    {
      "type": "select",
      "id": "button_layout_mobile",
      "label": "Layout (mobile)",
      "default": "stacked",
      "options": [
        { "value": "side_by_side", "label": "Side by side" },
        { "value": "stacked", "label": "Stacked" }
      ]
    },
    { "type": "range", "id": "button_gap", "label": "Gap between buttons (px)", "min": 4, "max": 32, "step": 1, "default": 12 },

    { "type": "header", "content": "BUTTONS — STYLE (shared)" },
    { "type": "range", "id": "button_font_size_desktop", "label": "Font size (desktop, px)", "min": 10, "max": 20, "step": 1, "default": 13 },
    { "type": "range", "id": "button_font_size_mobile", "label": "Font size (mobile, px)", "min": 10, "max": 18, "step": 1, "default": 12 },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Font weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "button_letter_spacing", "label": "Letter spacing (px)", "min": 0, "max": 3, "step": 0.1, "default": 0.4 },
    {
      "type": "select",
      "id": "button_text_transform",
      "label": "Text transform",
      "default": "uppercase",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },
