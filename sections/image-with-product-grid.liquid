{% comment %} {% comment %}
  Image with Product Grid
  Self-contained OS 2.0 section: a feature image paired with a grid of
  hand-picked products, using the theme's existing product-card snippet
  so cards stay 100% consistent with the rest of the store.
{% endcomment %}

<link
	rel="preload"
	href="{{ 'component-card.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>
<link
	rel="preload"
	href="{{ 'component-price.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>
<link
	rel="preload"
	href="{{ 'component-badge.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>

<noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-badge.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  {% render 'section-margin' %}

  #shopify-section-{{ section.id }} {
    --iwpg-columns-desktop: {{ section.settings.grid_columns_desktop }};
    --iwpg-columns-mobile: {{ section.settings.grid_columns_mobile }};
    --iwpg-grid-gap: {{ section.settings.grid_gap }}px;
    --iwpg-heading-font-size: {{ section.settings.heading_font_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --iwpg-heading-font-size: {{ section.settings.heading_font_size_desktop }}px;
    }
  }

  .iwpg {
    position: relative;
  }

  .iwpg__heading-wrapper {
    padding: 0 2rem 2.4rem;
  }

  .iwpg--full .iwpg__heading-wrapper {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .iwpg__heading {
    font-size: var(--iwpg-heading-font-size);
  }

  .iwpg__heading--left {
    text-align: left;
  }

  .iwpg__heading--center {
    text-align: center;
  }

  .iwpg__heading--right {
    text-align: right;
  }

  .iwpg__wrapper {
    display: grid;
    grid-template-columns: 1fr;
  }

  .iwpg__media {
    position: relative;
    overflow: hidden;
  }

  .iwpg__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .iwpg__media--mobile-ratio {
    padding-bottom: 100%;
  }

  .iwpg__media--mobile-ratio.iwpg__media--landscape {
    padding-bottom: 70%;
  }

  .iwpg__media--mobile-ratio.iwpg__media--portrait {
    padding-bottom: 130%;
  }

  .iwpg__media--mobile-ratio.iwpg__media--square {
    padding-bottom: 100%;
  }

  .iwpg__media--mobile-ratio img {
    position: absolute;
    top: 0;
    left: 0;
  }

  .iwpg__media--placeholder {
    background: rgba(var(--color-foreground), 0.05);
  }

  .iwpg__media--placeholder .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .iwpg__grid {
    display: grid;
    grid-template-columns: repeat(var(--iwpg-columns-mobile, 2), 1fr);
    gap: var(--iwpg-grid-gap, 16px);
    padding: var(--iwpg-grid-gap, 16px);
  }

  .iwpg__grid-item {
    position: relative;
  }

  .iwpg__wishlist {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    padding: 0;
    background: transparent;
    border: none;
    color: rgb(var(--color-foreground));
    cursor: pointer;
  }

  .iwpg__wishlist svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: fill var(--duration-short) ease;
  }

  .iwpg__wishlist[aria-pressed="true"] svg {
    fill: currentColor;
  }

  .iwpg__empty {
    text-align: center;
    opacity: 0.7;
    padding: 4rem 2rem;
  }

  @media screen and (min-width: 750px) {
    .iwpg__wrapper {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .iwpg--image-right .iwpg__media {
      order: 2;
    }

    .iwpg--image-right .iwpg__grid-wrapper {
      order: 1;
    }

    .iwpg__media--mobile-ratio {
      padding-bottom: 0;
      height: 100%;
    }

    .iwpg__media--mobile-ratio img {
      position: static;
    }

    .iwpg__grid {
      grid-template-columns: repeat(var(--iwpg-columns-desktop, 2), 1fr);
      height: 100%;
    }
  }
{%- endstyle -%}

<div class="iwpg color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding{% if section.settings.full_width %} iwpg--full{% endif %}{% if section.settings.layout == 'image_right' %} iwpg--image-right{% endif %}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <div class="iwpg__heading-wrapper">
        <h2 class="title title--primary iwpg__heading iwpg__heading--{{ section.settings.heading_alignment }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="iwpg__wrapper">
      <div class="iwpg__media iwpg__media--mobile-ratio iwpg__media--{{ section.settings.mobile_image_ratio }}{% if section.settings.image == blank %} iwpg__media--placeholder{% endif %}">
        {%- if section.settings.image_link != blank -%}<a href="{{ section.settings.image_link }}">{%- endif -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375, 550, 750, 1100, 1500'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.image_link != blank -%}</a>{%- endif -%}
      </div>

      <div class="iwpg__grid-wrapper">
        {%- if section.blocks.size > 0 -%}
          <div class="iwpg__grid">
            {%- for block in section.blocks -%}
              {%- assign block_product = block.settings.product -%}
              {%- if block_product != blank -%}
                <div class="iwpg__grid-item" {{ block.shopify_attributes }}>
                  {%- if section.settings.show_wishlist_icon -%}
                    <button
                      type="button"
                      class="iwpg__wishlist"
                      aria-label="{{ 'general.wishlist.add' | t | default: 'Add to wishlist' }}"
                      aria-pressed="false"
                      data-iwpg-wishlist
                    >
                      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M12 20.5s-7.5-4.6-10-9.3C.5 8 1.8 4.5 5 3.4c2.2-.8 4.4 0 5.6 1.8l1.4 2 1.4-2c1.2-1.8 3.4-2.6 5.6-1.8 3.2 1.1 4.5 4.6 3 7.8-2.5 4.7-10 9.3-10 9.3z"/>
                      </svg>
                    </button>
                  {%- endif -%}
                  {%- render 'product-card',
                    product_card_product: block_product,
                    media_size: section.settings.product_image_ratio,
                    media_fit: section.settings.product_image_fit,
                    show_vendor: section.settings.show_vendor,
                    show_color_count: section.settings.show_color_count,
                    section_id: section.id,
                    add_id: forloop.index
                  -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="iwpg__empty">{{ 'sections.featured_collection.no_products' | t | default: 'Add product blocks to get started.' }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    'use strict';

    function initWishlistButtons(root) {
      root.querySelectorAll('[data-iwpg-wishlist]').forEach(function (button) {
        if (button.dataset.iwpgBound) return;
        button.dataset.iwpgBound = 'true';
        button.addEventListener('click', function () {
          var pressed = button.getAttribute('aria-pressed') === 'true';
          button.setAttribute('aria-pressed', pressed ? 'false' : 'true');
        });
      });
    }

    function initAll() {
      document.querySelectorAll('.iwpg').forEach(initWishlistButtons);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        var root = event.target.querySelector('.iwpg');
        if (root) initWishlistButtons(root);
      });
    }
  })();
</script>

{% schema %}
{
