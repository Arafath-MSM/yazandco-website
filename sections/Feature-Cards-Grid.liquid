{%- liquid
  assign is_overlay = false
  if section.settings.card_layout == 'overlay'
    assign is_overlay = true
  endif
-%}

{%- style -%}
  /* ==========================================================================
     1. SECTION CONTAINER & PADDINGS (DESKTOP / MOBILE)
     ========================================================================== */
  #feature-grid-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.pad_top_m }}px;
    padding-bottom: {{ section.settings.pad_bottom_m }}px;
    padding-left: {{ section.settings.pad_left_m }}px;
    padding-right: {{ section.settings.pad_right_m }}px;
  }

  @media screen and (min-width: 990px) {
    #feature-grid-{{ section.id }} {
      padding-top: {{ section.settings.pad_top_d }}px;
      padding-bottom: {{ section.settings.pad_bottom_d }}px;
      padding-left: {{ section.settings.pad_left_d }}px;
      padding-right: {{ section.settings.pad_right_d }}px;
    }
  }

  .fg-container-{{ section.id }} {
    max-width: {{ section.settings.container_max_w }}px;
    margin: 0 auto;
    width: 100%;
  }

  /* ==========================================================================
     2. SECTION HEADER TYPOGRAPHY & ALIGNMENT
     ========================================================================== */
  .fg-header-{{ section.id }} {
    text-align: {{ section.settings.header_align_m }};
    margin-bottom: {{ section.settings.header_mb_m }}px;
  }

  @media screen and (min-width: 990px) {
    .fg-header-{{ section.id }} {
      text-align: {{ section.settings.header_align }};
      margin-bottom: {{ section.settings.header_mb_d }}px;
    }
  }

  .fg-title-{{ section.id }} {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_m }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: {{ section.settings.title_lh }};
    letter-spacing: {{ section.settings.title_ls }}px;
    margin: 0 0 {{ section.settings.title_mb_m }}px 0;
  }

  @media screen and (min-width: 990px) {
    .fg-title-{{ section.id }} {
      font-size: {{ section.settings.title_size_d }}px;
      margin-bottom: {{ section.settings.title_mb_d }}px;
    }
  }

  .fg-subtitle-{{ section.id }} {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size_m }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: {{ section.settings.subtitle_lh }};
    letter-spacing: {{ section.settings.subtitle_ls }}px;
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .fg-subtitle-{{ section.id }} {
      font-size: {{ section.settings.subtitle_size_d }}px;
    }
  }

  /* ==========================================================================
     3. GRID LAYOUT & COLUMNS
     ========================================================================== */
  .fg-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_m }}, 1fr);
    gap: {{ section.settings.gap_m }}px;
  }

  @media screen and (min-width: 990px) {
    .fg-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.cols_d }}, 1fr);
      gap: {{ section.settings.gap_d }}px;
    }
  }

  /* Overlay layout edge-to-edge ho sake, is ke liye container ki
     max width aur section ke side paddings ignore karne ka option */
  {%- if is_overlay and section.settings.overlay_full_bleed -%}
    #feature-grid-{{ section.id }} {
      padding-left: 0;
      padding-right: 0;
    }
    @media screen and (min-width: 990px) {
      #feature-grid-{{ section.id }} {
        padding-left: 0;
        padding-right: 0;
      }
    }
    .fg-container-{{ section.id }} { max-width: none; }
    .fg-header-{{ section.id }} {
      padding-left: {{ section.settings.pad_left_m }}px;
      padding-right: {{ section.settings.pad_right_m }}px;
    }
    @media screen and (min-width: 990px) {
      .fg-header-{{ section.id }} {
        padding-left: {{ section.settings.pad_left_d }}px;
        padding-right: {{ section.settings.pad_right_d }}px;
      }
    }
  {%- endif -%}

  /* ==========================================================================
     4. CARD CONTAINER & MEDIA STYLING
     ========================================================================== */
  .fg-card-{{ section.id }} {
    background-color: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    border: {{ section.settings.card_border_w }}px solid {{ section.settings.card_border_color }};
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if section.settings.enable_card_hover %}
    .fg-card-{{ section.id }}:hover {
      transform: translateY(-4px);
    }
  {% endif %}

  /* Card Image */
  .fg-card-media-{{ section.id }} {
    width: 100%;
    height: {{ section.settings.img_height_m }}px;
    overflow: hidden;
    border-radius: {{ section.settings.img_radius }}px;
    background-color: #f4f4f4;
  }

  @media screen and (min-width: 990px) {
    .fg-card-media-{{ section.id }} {
      height: {{ section.settings.img_height_d }}px;
    }
  }

  .fg-card-media-{{ section.id }} img,
  .fg-card-media-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.img_fit }};
    display: block;
    transition: transform 0.5s ease;
  }

  {% if section.settings.enable_img_zoom %}
    .fg-card-{{ section.id }}:hover .fg-card-media-{{ section.id }} img {
      transform: scale(1.04);
    }
  {% endif %}

  /* Card Content Padding */
  .fg-card-content-{{ section.id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    text-align: {{ section.settings.card_text_align_m }};
    align-items: {% if section.settings.card_text_align_m == 'center' %}center{% elsif section.settings.card_text_align_m == 'right' %}flex-end{% else %}flex-start{% endif %};
    padding-top: {{ section.settings.card_pad_top_m }}px;
    padding-bottom: {{ section.settings.card_pad_bottom_m }}px;
    padding-left: {{ section.settings.card_pad_left_m }}px;
    padding-right: {{ section.settings.card_pad_right_m }}px;
  }

  @media screen and (min-width: 990px) {
    .fg-card-content-{{ section.id }} {
      text-align: {{ section.settings.card_text_align }};
      align-items: {% if section.settings.card_text_align == 'center' %}center{% elsif section.settings.card_text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
      padding-top: {{ section.settings.card_pad_top_d }}px;
      padding-bottom: {{ section.settings.card_pad_bottom_d }}px;
      padding-left: {{ section.settings.card_pad_left_d }}px;
      padding-right: {{ section.settings.card_pad_right_d }}px;
    }
  }

  /* ==========================================================================
     4B. OVERLAY LAYOUT — text image ke UPAR
     ========================================================================== */
  {%- if is_overlay -%}
    .fg-card-{{ section.id }} {
      position: relative;
      background-color: transparent;
      border: 0;
      display: block;
    }

    .fg-card-{{ section.id }} .fg-card-media-{{ section.id }} {
      height: {{ section.settings.ov_img_height_m }}px;
      border-radius: {{ section.settings.card_radius }}px;
    }

    @media screen and (min-width: 990px) {
      .fg-card-{{ section.id }} .fg-card-media-{{ section.id }} {
        height: {{ section.settings.ov_img_height_d }}px;
      }
    }

    /* Gradient taake white text har image par padha ja sake */
    .fg-card-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: {{ section.settings.card_radius }}px;
      pointer-events: none;
      background: linear-gradient(
        to top,
        {{ section.settings.ov_scrim_color }} 0%,
        rgba(0, 0, 0, 0) {{ section.settings.ov_scrim_height }}%
      );
      opacity: {{ section.settings.ov_scrim_opacity | divided_by: 100.0 }};
    }

    .fg-card-{{ section.id }} .fg-card-content-{{ section.id }} {
      position: absolute;
      inset: auto 0 0 0;
      z-index: 2;
      flex-grow: 0;
      text-align: {{ section.settings.ov_text_align_m }};
      align-items: {% if section.settings.ov_text_align_m == 'center' %}center{% elsif section.settings.ov_text_align_m == 'right' %}flex-end{% else %}flex-start{% endif %};
      justify-content: flex-end;
      padding: {{ section.settings.ov_pad_m }}px;
    }

    @media screen and (min-width: 990px) {
      .fg-card-{{ section.id }} .fg-card-content-{{ section.id }} {
        text-align: {{ section.settings.ov_text_align_d }};
        align-items: {% if section.settings.ov_text_align_d == 'center' %}center{% elsif section.settings.ov_text_align_d == 'right' %}flex-end{% else %}flex-start{% endif %};
        padding: {{ section.settings.ov_pad_d }}px;
      }
    }

    .fg-card-{{ section.id }} .fg-card-title-{{ section.id }} {
      color: {{ section.settings.ov_title_color }};
      font-size: {{ section.settings.ov_title_size_m }}px;
      font-weight: {{ section.settings.ov_title_weight }};
      letter-spacing: {{ section.settings.ov_title_ls }}px;
      text-transform: {{ section.settings.ov_title_transform }};
      margin-bottom: {{ section.settings.ov_title_mb }}px;
    }

    @media screen and (min-width: 990px) {
      .fg-card-{{ section.id }} .fg-card-title-{{ section.id }} {
        font-size: {{ section.settings.ov_title_size_d }}px;
      }
    }

    .fg-card-{{ section.id }} .fg-card-desc-{{ section.id }} {
      color: {{ section.settings.ov_desc_color }};
      margin-bottom: {{ section.settings.ov_desc_mb }}px;
      max-width: {{ section.settings.ov_desc_max_w }}px;
    }

    {%- unless section.settings.ov_show_desc -%}
      .fg-card-{{ section.id }} .fg-card-desc-{{ section.id }} { display: none; }
    {%- endunless -%}

    .fg-card-{{ section.id }} .fg-card-link-{{ section.id }} {
      margin-top: 0;
      color: {{ section.settings.ov_link_color }};
      {% if section.settings.ov_link_underline %}
        text-decoration: underline;
        text-underline-offset: {{ section.settings.ov_link_underline_offset }}px;
        text-decoration-thickness: 1px;
      {% endif %}
    }

    .fg-card-{{ section.id }} .fg-card-link-{{ section.id }}:hover {
      color: {{ section.settings.ov_link_hover_color }};
    }
  {%- endif -%}

  /* ==========================================================================
     5. CARD TYPOGRAPHY & BUTTON STYLING
     ========================================================================== */
  .fg-card-title-{{ section.id }} {
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size_m }}px;
    font-weight: {{ section.settings.card_title_weight }};
    line-height: {{ section.settings.card_title_lh }};
    letter-spacing: {{ section.settings.card_title_ls }}px;
    margin: 0 0 {{ section.settings.card_title_mb_m }}px 0;
  }

  @media screen and (min-width: 990px) {
    .fg-card-title-{{ section.id }} {
      font-size: {{ section.settings.card_title_size_d }}px;
      margin-bottom: {{ section.settings.card_title_mb_d }}px;
    }
  }

  .fg-card-desc-{{ section.id }} {
    color: {{ section.settings.card_desc_color }};
    font-size: {{ section.settings.card_desc_size_m }}px;
    font-weight: {{ section.settings.card_desc_weight }};
    line-height: {{ section.settings.card_desc_lh }};
    margin-bottom: {{ section.settings.card_desc_mb_m }}px;
  }

  .fg-card-desc-{{ section.id }} p {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .fg-card-desc-{{ section.id }} {
      font-size: {{ section.settings.card_desc_size_d }}px;
      margin-bottom: {{ section.settings.card_desc_mb_d }}px;
    }
  }

  /* CTA Link & Arrow */
  .fg-card-link-{{ section.id }} {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.link_arrow_gap }}px;
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size_m }}px;
    font-weight: {{ section.settings.link_weight }};
    line-height: {{ section.settings.link_lh }};
    text-decoration: none;
    transition: color 0.3s ease;
    position: relative;
    z-index: 3;
  }

  .fg-card-link-{{ section.id }}:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .fg-card-link-{{ section.id }} svg {
    transition: transform 0.3s ease;
  }

  .fg-card-link-{{ section.id }}:hover svg {
    transform: translateX(4px);
  }

  @media screen and (min-width: 990px) {
    .fg-card-link-{{ section.id }} {
      font-size: {{ section.settings.link_size_d }}px;
    }
  }

  /* Poora card clickable ho to */
  .fg-card-cover-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
{%- endstyle -%}

<section class="feature-grid-section" id="feature-grid-{{ section.id }}">
  <div class="fg-container-{{ section.id }}">

    <!-- HEADER -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="fg-header-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="fg-title-{{ section.id }}">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="fg-subtitle-{{ section.id }}">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- CARDS GRID -->
    <div class="fg-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="fg-card-{{ section.id }}" {{ block.shopify_attributes }}>

          <!-- IMAGE -->
          <div class="fg-card-media-{{ section.id }}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1400 }}"
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 900 }} 900w,
                        {{ block.settings.image | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 990px) {{ 100 | divided_by: section.settings.cols_d }}vw, 100vw"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- comment -%}
            Overlay layout mein poora card clickable — link ke neeche
            rehta hai, is liye "Visit" link apna kaam karta rehta hai.
          {%- endcomment -%}
          {%- if is_overlay and section.settings.ov_card_clickable and block.settings.link_url != blank -%}
            <a
              href="{{ block.settings.link_url }}"
              class="fg-card-cover-{{ section.id }}"
              aria-label="{{ block.settings.title | escape }}"
            ></a>
          {%- endif -%}

          <!-- CARD CONTENT -->
          <div class="fg-card-content-{{ section.id }}">
            {%- if block.settings.title != blank -%}
              <h3 class="fg-card-title-{{ section.id }}">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="fg-card-desc-{{ section.id }}">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if block.settings.link_text != blank -%}
              <a href="{{ block.settings.link_url | default: '#' }}" class="fg-card-link-{{ section.id }}">
                <span>{{ block.settings.link_text }}</span>
                {%- if block.settings.show_arrow and is_overlay == false -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                {%- elsif block.settings.show_arrow and section.settings.ov_show_arrow -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Feature Cards Grid",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "0. CARD LAYOUT"
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Layout Style",
      "info": "Below image = text card ke neeche. Text over image = text image ke upar overlay.",
      "options": [
        { "value": "below", "label": "Text below image" },
        { "value": "overlay", "label": "Text over image" }
      ],
      "default": "below"
    },

    {
      "type": "header",
      "content": "0B. OVERLAY LAYOUT SETTINGS",
      "info": "Sirf 'Text over image' layout par lagti hain"
    },
    { "type": "checkbox", "id": "overlay_full_bleed", "label": "Full width edge to edge", "default": true },
    { "type": "checkbox", "id": "ov_card_clickable", "label": "Make whole card clickable", "default": true },
    { "type": "checkbox", "id": "ov_show_desc", "label": "Show description", "default": false },
    { "type": "checkbox", "id": "ov_show_arrow", "label": "Show arrow icon", "default": false },
    { "type": "range", "id": "ov_img_height_d", "min": 300, "max": 1000, "step": 10, "unit": "px", "label": "Image Height (Desktop)", "default": 700 },
    { "type": "range", "id": "ov_img_height_m", "min": 200, "max": 700, "step": 10, "unit": "px", "label": "Image Height (Mobile)", "default": 440 },
    { "type": "range", "id": "ov_pad_d", "min": 10, "max": 100, "step": 2, "unit": "px", "label": "Content Padding (Desktop)", "default": 46 },
    { "type": "range", "id": "ov_pad_m", "min": 10, "max": 60, "step": 2, "unit": "px", "label": "Content Padding (Mobile)", "default": 24 },
    { "type": "select", "id": "ov_text_align_d", "label": "Text Alignment (Desktop)", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "ov_text_align_m", "label": "Text Alignment (Mobile)", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },

    { "type": "color", "id": "ov_scrim_color", "label": "Gradient Color", "default": "#000000" },
    { "type": "range", "id": "ov_scrim_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Gradient Strength", "default": 55 },
    { "type": "range", "id": "ov_scrim_height", "min": 20, "max": 100, "step": 5, "unit": "%", "label": "Gradient Height", "default": 60 },

    { "type": "color", "id": "ov_title_color", "label": "Title Color", "default": "#FFFFFF" },
    { "type": "range", "id": "ov_title_size_d", "min": 16, "max": 60, "step": 1, "unit": "px", "label": "Title Size (Desktop)", "default": 32 },
    { "type": "range", "id": "ov_title_size_m", "min": 14, "max": 40, "step": 1, "unit": "px", "label": "Title Size (Mobile)", "default": 22 },
    { "type": "select", "id": "ov_title_weight", "label": "Title Weight", "options": [ { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "SemiBold" } ], "default": "300" },
    { "type": "range", "id": "ov_title_ls", "min": 0, "max": 10, "step": 0.5, "unit": "px", "label": "Title Letter Spacing", "default": 3 },
    { "type": "select", "id": "ov_title_transform", "label": "Title Case", "options": [ { "value": "none", "label": "As typed" }, { "value": "uppercase", "label": "UPPERCASE" }, { "value": "capitalize", "label": "Capitalize" } ], "default": "uppercase" },
    { "type": "range", "id": "ov_title_mb", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Space Below Title", "default": 14 },

