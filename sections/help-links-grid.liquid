<div
  data-section-id="{{ section.id }}"
  class="help-links-grid color-{{ section.settings.color_scheme }} {% if section.settings.full_width %}help-links-grid--full-width{% endif %}"
>
  <div class="help-links-grid__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="help-links-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div
      class="help-links-grid__grid"
      style="
        --hlg-columns-desktop: {{ section.settings.columns_desktop }};
        --hlg-columns-tablet: {{ section.settings.columns_tablet }};
        --hlg-columns-mobile: {{ section.settings.columns_mobile }};
        --hlg-gap: {{ section.settings.grid_gap }}px;
        --hlg-gap-mobile: {{ section.settings.grid_gap_mobile }}px;
      "
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div
            class="help-links-grid__card"
            {{ block.shopify_attributes }}
            style="
              --hlg-card-bg: {{ section.settings.card_bg }};
              --hlg-card-border-color: {{ section.settings.card_border_color }};
              --hlg-card-border-width: {{ section.settings.card_border_width }}px;
              --hlg-card-radius: {{ section.settings.card_border_radius }}px;
              --hlg-card-padding: {{ section.settings.card_padding }}px;
              --hlg-icon-color: {{ section.settings.icon_color }};
              --hlg-icon-size: {{ section.settings.icon_size }}px;
              --hlg-heading-color: {{ section.settings.card_heading_color }};
              --hlg-heading-size: {{ section.settings.card_heading_size }}px;
              --hlg-heading-weight: {{ section.settings.card_heading_weight }};
              --hlg-heading-letter-spacing: {{ section.settings.card_heading_letter_spacing }}px;
              --hlg-heading-transform: {{ section.settings.card_heading_transform }};
              --hlg-text-color: {{ section.settings.card_text_color }};
              --hlg-text-size: {{ section.settings.card_text_size }}px;
            "
          >
            {%- if block.settings.image != blank -%}
              <div class="help-links-grid__icon help-links-grid__icon--image">
                {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 64, 96' }}
              </div>
            {%- else -%}
              <div class="help-links-grid__icon">
                {%- case block.settings.icon -%}
                  {%- when 'mail' -%}{% render 'icon-envelope' %}
                  {%- when 'phone' -%}{% render 'icon-phone' %}
                  {%- when 'calendar' -%}{% render 'icon-calendar' %}
                  {%- when 'question' -%}{% render 'icon-question' %}
                  {%- when 'heart' -%}{% render 'icon-heart-outline' %}
                  {%- when 'pin' -%}{% render 'icon-pin' %}
                {%- endcase -%}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="help-links-grid__card-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="help-links-grid__card-text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  href="#"
                  aria-disabled="true"
                {% endif %}
                class="help-links-grid__button"
                style="
                  --hlg-btn-bg: {{ section.settings.button_bg }};
                  --hlg-btn-text: {{ section.settings.button_text_color }};
                  --hlg-btn-hover-bg: {{ section.settings.button_hover_bg }};
                  --hlg-btn-hover-text: {{ section.settings.button_hover_text_color }};
                  --hlg-btn-radius: {{ section.settings.button_border_radius }}px;
                  --hlg-btn-font-size: {{ section.settings.button_font_size }}px;
                  --hlg-btn-letter-spacing: {{ section.settings.button_letter_spacing }}px;
                  --hlg-btn-padding-v: {{ section.settings.button_padding_v }}px;
                  --hlg-btn-padding-h: {{ section.settings.button_padding_h }}px;
                "
              >
                <span>{{ block.settings.button_label }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  [data-section-id="{{ section.id }}"].help-links-grid {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding_mobile }}px;
    padding-right: {{ section.settings.side_padding_mobile }}px;
  }
  [data-section-id="{{ section.id }}"].help-links-grid--full-width .help-links-grid__inner {
    max-width: none;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__heading {
    text-align: center;
    margin: 0 0 3.2rem;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--hlg-columns-mobile), 1fr);
    gap: var(--hlg-gap-mobile);
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__card {
    background-color: var(--hlg-card-bg);
    border: var(--hlg-card-border-width) solid var(--hlg-card-border-color);
    border-radius: var(--hlg-card-radius);
    padding: var(--hlg-card-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__icon {
    width: var(--hlg-icon-size);
    height: var(--hlg-icon-size);
    color: var(--hlg-icon-color);
    margin-bottom: 1.6rem;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__icon svg {
    width: 100%;
    height: 100%;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__icon--image img {
    width: 100%;
    height: auto;
    display: block;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__card-heading {
    color: var(--hlg-heading-color);
    font-size: var(--hlg-heading-size);
    font-weight: var(--hlg-heading-weight);
    letter-spacing: var(--hlg-heading-letter-spacing);
    text-transform: var(--hlg-heading-transform);
    margin: 0 0 1.2rem;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__card-text {
    color: var(--hlg-text-color);
    font-size: var(--hlg-text-size);
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--hlg-btn-bg);
    color: var(--hlg-btn-text);
    border-radius: var(--hlg-btn-radius);
    font-size: var(--hlg-btn-font-size);
    letter-spacing: var(--hlg-btn-letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--hlg-btn-padding-v) var(--hlg-btn-padding-h);
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  [data-section-id="{{ section.id }}"] .help-links-grid__button:hover {
    background-color: var(--hlg-btn-hover-bg);
    color: var(--hlg-btn-hover-text);
  }

  @media screen and (min-width: 750px) {
    [data-section-id="{{ section.id }}"].help-links-grid {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    [data-section-id="{{ section.id }}"] .help-links-grid__inner {
      padding-left: {{ section.settings.side_padding }}px;
      padding-right: {{ section.settings.side_padding }}px;
    }
    [data-section-id="{{ section.id }}"] .help-links-grid__grid {
      grid-template-columns: repeat(var(--hlg-columns-tablet), 1fr);
      gap: var(--hlg-gap);
    }
  }

  @media screen and (min-width: 990px) {
    [data-section-id="{{ section.id }}"] .help-links-grid__grid {
      grid-template-columns: repeat(var(--hlg-columns-desktop), 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Help Links Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "CONTENT" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },

    { "type": "header", "content": "LAYOUT" },
    { "type": "checkbox", "id": "full_width", "label": "Full width (edge to edge)", "default": false },
    { "type": "range", "id": "content_max_width", "label": "Maximum content width (px)", "min": 900, "max": 1800, "step": 20, "default": 1400 },
    { "type": "range", "id": "side_padding", "label": "Side padding (desktop, px)", "min": 0, "max": 120, "step": 4, "default": 32 },
    { "type": "range", "id": "side_padding_mobile", "label": "Side padding (mobile, px)", "min": 0, "max": 60, "step": 2, "default": 16 },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns (tablet)",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    { "type": "range", "id": "grid_gap", "label": "Grid gap (desktop, px)", "min": 8, "max": 60, "step": 2, "default": 24 },
    { "type": "range", "id": "grid_gap_mobile", "label": "Grid gap (mobile, px)", "min": 8, "max": 40, "step": 2, "default": 16 },

    { "type": "header", "content": "CARD STYLE" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#f4f1ec" },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#0e0e0e" },
    { "type": "range", "id": "card_border_width", "label": "Card border width (px)", "min": 0, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "card_border_radius", "label": "Card border radius (px)", "min": 0, "max": 40, "step": 1, "default": 0 },
    { "type": "range", "id": "card_padding", "label": "Card padding (px)", "min": 16, "max": 80, "step": 2, "default": 48 },

    { "type": "header", "content": "ICON STYLE" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#0e0e0e" },
    { "type": "range", "id": "icon_size", "label": "Icon size (px)", "min": 20, "max": 56, "step": 2, "default": 32 },

    { "type": "header", "content": "CARD TYPOGRAPHY" },
    { "type": "color", "id": "card_heading_color", "label": "Heading color", "default": "#0e0e0e" },
    { "type": "range", "id": "card_heading_size", "label": "Heading size (px)", "min": 14, "max": 28, "step": 1, "default": 18 },
    {
      "type": "select",
      "id": "card_heading_weight",
      "label": "Heading weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "card_heading_letter_spacing", "label": "Heading letter spacing (px)", "min": 0, "max": 4, "step": 0.1, "default": 1.5 },
    {
      "type": "select",
      "id": "card_heading_transform",
      "label": "Heading text transform",
      "default": "uppercase",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },
    { "type": "color", "id": "card_text_color", "label": "Description color", "default": "#4d4d4d" },
    { "type": "range", "id": "card_text_size", "label": "Description size (px)", "min": 12, "max": 20, "step": 1, "default": 14 },

    { "type": "header", "content": "BUTTON STYLE" },
    { "type": "color", "id": "button_bg", "label": "Background", "default": "#2c1015" },
    { "type": "color", "id": "button_text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_bg", "label": "Hover background", "default": "#43181f" },
    { "type": "color", "id": "button_hover_text_color", "label": "Hover text color", "default": "#ffffff" },
    { "type": "range", "id": "button_border_radius", "label": "Border radius (px)", "min": 0, "max": 40, "step": 1, "default": 0 },
    { "type": "range", "id": "button_font_size", "label": "Font size (px)", "min": 10, "max": 18, "step": 1, "default": 12 },
    { "type": "range", "id": "button_letter_spacing", "label": "Letter spacing (px)", "min": 0, "max": 3, "step": 0.1, "default": 1 },
    { "type": "range", "id": "button_padding_v", "label": "Padding vertical (px)", "min": 8, "max": 24, "step": 1, "default": 14 },
    { "type": "range", "id": "button_padding_h", "label": "Padding horizontal (px)", "min": 16, "max": 48, "step": 1, "default": 28 },

    { "type": "header", "content": "COLORS" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" }
      ]
    },

    { "type": "header", "content": "SPACING" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop, px)", "min": 0, "max": 160, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop, px)", "min": 0, "max": 160, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile, px)", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile, px)", "min": 0, "max": 120, "step": 4, "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "mail",
          "options": [
            { "value": "mail", "label": "Envelope" },
            { "value": "phone", "label": "Phone" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "question", "label": "Question mark" },
            { "value": "heart", "label": "Heart" },
            { "value": "pin", "label": "Location pin" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon image (overrides icon above)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Email Us" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Be guided by our experts." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Email Us" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help Links Grid",
      "blocks": [
        { "type": "card", "settings": { "icon": "mail", "heading": "Email Us", "text": "Be guided by our experts.", "button_label": "Email Us" } },
        { "type": "card", "settings": { "icon": "phone", "heading": "Call Us", "text": "For urgent support, give us a call.", "button_label": "Call Us" } },
        { "type": "card", "settings": { "icon": "calendar", "heading": "Book an Appointment", "text": "Discover a consultation with us, in-boutique or online.", "button_label": "Bookings" } },
        { "type": "card", "settings": { "icon": "question", "heading": "FAQs", "text": "We're here to help your journey feel seamless.", "button_label": "FAQs" } },
        { "type": "card", "settings": { "icon": "heart", "heading": "Lifetime Warranty", "text": "Forever, and a day. Learn about our Lifetime Warranty.", "button_label": "Lifetime Warranty" } },
        { "type": "card", "settings": { "icon": "pin", "heading": "Our Showrooms", "text": "Step into our world and begin designing your dream piece.", "button_label": "Our Showrooms" } }
      ]
    }
  ]
}
{% endschema %}
