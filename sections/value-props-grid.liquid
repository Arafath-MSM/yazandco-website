{% comment %}
  Section: Value Proposition / Feature Icons Grid
  Design: Desktop 5-in-row / Mobile responsive wrapped layout (Brilliant Earth Style)
  Customization: 100% Dynamic Schema Settings (Desktop & Mobile independent controls)
{% endcomment %}

<style>
  .value-props-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    
    /* Desktop Spacing */
    padding-top: {{ section.settings.padding_top_d }}px;
    padding-bottom: {{ section.settings.padding_bottom_d }}px;
    padding-left: {{ section.settings.padding_left_d }}px;
    padding-right: {{ section.settings.padding_right_d }}px;
  }

  @media (max-width: 768px) {
    .value-props-{{ section.id }} {
      /* Mobile Spacing */
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
      padding-left: {{ section.settings.padding_left_m }}px;
      padding-right: {{ section.settings.padding_right_m }}px;
    }
  }

  .value-props-heading-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_d }}px;
    font-weight: {{ section.settings.heading_weight_d }};
    text-align: {{ section.settings.heading_align }};
    margin-top: 0;
    margin-bottom: {{ section.settings.heading_mb_d }}px;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .value-props-heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_m }}px;
      font-weight: {{ section.settings.heading_weight_m }};
      margin-bottom: {{ section.settings.heading_mb_m }}px;
    }
  }

  .value-props-wrapper-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: {{ section.settings.gap_d }}px;
  }

  @media (max-width: 768px) {
    .value-props-wrapper-{{ section.id }} {
      gap: {{ section.settings.gap_m }}px;
    }
  }

  .value-props-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* Desktop Column calculation */
    width: calc((100% - ({{ section.settings.gap_d }}px * ({{ section.settings.items_per_row_d }} - 1))) / {{ section.settings.items_per_row_d }});
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .value-props-item-{{ section.id }} {
      /* Mobile Column calculation */
      width: calc((100% - ({{ section.settings.gap_m }}px * ({{ section.settings.items_per_row_m }} - 1))) / {{ section.settings.items_per_row_m }});
    }
  }

  /* Icon Outer Circle Styling */
  .value-props-icon-wrap-{{ section.id }} {
    width: {{ section.settings.icon_size_d }}px;
    height: {{ section.settings.icon_size_d }}px;
    border-radius: {{ section.settings.icon_radius }}%;
    background-color: {{ section.settings.icon_bg }};
    border: {{ section.settings.icon_border_width }}px solid {{ section.settings.icon_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ section.settings.icon_mb_d }}px;
    box-shadow: {{ section.settings.icon_shadow }};
    transition: all 0.3s ease;
  }

  @media (max-width: 768px) {
    .value-props-icon-wrap-{{ section.id }} {
      width: {{ section.settings.icon_size_m }}px;
      height: {{ section.settings.icon_size_m }}px;
      margin-bottom: {{ section.settings.icon_mb_m }}px;
    }
  }

  .value-props-icon-wrap-{{ section.id }} img {
    width: {{ section.settings.svg_inner_size }}%;
    height: {{ section.settings.svg_inner_size }}%;
    object-fit: contain;
  }

  .value-props-icon-wrap-{{ section.id }} svg {
    width: {{ section.settings.svg_inner_size }}%;
    height: {{ section.settings.svg_inner_size }}%;
    fill: {{ section.settings.icon_svg_color }};
    stroke: {{ section.settings.icon_svg_color }};
  }

  /* Item Title / Text Styling */
  .value-props-title-{{ section.id }} {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_d }}px;
    font-weight: {{ section.settings.text_weight_d }};
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    margin: 0;
    line-height: 1.35;
  }

  @media (max-width: 768px) {
    .value-props-title-{{ section.id }} {
      font-size: {{ section.settings.text_size_m }}px;
      font-weight: {{ section.settings.text_weight_m }};
    }
  }
</style>

<div class="value-props-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="value-props-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="value-props-wrapper-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="value-props-item-{{ section.id }}" {{ block.shopify_attributes }}>
        <div class="value-props-icon-wrap-{{ section.id }}">
          {% if block.settings.custom_svg != blank %}
            {{ block.settings.custom_svg }}
          {% elsif block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 200 }}" 
              alt="{{ block.settings.title | escape }}" 
              loading="lazy"
              width="100"
              height="100"
            >
          {% else %}
            {% comment %} Default SVG Icon Placeholder {% endcomment %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="9"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          {% endif %}
        </div>

        {% if block.settings.title != blank %}
          <p class="value-props-title-{{ section.id }}">{{ block.settings.title }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Value Props Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "We've Got You Covered"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size_d",
      "min": 16, "max": 60, "step": 1, "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "min": 14, "max": 40, "step": 1, "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight_d",
      "label": "Heading Font Weight (Desktop)",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "heading_weight_m",
      "label": "Heading Font Weight (Mobile)",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_mb_d",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "label": "Heading Margin Bottom (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_mb_m",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "label": "Heading Margin Bottom (Mobile)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Grid & Column Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800, "max": 1600, "step": 20, "unit": "px",
      "label": "Container Max Width",
      "default": 1300
    },
    {
      "type": "range",
      "id": "items_per_row_d",
      "min": 2, "max": 6, "step": 1,
      "label": "Items Per Row (Desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "items_per_row_m",
      "min": 1, "max": 4, "step": 1,
      "label": "Items Per Row (Mobile)",
      "default": 3
    },
    {
      "type": "range",
      "id": "gap_d",
      "min": 10, "max": 60, "step": 2, "unit": "px",
      "label": "Gap Between Items (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_m",
      "min": 8, "max": 40, "step": 2, "unit": "px",
      "label": "Gap Between Items (Mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Icon Circle Styling"
    },
    {
      "type": "range",
      "id": "icon_size_d",
      "min": 40, "max": 120, "step": 2, "unit": "px",
      "label": "Icon Circle Size (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "icon_size_m",
      "min": 30, "max": 90, "step": 2, "unit": "px",
      "label": "Icon Circle Size (Mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "svg_inner_size",
      "min": 30, "max": 80, "step": 5, "unit": "%",
      "label": "Inner Icon Size Ratio",
      "default": 55
    },
    {
      "type": "range",
      "id": "icon_radius",
      "min": 0, "max": 50, "step": 1, "unit": "%",
      "label": "Icon Circle Border Radius (50% = Round)",
      "default": 50
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background Color",
      "default": "#1B3B3A"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon Border Color",
      "default": "#2C5452"
    },
    {
      "type": "range",
      "id": "icon_border_width",
      "min": 0, "max": 6, "step": 1, "unit": "px",
      "label": "Icon Border Width",
      "default": 1
    },
    {
      "type": "color",
      "id": "icon_svg_color",
      "label": "Icon SVG/Line Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "icon_shadow",
      "label": "Icon Shadow Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "0 4px 10px rgba(0,0,0,0.15)", "label": "Soft Shadow" },
        { "value": "0 8px 20px rgba(0,0,0,0.25)", "label": "Deep Shadow" },
        { "value": "inset 0 2px 4px rgba(255,255,255,0.2)", "label": "Glassmorphism Glow" }
      ],
      "default": "0 8px 20px rgba(0,0,0,0.25)"
    },
    {
      "type": "range",
      "id": "icon_mb_d",
      "min": 0, "max": 30, "step": 1, "unit": "px",
      "label": "Icon Margin Bottom (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_mb_m",
      "min": 0, "max": 20, "step": 1, "unit": "px",
      "label": "Icon Margin Bottom (Mobile)",
      "default": 10
    },
    {
      "type": "header",
      "content": "Item Text Styling"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "text_size_d",
      "min": 10, "max": 24, "step": 1, "unit": "px",
      "label": "Text Font Size (Desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size_m",
      "min": 9, "max": 20, "step": 1, "unit": "px",
      "label": "Text Font Size (Mobile)",
      "default": 11
    },
    {
      "type": "select",
      "id": "text_weight_d",
      "label": "Text Font Weight (Desktop)",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_weight_m",
      "label": "Text Font Weight (Mobile)",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "none", "label": "Normal Case" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0, "max": 4, "step": 0.5, "unit": "px",
      "label": "Letter Spacing",
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Section Background & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#163939"
    },
    {
      "type": "range",
      "id": "padding_top_d",
      "min": 0, "max": 120, "step": 2, "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_d",
      "min": 0, "max": 120, "step": 2, "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_left_d",
      "min": 0, "max": 100, "step": 2, "unit": "px",
      "label": "Padding Left (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_right_d",
      "min": 0, "max": 100, "step": 2, "unit": "px",
      "label": "Padding Right (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0, "max": 80, "step": 2, "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_m",
      "min": 0, "max": 50, "step": 2, "unit": "px",
      "label": "Padding Left (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_right_m",
      "min": 0, "max": 50, "step": 2, "unit": "px",
      "label": "Padding Right (Mobile)",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Value Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code",
          "info": "Paste raw <svg> code here to override image picker."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Label",
          "default": "Free Shipping & Returns"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Props Grid",
      "blocks": [
        { "type": "value_item", "settings": { "title": "FREE SHIPPING & RETURNS" } },
        { "type": "value_item", "settings": { "title": "FREE LIFETIME WARRANTY" } },
        { "type": "value_item", "settings": { "title": "24/7 CUSTOMER SUPPORT" } },
        { "type": "value_item", "settings": { "title": "LIFETIME DIAMOND UPGRADE" } },
        { "type": "value_item", "settings": { "title": "FREE 1-YEAR RESIZING" } }
      ]
    }
  ]
}
{% endschema %}