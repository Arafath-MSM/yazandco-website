{% comment %}
  Section: Shop Diamonds / Products by Shape
  Features: Desktop Layout + Smooth Touch Horizontal Scroll on Mobile
  Customization: 100% Dynamic Settings (Mobile & Desktop independent controls)
{% endcomment %}

<style>
  .shop-shape-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    
    /* Desktop Spacing */
    padding-top: {{ section.settings.padding_top_d }}px;
    padding-bottom: {{ section.settings.padding_bottom_d }}px;
    padding-left: {{ section.settings.padding_left_d }}px;
    padding-right: {{ section.settings.padding_right_d }}px;
  }

  @media (max-width: 768px) {
    .shop-shape-{{ section.id }} {
      /* Mobile Spacing */
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
      padding-left: {{ section.settings.padding_left_m }}px;
      padding-right: {{ section.settings.padding_right_m }}px;
    }
  }

  .shop-shape-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: {{ section.settings.layout_gap_d }}px;
  }

  @media (max-width: 768px) {
    .shop-shape-container-{{ section.id }} {
      flex-direction: column;
      align-items: stretch;
      gap: {{ section.settings.layout_gap_m }}px;
    }
  }

  /* Left Header & Featured Image Area */
  .shop-shape-left-{{ section.id }} {
    flex: 0 0 {{ section.settings.featured_width_d }}%;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.heading_align_d }};
    text-align: {{ section.settings.heading_align_d }};
  }

  @media (max-width: 768px) {
    .shop-shape-left-{{ section.id }} {
      flex: 1 1 100%;
      align-items: {{ section.settings.heading_align_m }};
      text-align: {{ section.settings.heading_align_m }};
    }
  }

  .shop-shape-heading-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_d }}px;
    font-weight: {{ section.settings.heading_weight_d }};
    margin-top: 0;
    margin-bottom: {{ section.settings.heading_mb_d }}px;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .shop-shape-heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_m }}px;
      font-weight: {{ section.settings.heading_weight_m }};
      margin-bottom: {{ section.settings.heading_mb_m }}px;
    }
  }

  .shop-shape-featured-img-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.featured_img_max_w }}px;
    height: auto;
    object-fit: contain;
  }

  {% if section.settings.hide_featured_mobile %}
    @media (max-width: 768px) {
      .shop-shape-featured-img-{{ section.id }} {
        display: none;
      }
    }
  {% endif %}

  /* Shapes Grid (Desktop 2-Rows / Mobile Smooth Horizontal Scroll) */
  .shop-shape-grid-{{ section.id }} {
    flex: 1;
    display: grid;
    grid-template-columns: repeat({{ section.settings.items_per_row_d }}, 1fr);
    gap: {{ section.settings.grid_gap_d }}px;
  }

  @media (max-width: 768px) {
    .shop-shape-grid-{{ section.id }} {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      gap: {{ section.settings.grid_gap_m }}px;
      padding-bottom: 10px;
      margin-right: -{{ section.settings.padding_right_m }}px;
      padding-right: {{ section.settings.padding_right_m }}px;
      
      /* Hide Scrollbar */
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .shop-shape-grid-{{ section.id }}::-webkit-scrollbar {
      display: none;
    }
  }

  /* Single Shape Item */
  .shop-shape-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .shop-shape-item-{{ section.id }}:hover {
    transform: translateY(-4px);
  }

  @media (max-width: 768px) {
    .shop-shape-item-{{ section.id }} {
      flex: 0 0 {{ section.settings.item_width_m }}px;
      scroll-snap-align: start;
    }
  }

  /* Image Box inside Item */
  .shop-shape-img-box-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.icon_size_d }}px;
    height: {{ section.settings.icon_size_d }}px;
    background-color: {{ section.settings.card_bg }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ section.settings.item_title_mt_d }}px;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .shop-shape-img-box-{{ section.id }} {
      max-width: {{ section.settings.icon_size_m }}px;
      height: {{ section.settings.icon_size_m }}px;
      margin-bottom: {{ section.settings.item_title_mt_m }}px;
    }
  }

  .shop-shape-img-box-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Item Title Styling */
  .shop-shape-title-{{ section.id }} {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_d }}px;
    font-weight: {{ section.settings.text_weight_d }};
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    margin: 0;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .shop-shape-title-{{ section.id }} {
      font-size: {{ section.settings.text_size_m }}px;
      font-weight: {{ section.settings.text_weight_m }};
    }
  }
</style>

<div class="shop-shape-{{ section.id }}">
  <div class="shop-shape-container-{{ section.id }}">
    
    {% comment %} Left Side: Heading & Featured Image {% endcomment %}
    <div class="shop-shape-left-{{ section.id }}">
      {% if section.settings.heading != blank %}
        <h2 class="shop-shape-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.featured_image != blank %}
        <img 
          class="shop-shape-featured-img-{{ section.id }}"
          src="{{ section.settings.featured_image | image_url: width: 600 }}" 
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="300"
          height="300"
        >
      {% endif %}
    </div>

    {% comment %} Right Side: Diamond Shapes Grid/Carousel {% endcomment %}
    <div class="shop-shape-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <a 
          href="{{ block.settings.link | default: '#' }}" 
          class="shop-shape-item-{{ section.id }}" 
          {{ block.shopify_attributes }}
        >
          <div class="shop-shape-img-box-{{ section.id }}">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 300 }}" 
                alt="{{ block.settings.title | escape }}" 
                loading="lazy"
                width="120"
                height="120"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <p class="shop-shape-title-{{ section.id }}">{{ block.settings.title }}</p>
          {% endif %}
        </a>
      {% endfor %}
    </div>

  </div>
</div>

