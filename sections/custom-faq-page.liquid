{%- style -%}
  /* ==========================================================================
     SECTION & CONTAINER (DYNAMIC PADDING & COLORS)
     ========================================================================== */
  #faq-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.pad_top_m }}px;
    padding-bottom: {{ section.settings.pad_bottom_m }}px;
    padding-left: {{ section.settings.pad_left_m }}px;
    padding-right: {{ section.settings.pad_right_m }}px;
  }

  @media screen and (min-width: 990px) {
    #faq-section-{{ section.id }} {
      padding-top: {{ section.settings.pad_top_d }}px;
      padding-bottom: {{ section.settings.pad_bottom_d }}px;
      padding-left: {{ section.settings.pad_left_d }}px;
      padding-right: {{ section.settings.pad_right_d }}px;
    }
  }

  .faq-container-{{ section.id }} {
    max-width: {{ section.settings.container_max_w }}px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap_m }}px;
  }

  @media screen and (min-width: 990px) {
    .faq-container-{{ section.id }} {
      display: grid;
      grid-template-columns: {{ section.settings.left_col_w }}px 1fr;
      gap: {{ section.settings.gap_d }}px;
      align-items: start;
    }
  }

  /* ==========================================================================
     LEFT SIDEBAR (STICKY NAV & MAIN TITLE)
     ========================================================================== */
  .faq-sidebar-{{ section.id }} {
    position: relative;
  }

  @media screen and (min-width: 990px) {
    .faq-sidebar-{{ section.id }} {
      position: sticky;
      top: {{ section.settings.sticky_top }}px;
      z-index: 2;
    }
  }

  .faq-main-title-{{ section.id }} {
    color: {{ section.settings.main_title_color }};
    font-size: {{ section.settings.main_title_size_m }}px;
    font-weight: {{ section.settings.main_title_weight }};
    text-transform: {{ section.settings.main_title_transform }};
    letter-spacing: {{ section.settings.main_title_ls }}px;
    margin: 0 0 {{ section.settings.main_title_mb }}px 0;
    line-height: 1.1;
  }

  @media screen and (min-width: 990px) {
    .faq-main-title-{{ section.id }} {
      font-size: {{ section.settings.main_title_size_d }}px;
    }
  }

  .faq-nav-list-{{ section.id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.nav_gap }}px;
  }

  .faq-nav-link-{{ section.id }} {
    color: {{ section.settings.nav_color }};
    font-size: {{ section.settings.nav_size_m }}px;
    font-weight: {{ section.settings.nav_weight }};
    text-transform: {{ section.settings.nav_transform }};
    letter-spacing: {{ section.settings.nav_ls }}px;
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  @media screen and (min-width: 990px) {
    .faq-nav-link-{{ section.id }} {
      font-size: {{ section.settings.nav_size_d }}px;
    }
  }

  .faq-nav-link-{{ section.id }}:hover,
  .faq-nav-link-{{ section.id }}.is-active {
    color: {{ section.settings.nav_active_color }};
  }

  /* ==========================================================================
     RIGHT CONTENT (CATEGORIES & ACCORDIONS)
     ========================================================================== */
  .faq-cat-group-{{ section.id }} {
    margin-bottom: {{ section.settings.cat_group_mb }}px;
    scroll-margin-top: {{ section.settings.sticky_top }}px;
  }

  .faq-cat-title-{{ section.id }} {
    color: {{ section.settings.cat_title_color }};
    font-size: {{ section.settings.cat_title_size_m }}px;
    font-weight: {{ section.settings.cat_title_weight }};
    text-transform: {{ section.settings.cat_title_transform }};
    letter-spacing: {{ section.settings.cat_title_ls }}px;
    margin: 0 0 {{ section.settings.cat_title_mb }}px 0;
  }

  @media screen and (min-width: 990px) {
    .faq-cat-title-{{ section.id }} {
      font-size: {{ section.settings.cat_title_size_d }}px;
    }
  }

  .faq-cat-desc-{{ section.id }} {
    color: {{ section.settings.cat_desc_color }};
    font-size: {{ section.settings.cat_desc_size_m }}px;
    font-weight: {{ section.settings.cat_desc_weight }};
    line-height: {{ section.settings.cat_desc_lh }};
    margin-bottom: {{ section.settings.cat_desc_mb }}px;
  }

  @media screen and (min-width: 990px) {
    .faq-cat-desc-{{ section.id }} {
      font-size: {{ section.settings.cat_desc_size_d }}px;
    }
  }

  /* ACCORDION ITEMS */
  .faq-accordion-item-{{ section.id }} {
    background-color: {{ section.settings.acc_bg }};
    border-top: {{ section.settings.acc_border_thickness }}px solid {{ section.settings.acc_border_color }};
    border-bottom: {{ section.settings.acc_border_thickness }}px solid {{ section.settings.acc_border_color }};
    border-radius: {{ section.settings.acc_radius }}px;
    margin-top: -{{ section.settings.acc_border_thickness }}px;
  }

  .faq-accordion-btn-{{ section.id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    padding-top: {{ section.settings.acc_btn_pad_top }}px;
    padding-bottom: {{ section.settings.acc_btn_pad_bottom }}px;
    padding-left: {{ section.settings.acc_btn_pad_left }}px;
    padding-right: {{ section.settings.acc_btn_pad_right }}px;
    color: {{ section.settings.acc_q_color }};
    font-size: {{ section.settings.acc_q_size_m }}px;
    font-weight: {{ section.settings.acc_q_weight }};
    letter-spacing: {{ section.settings.acc_q_ls }}px;
    transition: color 0.2s ease;
  }

  @media screen and (min-width: 990px) {
    .faq-accordion-btn-{{ section.id }} {
      font-size: {{ section.settings.acc_q_size_d }}px;
    }
  }

  .faq-accordion-btn-{{ section.id }}:hover {
    color: {{ section.settings.acc_q_hover_color }};
  }

  .faq-icon-{{ section.id }} {
    font-size: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
    font-weight: 300;
    transition: transform 0.3s ease;
    line-height: 1;
    margin-left: 15px;
  }

  .faq-accordion-item-{{ section.id }}.is-open .faq-icon-{{ section.id }} {
    transform: rotate(45deg);
  }

  .faq-accordion-body-{{ section.id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer-inner-{{ section.id }} {
    padding-top: {{ section.settings.acc_ans_pad_top }}px;
    padding-bottom: {{ section.settings.acc_ans_pad_bottom }}px;
    padding-left: {{ section.settings.acc_ans_pad_left }}px;
    padding-right: {{ section.settings.acc_ans_pad_right }}px;
    color: {{ section.settings.acc_ans_color }};
    font-size: {{ section.settings.acc_ans_size_m }}px;
    font-weight: {{ section.settings.acc_ans_weight }};
    line-height: {{ section.settings.acc_ans_lh }};
  }

  @media screen and (min-width: 990px) {
    .faq-answer-inner-{{ section.id }} {
      font-size: {{ section.settings.acc_ans_size_d }}px;
    }
  }
{%- endstyle -%}

<section class="faq-section-{{ section.id }}" id="faq-section-{{ section.id }}">
  <div class="faq-container-{{ section.id }}">
    
    <!-- LEFT SIDEBAR -->
    <div class="faq-sidebar-{{ section.id }}">
      {%- if section.settings.main_title != blank -%}
        <h1 class="faq-main-title-{{ section.id }}">{{ section.settings.main_title }}</h1>
      {%- endif -%}

      <ul class="faq-nav-list-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <li>
              <a href="#faq-cat-{{ block.id }}" class="faq-nav-link-{{ section.id }} {% if forloop.first %}is-active{% endif %}">
                {{ block.settings.title }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <!-- RIGHT CONTENT -->
    <div class="faq-content-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'category' -%}
            <div class="faq-cat-group-{{ section.id }}" id="faq-cat-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="faq-cat-title-{{ section.id }}">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="faq-cat-desc-{{ section.id }}">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}
            </div>

          {%- when 'faq_item' -%}
            <div class="faq-accordion-item-{{ section.id }}" {{ block.shopify_attributes }}>
              <button type="button" class="faq-accordion-btn-{{ section.id }}">
                <span>{{ block.settings.question }}</span>
                <span class="faq-icon-{{ section.id }}">+</span>
              </button>
              <div class="faq-accordion-body-{{ section.id }}">
                <div class="faq-answer-inner-{{ section.id }}">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const container = document.getElementById(`faq-section-${sectionId}`);
    if (!container) return;

    // Accordion Toggle
    const accButtons = container.querySelectorAll(`.faq-accordion-btn-${sectionId}`);
    accButtons.forEach(btn => {
      btn.addEventListener('click', function () {
        const item = this.parentElement;
        const body = item.querySelector(`.faq-accordion-body-${sectionId}`);
        
        if (item.classList.contains('is-open')) {
          item.classList.remove('is-open');
          body.style.maxHeight = null;
        } else {
          item.classList.add('is-open');
          body.style.maxHeight = body.scrollHeight + "px";
        }
      });
    });

    // Active Link Scroll Highlight
    const navLinks = container.querySelectorAll(`.faq-nav-link-${sectionId}`);
    navLinks.forEach(link => {
      link.addEventListener('click', function (e) {
        navLinks.forEach(l => l.classList.remove('is-active'));
        this.classList.add('is-active');
      });
    });
  });
</script>

