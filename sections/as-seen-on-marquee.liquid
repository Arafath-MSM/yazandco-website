{% comment %} {%- comment -%}
  "As Seen On" collage marquee (Strathberry style):
  - Staggered images (different sizes + vertical offsets) in a slow, continuous
    auto-scrolling track (desktop + mobile).
  - Click an image to enlarge it and reveal its caption; marquee pauses while
    an image is enlarged. Click again (or outside / Escape) to collapse.
{%- endcomment -%}

{% liquid
  assign sid = section.id
  assign speed = section.settings.scroll_speed
  assign gap = section.settings.item_gap
%}

<div
  id="asn-{{ sid }}"
  class="asn color-{{ section.settings.color_scheme }}"
  style="
    --asn-speed: {{ speed }}s;
    --asn-gap: {{ gap }}px;
    --asn-base-h: {{ section.settings.image_height }}px;
    --asn-radius: {{ section.settings.image_border_radius }}px;
  "
>
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="asn__head">
      {% if section.settings.heading != blank %}
        <h2 class="asn__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="asn__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="asn__viewport" data-asn-viewport>
    <div class="asn__track" data-asn-track>
      {% for copy in (1..2) %}
        <div class="asn__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {% for block in section.blocks %}
            <figure
              class="asn__item asn__item--{{ block.settings.size }}"
              style="--asn-offset: {{ block.settings.offset }}px;"
              data-asn-item
              tabindex="0"
              role="button"
              aria-label="{{ block.settings.caption | default: 'Image' | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="asn__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 900',
                      style: 'aspect-ratio:' | append: block.settings.image.aspect_ratio
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'asn__placeholder' }}
                {% endif %}
              </div>
              {% if block.settings.caption != blank %}
                <figcaption class="asn__caption">{{ block.settings.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  #asn-{{ sid }} {
    overflow: hidden;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #asn-{{ sid }} .asn__head {
    text-align: center;
    padding-inline: 20px;
    margin-bottom: 56px;
  }

  #asn-{{ sid }} .asn__title {
    margin: 0 0 20px;
  }

  #asn-{{ sid }} .asn__subtitle {
    margin: 0;
    opacity: 0.85;
  }

  #asn-{{ sid }} .asn__viewport {
    width: 100%;
  }

  #asn-{{ sid }} .asn__track {
    display: flex;
    width: max-content;
    animation: asn-marquee-{{ sid }} var(--asn-speed) linear infinite;
  }

  #asn-{{ sid }} .asn__group {
    display: flex;
    align-items: flex-start;
    gap: var(--asn-gap);
    padding-inline-end: var(--asn-gap);
    /* offsets neeche bhi ja sakte hain, is liye thori vertical room */
    padding-block: 70px;
  }

  @keyframes asn-marquee-{{ sid }} {
    to {
      transform: translateX(-50%);
    }
  }

  /* Expanded state ya hover par marquee rok do */
  #asn-{{ sid }}.asn--paused .asn__track {
    animation-play-state: paused;
  }

  {% if section.settings.pause_on_hover %}
    @media (hover: hover) {
      #asn-{{ sid }} .asn__viewport:hover .asn__track {
        animation-play-state: paused;
      }
    }
  {% endif %}

  #asn-{{ sid }} .asn__item {
    margin: 0;
    flex-shrink: 0;
    cursor: pointer;
    transform: translateY(var(--asn-offset));
    transition: transform 0.5s ease;
    outline-offset: 4px;
  }

  #asn-{{ sid }} .asn__media {
    height: var(--asn-item-h);
    transition: height 0.5s ease;
  }

  #asn-{{ sid }} .asn__media img,
  #asn-{{ sid }} .asn__media svg {
    height: 100%;
    width: auto;
    max-width: none;
    display: block;
    object-fit: cover;
    border-radius: var(--asn-radius);
  }

  #asn-{{ sid }} .asn__item--small  { --asn-item-h: calc(var(--asn-base-h) * 0.72); }
  #asn-{{ sid }} .asn__item--medium { --asn-item-h: var(--asn-base-h); }
  #asn-{{ sid }} .asn__item--large  { --asn-item-h: calc(var(--asn-base-h) * 1.22); }

  /* Click par bara version */
  #asn-{{ sid }} .asn__item.is-expanded { --asn-item-h: calc(var(--asn-base-h) * 1.45); }
  #asn-{{ sid }} .asn__item.is-expanded { transform: translateY(calc(var(--asn-offset) * 0.4)); }

  #asn-{{ sid }} .asn__caption {
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-top: 14px;
    opacity: 0;
    transition: opacity 0.4s ease 0.15s;
  }

  #asn-{{ sid }} .asn__item.is-expanded .asn__caption {
    opacity: 1;
  }

  #asn-{{ sid }} .asn__placeholder {
    width: auto;
    background: rgb(0 0 0 / 0.06);
  }

  @media screen and (max-width: 749px) {
    #asn-{{ sid }} {
      --asn-base-h: {{ section.settings.image_height | times: 0.62 | round }}px;
      --asn-gap: {{ gap | times: 0.6 | round }}px;
    }

    #asn-{{ sid }} .asn__head {
      margin-bottom: 32px;
    }

    #asn-{{ sid }} .asn__group {
      padding-block: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #asn-{{ sid }} .asn__track {
      animation: none;
    }
    #asn-{{ sid }} .asn__viewport {
      overflow-x: auto;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('asn-{{ sid }}');
    if (!root || root.__asnInit) return;
    root.__asnInit = true;

    function collapseAll() {
      root.querySelectorAll('.asn__item.is-expanded').forEach(function (el) {
        el.classList.remove('is-expanded');
      });
      root.classList.remove('asn--paused');
    }

    root.addEventListener('click', function (e) {
      var item = e.target.closest('[data-asn-item]');
      if (!item) return;
      var wasExpanded = item.classList.contains('is-expanded');
      collapseAll();
      if (!wasExpanded) {
        item.classList.add('is-expanded');
        root.classList.add('asn--paused');
      }
    });

    root.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        var item = e.target.closest('[data-asn-item]');
        if (item) {
          e.preventDefault();
          item.click();
        }
      }
    });

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) collapseAll();
    });

