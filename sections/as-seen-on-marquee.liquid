      "label": "Scroll duration (lower = faster)",
      "min": 20,
      "max": 160,
      "step": 5,
      "unit": "s",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover (desktop)",
      "default": true
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Base image height (desktop)",
      "min": 240,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (shows when enlarged)",
          "info": "e.g. OLIVIA PALERMO"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        },
        {
          "type": "range",
          "id": "offset",
          "label": "Vertical offset",
          "min": -70,
          "max": 70,
          "step": 5,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen On marquee",
      "blocks": [
        { "type": "image", "settings": { "size": "large", "offset": -40 } },
        { "type": "image", "settings": { "size": "small", "offset": 30 } },
        { "type": "image", "settings": { "size": "medium", "offset": -10 } },
        { "type": "image", "settings": { "size": "small", "offset": 45 } },
        { "type": "image", "settings": { "size": "large", "offset": -30 } },
        { "type": "image", "settings": { "size": "medium", "offset": 20 } }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}



