  height:
    var(--asn-item-h);

  transition:
    height 0.5s ease;
}


/* ===============================
   IMAGE
================================ */

#asn-{{ sid }} .asn__media img,

#asn-{{ sid }} .asn__media svg {
  display: block;

  width: auto;

  height: 100%;

  max-width: none;

  object-fit: cover;

  border-radius:
    var(--asn-radius);
}


/* ===============================
   IMAGE SIZES
================================ */

#asn-{{ sid }}
.asn__item--small {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 0.72
    );
}


#asn-{{ sid }}
.asn__item--medium {
  --asn-item-h:
    var(--asn-base-h);
}


#asn-{{ sid }}
.asn__item--large {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 1.22
    );
}


/* ===============================
   EXPANDED
================================ */

#asn-{{ sid }}
.asn__item.is-expanded {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 1.45
    );

  transform:
    translateY(
      calc(
        var(--asn-offset) * 0.4
      )
    );
}


/* ===============================
   HOVER
================================ */

@media (hover: hover) {

  #asn-{{ sid }}
  .asn__item:hover {

    --asn-item-h:
      calc(
        var(--asn-base-h) * 1.45
      );

    transform:
      translateY(
        calc(
          var(--asn-offset) * 0.4
        )
      );
  }


  #asn-{{ sid }}
  .asn__item:hover
  .asn__caption {
    opacity: 1;
  }

}


/* ===============================
   CAPTION
================================ */

#asn-{{ sid }} .asn__caption {
  padding-top: 14px;

  text-align: center;

  font-size: 13px;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  opacity: 0;

  transition:
    opacity
    0.4s
    ease
    0.15s;
}


#asn-{{ sid }}
.asn__item.is-expanded
.asn__caption {
  opacity: 1;
}


/* ===============================
   PLACEHOLDER
================================ */

#asn-{{ sid }} .asn__placeholder {
  width: auto;

  background:
    rgb(0 0 0 / 0.06);
}


/* ===============================
   MARQUEE ANIMATION
================================ */

@keyframes asn-marquee-{{ sid }} {

  from {
    transform:
      translate3d(
        0,
        0,
        0
      );
  }

  to {
    transform:
      translate3d(
        calc(
          -1 * var(--asn-loop-width)
        ),
        0,
        0
      );
  }

}


/* ===============================
   PAUSE ON HOVER
================================ */

{% if section.settings.pause_on_hover %}

@media (hover: hover) {

  #asn-{{ sid }}
  .asn__viewport:hover
  .asn__track {
    animation-play-state: paused;
  }

}

{% endif %}


/* ===============================
   MOBILE
================================ */

@media screen and (max-width: 749px) {

  #asn-{{ sid }} {

    --asn-base-h:
      {{ section.settings.image_height | times: 0.62 | round }}px;

    --asn-gap:
      {{ gap | times: 0.6 | round }}px;

    --asn-overlap:
      {{ section.settings.item_overlap | times: 0.6 | round }}px;

  }


  #asn-{{ sid }}
  .asn__head {
    margin-bottom: 32px;
  }


  #asn-{{ sid }}
  .asn__group {
    padding-block: 44px;
  }

}


/* ===============================
   REDUCED MOTION
================================ */

@media (prefers-reduced-motion: reduce) {

  #asn-{{ sid }}
  .asn__track {
    animation: none;
  }


  #asn-{{ sid }}
  .asn__scroller {
    transform: none !important;
  }


  #asn-{{ sid }}
  .asn__viewport {
    overflow-x: auto;
  }

}


{% endstyle %}



<script>
(function () {

  var root =
    document.getElementById(
      'asn-{{ sid }}'
    );


  if (!root) return;


  if (root.__asnInit) return;


  root.__asnInit = true;



  /* ==================================
     ELEMENTS
  ================================== */

  var track =
    root.querySelector(
      '[data-asn-track]'
    );


  var firstGroup =
    root.querySelector(
      '[data-asn-group]'
    );


  var scroller =
    root.querySelector(
      '[data-asn-scroller]'
    );


  if (!track || !firstGroup) {
    return;
  }



  /* ==================================
     SCROLL SETTINGS
  ================================== */

  var scrollEnabled =
    {% if section.settings.enable_scroll_move %}true{% else %}false{% endif %};


  var scrollPower =
    {{ section.settings.scroll_power }};


  var scrollSmooth =
    {{ section.settings.scroll_smoothness | divided_by: 100.0 }};


  var reduceMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;


  var loopWidth = 0;

  var lastY = window.pageYOffset;

  var targetShift = 0;

  var currentShift = 0;

  var rafId = null;



  /* ==================================
     EXACT LOOP WIDTH
  ================================== */

  function setLoopWidth() {

    if (!firstGroup) return;


    var rect =
      firstGroup
        .getBoundingClientRect();


    var width =
      rect.width;


    if (!width || width <= 0) {
      return;
    }


    loopWidth = width;


    track.style.setProperty(
      '--asn-loop-width',
      width + 'px'
    );


    root.classList.add(
      'asn--ready'
    );

  }



  /* ==================================
     INITIAL MEASURE
  ================================== */

  requestAnimationFrame(
    function () {

      requestAnimationFrame(
        setLoopWidth
      );

    }
  );



  /* ==================================
     WINDOW LOAD
  ================================== */

  window.addEventListener(
    'load',
    setLoopWidth
  );



  /* ==================================
     RESIZE
  ================================== */

  var resizeTimer;


  window.addEventListener(
    'resize',
    function () {

      clearTimeout(
        resizeTimer
      );


      resizeTimer =
        setTimeout(
          setLoopWidth,
          100
        );

    }
  );



  /* ==================================
     IMAGE LOAD
  ================================== */

  root
    .querySelectorAll('img')
    .forEach(
      function (img) {

        if (!img.complete) {

          img.addEventListener(
            'load',
            setLoopWidth,
            {
              once: true
            }
          );

        }

      }
    );



  /* ==================================
     FONTS
  ================================== */

  if (
    document.fonts &&
    document.fonts.ready
  ) {

    document.fonts.ready.then(
      setLoopWidth
    );

  }



  /* ==================================
     RESIZE OBSERVER
  ================================== */

  if (
    typeof ResizeObserver !==
    'undefined'
  ) {

    var observer =
      new ResizeObserver(
        function () {

          setLoopWidth();

        }
      );


    observer.observe(
      firstGroup
    );

  }



  /* ==================================
     COLLAPSE
  ================================== */

  function collapseAll() {

    root
      .querySelectorAll(
        '.asn__item.is-expanded'
      )
      .forEach(
        function (item) {

          item.classList.remove(
            'is-expanded'
          );

        }
      );


    root.classList.remove(
      'asn--paused'
    );

  }



  /* ==================================
     CLICK
  ================================== */

  root.addEventListener(
    'click',
    function (event) {

      var item =
        event.target.closest(
          '[data-asn-item]'
        );


      if (!item) return;


      /*
        Duplicate copies click
        interaction nahi karengi.
      */

      var group =
        item.closest(
          '[data-asn-group]'
        );


      if (
        group !== firstGroup
      ) {
        return;
      }


      var wasExpanded =
        item.classList.contains(
          'is-expanded'
        );


      collapseAll();


      if (!wasExpanded) {

        item.classList.add(
          'is-expanded'
        );


        root.classList.add(
          'asn--paused'
        );

      }

    }
  );



  /* ==================================
     KEYBOARD
  ================================== */

  root.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Enter' ||
        event.key === ' '
      ) {

        var item =
          event.target.closest(
            '[data-asn-item]'
          );


        if (!item) return;


        event.preventDefault();


        item.click();

      }

    }
  );



  /* ==================================
     CLICK OUTSIDE
  ================================== */

  document.addEventListener(
    'click',
    function (event) {

      if (
        !root.contains(
          event.target
        )
      ) {

        collapseAll();

      }

    }
  );



  /* ==================================
     ESCAPE
  ================================== */

  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape'
      ) {

        collapseAll();

      }

    }
  );



  /* ==================================
     SCROLL DRIVEN MOVEMENT

     Page scroll ki delta targetShift
     mein jama hoti hai, phir rAF loop
     usko smoothly follow karta hai.
     Shift ko loop width se modulo kiya
     hai, is liye kitna bhi scroll karo
     strip kabhi khatam nahi hoti.
  ================================== */

  function tick() {

    currentShift +=
      (targetShift - currentShift) *
      scrollSmooth;


    if (
      Math.abs(
        targetShift - currentShift
      ) < 0.15
    ) {

      currentShift = targetShift;

    }


    var shift = 0;


    if (loopWidth > 0) {

      shift =
        (
          (currentShift % loopWidth) +
          loopWidth
        ) % loopWidth;

    } else {

      shift = currentShift;

    }


    scroller.style.transform =
      'translate3d(' +
      (-shift) +
      'px, 0, 0)';


    if (currentShift !== targetShift) {

      rafId =
        requestAnimationFrame(tick);

    } else {

      rafId = null;


      /*
        Numbers ko chhota rakhne ke liye
        wrapped value par reset kar dete
        hain. Visually kuch nahi badalta.
      */

      if (loopWidth > 0) {

        currentShift = shift;

        targetShift = shift;

      }

    }

  }



  if (
    scrollEnabled &&
    scroller &&
    !reduceMotion
  ) {

    window.addEventListener(
      'scroll',
      function () {

        var y = window.pageYOffset;

        var delta = y - lastY;

        lastY = y;


        targetShift +=
          delta * scrollPower;


        if (!rafId) {

          rafId =
            requestAnimationFrame(tick);

        }

      },
      {
        passive: true
      }
    );

  }


})();
</script>



