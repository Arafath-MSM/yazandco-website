{% style %}


/* ===============================
   MAIN SECTION
================================ */

#asn-{{ sid }} {
  overflow: hidden;

  padding-block:
    {{ section.settings.padding_top }}px
    {{ section.settings.padding_bottom }}px;
}


/* ===============================
   HEADING
================================ */

#asn-{{ sid }} .asn__head {
  text-align: center;

  padding-inline: 20px;

  margin-bottom: 56px;
}


#asn-{{ sid }} .asn__title {
  margin: 0 0 20px;
}


#asn-{{ sid }} .asn__subtitle {
  margin: 0;

  opacity: 0.85;
}


/* ===============================
   VIEWPORT
================================ */

#asn-{{ sid }} .asn__viewport {
  position: relative;

  width: 100%;

  overflow: hidden;
}


/* ===============================
   TRACK
================================ */

#asn-{{ sid }} .asn__track {
  display: flex;

  align-items: flex-start;

  width: max-content;

  gap: 0;

  will-change: transform;

  animation:
    asn-marquee-{{ sid }}
    var(--asn-speed)
    linear
    infinite;

  /*
    JS exact group width milne tak
    animation start nahi hogi.
  */
  animation-play-state: paused;
}


#asn-{{ sid }}.asn--ready .asn__track {
  animation-play-state: running;
}


/* User click se pause */

#asn-{{ sid }}.asn--paused .asn__track {
  animation-play-state: paused;
}


/* ===============================
   EACH COPY / GROUP
================================ */

#asn-{{ sid }} .asn__group {
  display: flex;

  align-items: flex-start;

  flex: 0 0 auto;

  flex-shrink: 0;

  padding-block: 70px;
}


/* ===============================
   ITEMS
================================ */

#asn-{{ sid }} .asn__item {
  position: relative;

  flex: 0 0 auto;

  flex-shrink: 0;

  margin-block: 0;

  margin-inline-start: 0;

  margin-inline-end:
    calc(
      var(--asn-gap)
      - var(--asn-overlap)
    );

  cursor: pointer;

  transform:
    translateY(
      var(--asn-offset)
    );

  transition:
    transform 0.5s ease;

  outline-offset: 4px;

  z-index: 1;
}


/* ===============================
   LAYERING
================================ */

#asn-{{ sid }}
.asn__group
.asn__item:nth-child(even) {
  z-index: 2;
}


#asn-{{ sid }}
.asn__item.is-expanded,

#asn-{{ sid }}
.asn__item:hover {
  z-index: 5;
}


/* ===============================
   IMAGE HOLDER
================================ */

#asn-{{ sid }} .asn__media {
  height:
    var(--asn-item-h);

  transition:
    height 0.5s ease;
}


/* ===============================
   IMAGE
================================ */

#asn-{{ sid }} .asn__media img,

#asn-{{ sid }} .asn__media svg {
  display: block;

  width: auto;

  height: 100%;

  max-width: none;

  object-fit: cover;

  border-radius:
    var(--asn-radius);
}


/* ===============================
   IMAGE SIZES
================================ */

#asn-{{ sid }}
.asn__item--small {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 0.72
    );
}


#asn-{{ sid }}
.asn__item--medium {
  --asn-item-h:
    var(--asn-base-h);
}


#asn-{{ sid }}
.asn__item--large {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 1.22
    );
}


/* ===============================
   EXPANDED
================================ */

#asn-{{ sid }}
.asn__item.is-expanded {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 1.45
    );

  transform:
    translateY(
      calc(
        var(--asn-offset) * 0.4
      )
    );
}


/* ===============================
   HOVER
================================ */

@media (hover: hover) {

  #asn-{{ sid }}
  .asn__item:hover {

    --asn-item-h:
      calc(
        var(--asn-base-h) * 1.45
      );

    transform:
      translateY(
        calc(
          var(--asn-offset) * 0.4
        )
      );
  }


  #asn-{{ sid }}
  .asn__item:hover
  .asn__caption {
    opacity: 1;
  }

}


/* ===============================
   CAPTION
================================ */

#asn-{{ sid }} .asn__caption {
  padding-top: 14px;

  text-align: center;

  font-size: 13px;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  opacity: 0;

  transition:
    opacity
    0.4s
    ease
    0.15s;
}


#asn-{{ sid }}
.asn__item.is-expanded
.asn__caption {
  opacity: 1;
}


/* ===============================
   PLACEHOLDER
================================ */

#asn-{{ sid }} .asn__placeholder {
  width: auto;

  background:
    rgb(0 0 0 / 0.06);
}


/* ===============================
   MARQUEE ANIMATION
================================ */

@keyframes asn-marquee-{{ sid }} {

  from {
    transform:
      translate3d(
        0,
        0,
        0
      );
  }

  to {
    transform:
      translate3d(
        calc(
          -1 * var(--asn-loop-width)
        ),
        0,
        0
      );
  }

}


/* ===============================
   PAUSE ON HOVER
================================ */

{% if section.settings.pause_on_hover %}

@media (hover: hover) {

  #asn-{{ sid }}
  .asn__viewport:hover
  .asn__track {
    animation-play-state: paused;
  }

}

{% endif %}


/* ===============================
   MOBILE
================================ */

@media screen and (max-width: 749px) {

  #asn-{{ sid }} {

    --asn-base-h:
      {{ section.settings.image_height | times: 0.62 | round }}px;

    --asn-gap:
      {{ gap | times: 0.6 | round }}px;

    --asn-overlap:
      {{ section.settings.item_overlap | times: 0.6 | round }}px;

  }


  #asn-{{ sid }}
  .asn__head {
    margin-bottom: 32px;
  }


  #asn-{{ sid }}
  .asn__group {
    padding-block: 44px;
  }

}


/* ===============================
   REDUCED MOTION
================================ */

@media (prefers-reduced-motion: reduce) {

  #asn-{{ sid }}
  .asn__track {
    animation: none;
  }


  #asn-{{ sid }}
  .asn__viewport {
    overflow-x: auto;
  }

}


{% endstyle %}



<script>
(function () {

  var root =
    document.getElementById(
      'asn-{{ sid }}'
    );


  if (!root) return;


  if (root.__asnInit) return;


  root.__asnInit = true;



  /* ==================================
     ELEMENTS
  ================================== */

  var track =
    root.querySelector(
      '[data-asn-track]'
    );


  var firstGroup =
    root.querySelector(
      '[data-asn-group]'
    );


  if (!track || !firstGroup) {
    return;
  }



  /* ==================================
     EXACT LOOP WIDTH
  ================================== */

  function setLoopWidth() {

    if (!firstGroup) return;


    var rect =
      firstGroup
        .getBoundingClientRect();


    var width =
      rect.width;


    if (!width || width <= 0) {
      return;
    }


    track.style.setProperty(
      '--asn-loop-width',
      width + 'px'
    );


    root.classList.add(
      'asn--ready'
    );

  }



  /* ==================================
     INITIAL MEASURE
  ================================== */

  requestAnimationFrame(
    function () {

      requestAnimationFrame(
        setLoopWidth
      );

    }
  );



  /* ==================================
     WINDOW LOAD
  ================================== */

  window.addEventListener(
    'load',
    setLoopWidth
  );



  /* ==================================
     RESIZE
  ================================== */

  var resizeTimer;


  window.addEventListener(
    'resize',
    function () {

      clearTimeout(
        resizeTimer
      );


      resizeTimer =
        setTimeout(
          setLoopWidth,
          100
        );

    }
  );



  /* ==================================
     IMAGE LOAD
  ================================== */

  root
    .querySelectorAll('img')
    .forEach(
      function (img) {

        if (!img.complete) {

          img.addEventListener(
            'load',
            setLoopWidth,
            {
              once: true
            }
          );

        }

      }
    );



  /* ==================================
     FONTS
  ================================== */

  if (
    document.fonts &&
    document.fonts.ready
  ) {

    document.fonts.ready.then(
      setLoopWidth
    );

  }



  /* ==================================
     RESIZE OBSERVER
  ================================== */

  if (
    typeof ResizeObserver !==
    'undefined'
  ) {

    var observer =
      new ResizeObserver(
        function () {

          setLoopWidth();

        }
      );


    observer.observe(
      firstGroup
    );

  }



  /* ==================================
     COLLAPSE
  ================================== */

  function collapseAll() {

    root
      .querySelectorAll(
        '.asn__item.is-expanded'
      )
      .forEach(
        function (item) {

          item.classList.remove(
            'is-expanded'
          );

        }
      );


    root.classList.remove(
      'asn--paused'
    );

  }



  /* ==================================
     CLICK
  ================================== */

  root.addEventListener(
    'click',
    function (event) {

      var item =
        event.target.closest(
          '[data-asn-item]'
        );


      if (!item) return;


      /*
        Duplicate copies click
        interaction nahi karengi.
      */

      var group =
        item.closest(
          '[data-asn-group]'
        );


      if (
        group !== firstGroup
      ) {
        return;
      }


      var wasExpanded =
        item.classList.contains(
          'is-expanded'
        );


      collapseAll();


      if (!wasExpanded) {

        item.classList.add(
          'is-expanded'
        );


        root.classList.add(
          'asn--paused'
        );

      }

    }
  );



  /* ==================================
     KEYBOARD
  ================================== */

  root.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Enter' ||
        event.key === ' '
      ) {

        var item =
          event.target.closest(
            '[data-asn-item]'
          );


        if (!item) return;


        event.preventDefault();


        item.click();

      }

    }
  );



  /* ==================================
     CLICK OUTSIDE
  ================================== */

  document.addEventListener(
    'click',
    function (event) {

      if (
        !root.contains(
          event.target
        )
      ) {

        collapseAll();

      }

    }
  );



  /* ==================================
     ESCAPE
  ================================== */

  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape'
      ) {

        collapseAll();

      }

    }
  );


})();
</script>



{% schema %}
{
  "name": "As Seen On marquee",
  "tag": "section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen On"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how our community is styling their favourite designs..."
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "primary"
    },

    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll duration (lower = faster)",
      "min": 20,
      "max": 160,
      "step": 5,
      "unit": "s",
      "default": 80
    },

    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover (desktop)",
      "default": true
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Base image height (desktop)",
      "min": 240,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 400
    },

    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },

    {
      "type": "range",
      "id": "item_overlap",
      "label": "Image overlap",
      "info": "Gap se zyada hoga to images aik dusri ke oper aayengi (collage)",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 90
    },

    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }

  ],

  "blocks": [

    {
      "type": "image",
      "name": "Image",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "caption",
          "label": "Caption (shows when enlarged)",
          "info": "e.g. OLIVIA PALERMO"
        },

        {
          "type": "select",
          "id": "size",
          "label": "Size",

          "options": [

            {
              "value": "small",
              "label": "Small"
            },

            {
              "value": "medium",
              "label": "Medium"
            },

            {
              "value": "large",
              "label": "Large"
            }

          ],

          "default": "medium"
        },

        {
          "type": "range",
          "id": "offset",
          "label": "Vertical offset",
          "min": -100,
          "max": 100,
          "step": 5,
          "unit": "px",
          "default": 0
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "As Seen On marquee",

      "blocks": [

        {
          "type": "image",
          "settings": {
            "size": "large",
            "offset": -40
          }
        },

        {
          "type": "image",
          "settings": {
            "size": "small",
            "offset": 30
          }
        },

        {
          "type": "image",
          "settings": {
            "size": "medium",
            "offset": -10
          }
        },

        {
          "type": "image",
          "settings": {
            "size": "small",
            "offset": 45
          }
        },

        {
          "type": "image",
          "settings": {
            "size": "large",
            "offset": -30
          }
        },

        {
          "type": "image",
          "settings": {
            "size": "medium",
            "offset": 20
          }
        }

      ]
    }

  ]
}
