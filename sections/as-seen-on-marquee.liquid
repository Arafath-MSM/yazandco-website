{% style %}


/* ===============================
   MAIN SECTION
================================ */

#asn-{{ sid }} {
  overflow: hidden;

  padding-block:
    {{ section.settings.padding_top }}px
    {{ section.settings.padding_bottom }}px;
}


/* ===============================
   HEADING
================================ */

#asn-{{ sid }} .asn__head {
  text-align: center;

  padding-inline: 20px;

  margin-bottom: 56px;
}


#asn-{{ sid }} .asn__title {
  margin: 0 0 20px;
}


#asn-{{ sid }} .asn__subtitle {
  margin: 0;

  opacity: 0.85;
}


/* ===============================
   VIEWPORT
================================ */

#asn-{{ sid }} .asn__viewport {
  position: relative;

  width: 100%;

  overflow: hidden;

  cursor: grab;

  touch-action: pan-y;
}

#asn-{{ sid }} .asn__viewport.is-dragging {
  cursor: grabbing;
  user-select: none;
}


/* ===============================
   TRACK
   (position/transform is driven by JS so mouse-wheel and
   drag can interrupt/scrub the auto-scroll in real time)
================================ */

#asn-{{ sid }} .asn__track {
  display: flex;

  align-items: flex-start;

  width: max-content;

  gap: 0;

  will-change: transform;
}


/* ===============================
   EACH COPY / GROUP
================================ */

#asn-{{ sid }} .asn__group {
  display: flex;

  align-items: flex-start;

  flex: 0 0 auto;

  flex-shrink: 0;

  padding-block: 70px;
}


/* ===============================
   ITEMS
================================ */

#asn-{{ sid }} .asn__item {
  position: relative;

  flex: 0 0 auto;

  flex-shrink: 0;

  margin-block: 0;

  margin-inline-start: 0;

  margin-inline-end:
    calc(
      var(--asn-gap)
      - var(--asn-overlap)
    );

  cursor: pointer;

  transform:
    translateY(
      var(--asn-offset)
    );

  transition:
    transform 0.5s ease;

  outline-offset: 4px;

  z-index: 1;
}


/* ===============================
   LAYERING
================================ */

#asn-{{ sid }}
.asn__group
.asn__item:nth-child(even) {
  z-index: 2;
}


#asn-{{ sid }}
.asn__item.is-expanded,

#asn-{{ sid }}
.asn__item:hover {
  z-index: 5;
}


/* ===============================
   IMAGE HOLDER
================================ */

#asn-{{ sid }} .asn__media {
  height:
    var(--asn-item-h);

  transition:
    height 0.5s ease;
}


/* ===============================
   IMAGE
================================ */

#asn-{{ sid }} .asn__media img,

#asn-{{ sid }} .asn__media svg {
  display: block;

  width: auto;

  height: 100%;

  max-width: none;

  object-fit: cover;

  border-radius:
    var(--asn-radius);
}


/* ===============================
   IMAGE SIZES
================================ */

#asn-{{ sid }}
.asn__item--small {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 0.72
    );
}


#asn-{{ sid }}
.asn__item--medium {
  --asn-item-h:
    var(--asn-base-h);
}


#asn-{{ sid }}
.asn__item--large {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 1.22
    );
}


/* ===============================
   EXPANDED
================================ */

#asn-{{ sid }}
.asn__item.is-expanded {
  --asn-item-h:
    calc(
      var(--asn-base-h) * 1.45
    );

  transform:
    translateY(
      calc(
        var(--asn-offset) * 0.4
      )
    );
}


/* ===============================
   HOVER
================================ */

@media (hover: hover) {

  #asn-{{ sid }}
  .asn__item:hover {

    --asn-item-h:
      calc(
        var(--asn-base-h) * 1.45
      );

    transform:
      translateY(
        calc(
          var(--asn-offset) * 0.4
        )
      );
  }


  #asn-{{ sid }}
  .asn__item:hover
  .asn__caption {
    opacity: 1;
  }

}


/* ===============================
   CAPTION
================================ */

#asn-{{ sid }} .asn__caption {
  padding-top: 14px;

  text-align: center;

  font-size: 13px;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  opacity: 0;

  transition:
    opacity
    0.4s
    ease
    0.15s;
}


#asn-{{ sid }}
.asn__item.is-expanded
.asn__caption {
  opacity: 1;
}


/* ===============================
   PLACEHOLDER
================================ */

#asn-{{ sid }} .asn__placeholder {
  width: auto;

  background:
    rgb(0 0 0 / 0.06);
}


/* ===============================
   MARQUEE ANIMATION
================================ */

/* ===============================
   MOBILE
================================ */

@media screen and (max-width: 749px) {

  #asn-{{ sid }} {

    --asn-base-h:
      {{ section.settings.image_height | times: 0.62 | round }}px;

    --asn-gap:
      {{ gap | times: 0.6 | round }}px;

    --asn-overlap:
      {{ section.settings.item_overlap | times: 0.6 | round }}px;

  }


  #asn-{{ sid }}
  .asn__head {
    margin-bottom: 32px;
  }


  #asn-{{ sid }}
  .asn__group {
    padding-block: 44px;
  }

}


/* ===============================
   REDUCED MOTION
================================ */

@media (prefers-reduced-motion: reduce) {

  #asn-{{ sid }}
  .asn__track {
    animation: none;
  }


  #asn-{{ sid }}
  .asn__viewport {
    overflow-x: auto;
  }

}


{% endstyle %}



<script>
(function () {

  var root =
    document.getElementById(
      'asn-{{ sid }}'
    );


  if (!root) return;


  if (root.__asnInit) return;


  root.__asnInit = true;



  /* ==================================
     ELEMENTS
  ================================== */

  var track =
    root.querySelector(
      '[data-asn-track]'
    );


  var firstGroup =
    root.querySelector(
      '[data-asn-group]'
    );


  var viewport =
    root.querySelector(
      '[data-asn-viewport]'
    );


  if (!track || !firstGroup || !viewport) {
    return;
  }


  var reducedMotion =
    window.matchMedia &&
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;


  /*
    Manual scroll state.
    `position` = px se kitna track left move hua hai.
    Wheel/drag isko seedha badal dete hain, taake user
    turant kisi bhi image tak "jump" kar sake bina
    poora auto-scroll cycle wait kiye.
  */
  var position = 0;
  var loopWidth = 0;
  var speedSeconds = {{ speed | default: 80 }};
  var pauseOnHover = {{ section.settings.pause_on_hover | json }};
  var isHoverPaused = false;
  var isDragging = false;
  var dragStartX = 0;
  var dragStartPosition = 0;
  var dragMoved = 0;
  var lastTimestamp = null;



  /* ==================================
     EXACT LOOP WIDTH
  ================================== */

  function setLoopWidth() {

    if (!firstGroup) return;


    var rect =
      firstGroup
        .getBoundingClientRect();


    var width =
      rect.width;


    if (!width || width <= 0) {
      return;
    }


    loopWidth = width;


    root.classList.add(
      'asn--ready'
    );

  }



  /* ==================================
     INITIAL MEASURE
  ================================== */

  requestAnimationFrame(
    function () {

      requestAnimationFrame(
        setLoopWidth
      );

    }
  );



  /* ==================================
     WINDOW LOAD
  ================================== */

  window.addEventListener(
    'load',
    setLoopWidth
  );



  /* ==================================
     RESIZE
  ================================== */

  var resizeTimer;


  window.addEventListener(
    'resize',
    function () {

      clearTimeout(
        resizeTimer
      );


      resizeTimer =
        setTimeout(
          setLoopWidth,
          100
        );

    }
  );



  /* ==================================
     IMAGE LOAD
  ================================== */

  root
    .querySelectorAll('img')
    .forEach(
      function (img) {

        if (!img.complete) {

          img.addEventListener(
            'load',
            setLoopWidth,
            {
              once: true
            }
          );

        }

      }
    );



  /* ==================================
     FONTS
  ================================== */

  if (
    document.fonts &&
    document.fonts.ready
  ) {

    document.fonts.ready.then(
      setLoopWidth
    );

  }



  /* ==================================
     RESIZE OBSERVER
  ================================== */

  if (
    typeof ResizeObserver !==
    'undefined'
  ) {

    var observer =
      new ResizeObserver(
        function () {

          setLoopWidth();

        }
      );


    observer.observe(
      firstGroup
    );

  }



  /* ==================================
     COLLAPSE
  ================================== */

  function collapseAll() {

    root
      .querySelectorAll(
        '.asn__item.is-expanded'
      )
      .forEach(
        function (item) {

          item.classList.remove(
            'is-expanded'
          );

        }
      );


    root.classList.remove(
      'asn--paused'
    );

  }



  /* ==================================
     RENDER LOOP
     JS transform update — CSS keyframes
     ki jagah, taake wheel/drag se turant
     interrupt/scrub ho sake.
  ================================== */

  function wrapPosition() {

    if (loopWidth > 0) {

      position =
        ((position % loopWidth) + loopWidth) % loopWidth;

    }

  }


  function frame(timestamp) {

    if (lastTimestamp === null) {
      lastTimestamp = timestamp;
    }

    var dt = timestamp - lastTimestamp;
    lastTimestamp = timestamp;

    var isPaused =
      isDragging ||
      isHoverPaused ||
      root.classList.contains('asn--paused');

    if (!isPaused && loopWidth > 0 && speedSeconds > 0) {

      var pxPerMs =
        loopWidth / (speedSeconds * 1000);

      position += pxPerMs * dt;

    }

    wrapPosition();

    track.style.transform =
      'translate3d(' + (-position) + 'px, 0, 0)';

    requestAnimationFrame(frame);

  }


  if (!reducedMotion) {
    requestAnimationFrame(frame);
  }



  /* ==================================
     PAUSE ON HOVER (desktop only)
  ================================== */

  if (pauseOnHover) {

    var hoverCapable =
      window.matchMedia &&
      window.matchMedia('(hover: hover)').matches;

    if (hoverCapable) {

      viewport.addEventListener(
        'mouseenter',
        function () {
          isHoverPaused = true;
        }
      );

      viewport.addEventListener(
        'mouseleave',
        function () {
          isHoverPaused = false;
        }
      );

    }

  }



  /* ==================================
     MOUSE WHEEL SCROLL
     Normal vertical wheel bhi marquee ko
     horizontally scroll kar deta hai, taake
     user jaldi se pehli image tak pahunch sake.
  ================================== */

  if (!reducedMotion) {

    viewport.addEventListener(
      'wheel',
      function (event) {

        var delta =
          Math.abs(event.deltaX) > Math.abs(event.deltaY)
            ? event.deltaX
            : event.deltaY;

        if (!delta) return;

        event.preventDefault();

        position += delta;
        wrapPosition();

      },
      { passive: false }
    );

  }



  /* ==================================
     DRAG TO SCROLL
     Mouse ya touch se pakar kar kisi bhi
     image tak seedha kheench sakte hain.
  ================================== */

  if (!reducedMotion) {

    viewport.addEventListener(
      'pointerdown',
      function (event) {

        if (event.button != null && event.button !== 0) return;

        isDragging = true;
        dragMoved = 0;
        dragStartX = event.clientX;
        dragStartPosition = position;

        viewport.classList.add('is-dragging');

        if (viewport.setPointerCapture) {
          viewport.setPointerCapture(event.pointerId);
        }

      }
    );

    viewport.addEventListener(
      'pointermove',
      function (event) {

        if (!isDragging) return;

        var dx = event.clientX - dragStartX;

        dragMoved = Math.max(dragMoved, Math.abs(dx));

        position = dragStartPosition - dx;

        wrapPosition();

      }
    );

    function endDrag() {

      if (!isDragging) return;

      isDragging = false;

      viewport.classList.remove('is-dragging');

    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('pointerleave', endDrag);

  }



  /* ==================================
     CLICK
  ================================== */

  root.addEventListener(
    'click',
    function (event) {

      /*
        Drag ke baad accidental click-to-expand
        na ho.
      */
      if (dragMoved > 5) {
        dragMoved = 0;
        return;
      }

      var item =
        event.target.closest(
          '[data-asn-item]'
        );


      if (!item) return;


      /*
        Duplicate copies click
        interaction nahi karengi.
      */

      var group =
        item.closest(
          '[data-asn-group]'
        );


      if (
        group !== firstGroup
      ) {
        return;
      }


      var wasExpanded =
        item.classList.contains(
          'is-expanded'
        );


      collapseAll();


      if (!wasExpanded) {

        item.classList.add(
          'is-expanded'
        );


        root.classList.add(
          'asn--paused'
        );

      }

    }
  );



  /* ==================================
     KEYBOARD
  ================================== */

  root.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Enter' ||
        event.key === ' '
      ) {

        var item =
          event.target.closest(
            '[data-asn-item]'
          );


        if (!item) return;


        event.preventDefault();


        item.click();

      }

    }
  );



  /* ==================================
     CLICK OUTSIDE
  ================================== */

  document.addEventListener(
    'click',
    function (event) {

      if (
        !root.contains(
          event.target
        )
      ) {

        collapseAll();

      }

    }
  );



  /* ==================================
     ESCAPE
  ================================== */

  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape'
      ) {

        collapseAll();

      }

    }
  );


})();
</script>



