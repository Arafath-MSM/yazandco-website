    { "type": "range", "id": "hours_size_d", "min": 11, "max": 22, "step": 1, "unit": "px", "label": "Desktop Size", "default": 14 },
    { "type": "range", "id": "hours_size_m", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Mobile Size", "default": 13 },
    { "type": "select", "id": "hours_weight", "label": "Font Weight", "options": [ { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" } ], "default": "400" },
