{%- style -%}
  /* ==========================================================================
     1. SECTION CONTAINER & RESPONSIVE PADDINGS
     ========================================================================== */
  #pa-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.pad_top_m }}px;
    padding-bottom: {{ section.settings.pad_bottom_m }}px;
    padding-left: {{ section.settings.pad_left_m }}px;
    padding-right: {{ section.settings.pad_right_m }}px;
  }

  @media screen and (min-width: 769px) {
    #pa-section-{{ section.id }} {
      padding-top: {{ section.settings.pad_top_d }}px;
      padding-bottom: {{ section.settings.pad_bottom_d }}px;
      padding-left: {{ section.settings.pad_left_d }}px;
      padding-right: {{ section.settings.pad_right_d }}px;
    }
  }

  .pa-wrapper-{{ section.id }} {
    max-width: {{ section.settings.container_max_w }}px;
    margin: 0 auto;
    width: 100%;
  }

  /* ==========================================================================
     2. GRID LAYOUT
     ========================================================================== */
  .pa-grid-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap_m }}px;
  }

  @media screen and (min-width: 769px) {
    .pa-grid-{{ section.id }} {
      display: grid;
      grid-template-columns: {{ section.settings.img_col_width }}% 1fr;
      align-items: {{ section.settings.grid_align }};
      gap: {{ section.settings.gap_d }}px;
    }
    {% if section.settings.image_position == 'right' %}
      .pa-grid-{{ section.id }} {
        grid-template-columns: 1fr {{ section.settings.img_col_width }}%;
      }
      .pa-img-col-{{ section.id }} {
        order: 2;
      }
      .pa-accordion-col-{{ section.id }} {
        order: 1;
      }
    {% endif %}
  }

  /* ==========================================================================
     3. IMAGE STYLING
     ========================================================================== */
  .pa-img-col-{{ section.id }} {
    width: 100%;
  }

  .pa-img-wrap-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.img_radius_m }}px;
  }

  .pa-img-{{ section.id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: {{ section.settings.img_object_fit }};
    max-height: {{ section.settings.img_max_h_m }}px;
  }

  @media screen and (min-width: 769px) {
    .pa-img-wrap-{{ section.id }} {
      border-radius: {{ section.settings.img_radius_d }}px;
    }
    .pa-img-{{ section.id }} {
      max-height: {{ section.settings.img_max_h_d }}px;
    }
  }

  /* Placeholder Image */
  .pa-img-placeholder-{{ section.id }} {
    background-color: #E0E0E0;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ section.settings.img_radius_m }}px;
  }

  /* ==========================================================================
     4. ACCORDION / STEPS LIST STYLING
     ========================================================================== */
  .pa-accordion-{{ section.id }} {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .pa-item-{{ section.id }} {
    border-bottom: {{ section.settings.border_w }}px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.item_pad_v_m }}px;
    padding-bottom: {{ section.settings.item_pad_v_m }}px;
    transition: all 0.3s ease;
  }

  .pa-item-{{ section.id }}:first-child {
    border-top: {{ section.settings.border_w_top }}px solid {{ section.settings.border_color }};
  }

  @media screen and (min-width: 769px) {
    .pa-item-{{ section.id }} {
      padding-top: {{ section.settings.item_pad_v_d }}px;
      padding-bottom: {{ section.settings.item_pad_v_d }}px;
    }
  }

  /* Step Header Button */
  .pa-header-{{ section.id }} {
    display: flex;
    align-items: baseline;
    gap: {{ section.settings.num_title_gap_m }}px;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    padding: 0;
  }

  @media screen and (min-width: 769px) {
    .pa-header-{{ section.id }} {
      gap: {{ section.settings.num_title_gap_d }}px;
    }
  }

  /* Step Number Typography */
  .pa-num-{{ section.id }} {
    font-size: {{ section.settings.num_size_m }}px;
    font-weight: {{ section.settings.num_weight }};
    color: {{ section.settings.num_color_inactive }};
    line-height: 1.2;
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  /* Step Title Typography */
  .pa-title-{{ section.id }} {
    font-size: {{ section.settings.title_size_m }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color_inactive }};
    line-height: {{ section.settings.title_lh }};
    margin: 0;
    transition: color 0.3s ease;
  }

  @media screen and (min-width: 769px) {
    .pa-num-{{ section.id }} {
      font-size: {{ section.settings.num_size_d }}px;
    }
    .pa-title-{{ section.id }} {
      font-size: {{ section.settings.title_size_d }}px;
    }
  }

  /* Active State Colors */
  .pa-item-{{ section.id }}.is-active .pa-num-{{ section.id }} {
    color: {{ section.settings.num_color_active }};
  }

  .pa-item-{{ section.id }}.is-active .pa-title-{{ section.id }} {
    color: {{ section.settings.title_color_active }};
  }

  /* Step Body / Description Text */
  .pa-body-{{ section.id }} {
    display: none;
    padding-left: calc({{ section.settings.num_size_m }}px + {{ section.settings.num_title_gap_m }}px);
    margin-top: {{ section.settings.body_mt_m }}px;
  }

  .pa-item-{{ section.id }}.is-active .pa-body-{{ section.id }} {
    display: block;
  }

  .pa-body-text-{{ section.id }} {
    font-size: {{ section.settings.body_size_m }}px;
    font-weight: {{ section.settings.body_weight }};
    color: {{ section.settings.body_color }};
    line-height: {{ section.settings.body_lh }};
    margin: 0;
  }

  @media screen and (min-width: 769px) {
    .pa-body-{{ section.id }} {
      padding-left: calc({{ section.settings.num_size_d }}px + {{ section.settings.num_title_gap_d }}px);
      margin-top: {{ section.settings.body_mt_d }}px;
    }
    .pa-body-text-{{ section.id }} {
      font-size: {{ section.settings.body_size_d }}px;
    }
  }
{%- endstyle -%}

<section id="pa-section-{{ section.id }}">
  <div class="pa-wrapper-{{ section.id }}">
    <div class="pa-grid-{{ section.id }}">
      
      <!-- IMAGE COLUMN -->
      <div class="pa-img-col-{{ section.id }}">
        {%- if section.settings.image != blank -%}
          <div class="pa-img-wrap-{{ section.id }}">
            <img 
              src="{{ section.settings.image | image_url: width: 1200 }}" 
              alt="{{ section.settings.image.alt | escape }}" 
              class="pa-img-{{ section.id }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}">
          </div>
        {%- else -%}
          <div class="pa-img-placeholder-{{ section.id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <!-- ACCORDION STEPS COLUMN -->
      <div class="pa-accordion-col-{{ section.id }}">
        <div class="pa-accordion-{{ section.id }}" id="accordion-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div 
              class="pa-item-{{ section.id }} {% if forloop.first and section.settings.open_first %}is-active{% endif %}" 
              {{ block.shopify_attributes }}>
              
              <button 
                type="button" 
                class="pa-header-{{ section.id }}" 
                aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}">
                {%- if block.settings.step_num != blank -%}
                  <span class="pa-num-{{ section.id }}">{{ block.settings.step_num }}</span>
                {%- endif -%}
                {%- if block.settings.step_title != blank -%}
                  <h3 class="pa-title-{{ section.id }}">{{ block.settings.step_title }}</h3>
                {%- endif -%}
              </button>

              {%- if block.settings.step_body != blank -%}
                <div class="pa-body-{{ section.id }}">
                  <p class="pa-body-text-{{ section.id }}">{{ block.settings.step_body }}</p>
                </div>
              {%- endif -%}

            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const accordionContainer = document.getElementById('accordion-{{ section.id }}');
    if (!accordionContainer) return;

    const items = accordionContainer.querySelectorAll('.pa-item-{{ section.id }}');

    items.forEach(item => {
      const header = item.querySelector('.pa-header-{{ section.id }}');
      header.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');

        {% if section.settings.close_others %}
          items.forEach(i => {
            i.classList.remove('is-active');
            const btn = i.querySelector('.pa-header-{{ section.id }}');
            if (btn) btn.setAttribute('aria-expanded', 'false');
          });
        {% endif %}

        if (!isActive) {
          item.classList.add('is-active');
          header.setAttribute('aria-expanded', 'true');
        } else {
          item.classList.remove('is-active');
          header.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
</script>

